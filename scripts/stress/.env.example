# =====================
# moment_api (端口 20900 / 库 beaver_moment)
# =====================
MOMENT_API_BASE=http://127.0.0.1:20900
MOMENT_REDIS_ADDR=127.0.0.1:6379
MOMENT_REDIS_PASSWORD=
MOMENT_REDIS_DB=0
