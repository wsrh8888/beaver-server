# ====== 压测本地配置 ======
# 复制本文件为 .env，填入真实值。.env 已 gitignore，不会进 git，密码不外传。
# 每个服务的 DB 和 Redis 独立配置，与 deploy/*/xxx.yaml 保持一致。
# 如果压测在本机跑，IP 用 127.0.0.1；如果在别的机器跑，换成服务器公网 IP。

# =====================
# auth_api (端口 20100 / 库 beaver_auth)
# =====================
AUTH_API_BASE=http://127.0.0.1:20100
AUTH_REDIS_ADDR=127.0.0.1:6379
AUTH_REDIS_PASSWORD=
AUTH_REDIS_DB=0

# =====================
# user_api (端口 20000 / 库 beaver_user)
# =====================
USER_API_BASE=http://127.0.0.1:20000
USER_REDIS_ADDR=127.0.0.1:6379
USER_REDIS_PASSWORD=
USER_REDIS_DB=0

# =====================
# friend_api (端口 20200 / 库 beaver_friend)
# =====================
FRIEND_API_BASE=http://127.0.0.1:20200
FRIEND_REDIS_ADDR=127.0.0.1:6379
FRIEND_REDIS_PASSWORD=
FRIEND_REDIS_DB=0

# =====================
# chat_api (端口 20300 / 库 beaver_chat)
# =====================
CHAT_API_BASE=http://127.0.0.1:20300
CHAT_REDIS_ADDR=127.0.0.1:6379
CHAT_REDIS_PASSWORD=
CHAT_REDIS_DB=0

