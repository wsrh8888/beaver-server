syntax = "v1"

// ==================== 认证公开接口（无需 JWT，公开访问）====================

type (
	PhoneLoginReq {
		Phone    string `json:"phone"`
		Password string `json:"password"`
		DeviceID string `header:"deviceId"`
		ClientIP string `header:"clientIp,optional"`
	}
	PhoneLoginRes {
		Token  string `json:"token"`
		UserID string `json:"userId"`
	}
)

type (
	EmailPasswordLoginReq {
		Email    string `json:"email"`
		Password string `json:"password"`
		DeviceID string `header:"deviceId"`
		ClientIP string `header:"clientIp,optional"`
	}
	EmailPasswordLoginRes {
		Token  string `json:"token"`
		UserID string `json:"userId"`
	}
)

type (
	OAuthCodeLoginReq {
		OauthId    string `json:"oauthId"`
		Code     string `json:"code"`
		DeviceID string `header:"deviceId"`
		ClientIP string `header:"clientIp,optional"`
	}
	OAuthCodeLoginRes {
		Token  string `json:"token"`
		UserID string `json:"userId"`
	}
)

type (
	AuthenticationReq {
		Token     string `header:"Token,optional"`
		ValidPath string `header:"ValidPath,optional"`
	}
	AuthenticationRes {
		UserID string `json:"userId"`
	}
)

type (
	PhoneRegisterReq {
		Phone    string `json:"phone"`
		Password string `json:"password"`
		Code     string `json:"code"`
	}
	PhoneRegisterRes {}
)

type (
	EmailRegisterReq {
		Email    string `json:"email"`
		Password string `json:"password"`
		Code     string `json:"code"`
	}
	EmailRegisterRes {}
)

type (
	GetPhoneCodeReq {
		Phone string `json:"phone"`
		Type  string `json:"type"`
	}
	GetPhoneCodeRes {}
)

type (
	GetEmailCodeReq {
		Email string `json:"email"`
		Type  string `json:"type"`
	}
	GetEmailCodeRes {}
)

type (
	EmailLoginReq {
		Email    string `json:"email"`
		Code     string `json:"code"`
		DeviceID string `header:"deviceId"`
		ClientIP string `header:"clientIp,optional"`
	}
	EmailLoginRes {
		Token  string `json:"token"`
		UserID string `json:"userId"`
	}
)

type (
	ResetPasswordReq {
		Email    string `json:"email"`
		Code     string `json:"code"`
		Password string `json:"password"`
	}
	ResetPasswordRes {}
)

type (
	QrcodeGenerateReq {
		DeviceID string `header:"deviceId"`
		ClientIP string `header:"clientIp,optional"`
		Source   string `json:"source,optional"`
	}
	QrcodeGenerateRes {
		Token    string `json:"token"`
		ExpireAt int64  `json:"expireAt"`
	}
)

type (
	QrcodeStatusReq {
		Token    string `form:"token"`
		DeviceID string `header:"deviceId"`
		ClientIP string `header:"clientIp,optional"`
	}
	QrcodeStatusRes {
		Status string `json:"status"`
		Token  string `json:"token,omitempty"`
		UserID string `json:"userId,omitempty"`
		Source string `json:"source,omitempty"`
	}
)

// ==================== 队间换票（client_credentials → core:api 机器票）====================
// 与其余公开端点同属「无网关身份鉴权」：不走身份闸门，靠 client_secret 常量时间比对。
// 一个团队一套票：本团队全部业务面（account/message/relation/asset/notification/platform）
// 共用同一受众，收费仓换一次票即可打所有面，省掉每服务各换一次的往返。
type (
	S2STokenReq {
		GrantType    string `json:"grant_type,optional"`
		ClientID     string `json:"client_id"`
		ClientSecret string `json:"client_secret"`
	}
	S2STokenRes {
		AccessToken string `json:"access_token"`
		TokenType   string `json:"token_type"`
		ExpiresIn   int64  `json:"expires_in"`
	}
)

@server (
	group: auth_public
)
service account {
	@doc "手机号登录"
	@handler phoneLogin
	post /beaver/api/account/auth_public/v1/phone_login (PhoneLoginReq) returns (PhoneLoginRes)

	@doc "邮箱密码登录"
	@handler emailPasswordLogin
	post /beaver/api/account/auth_public/v1/email_password_login (EmailPasswordLoginReq) returns (EmailPasswordLoginRes)

	@doc "OAuth 授权码登录（PC 客户端 SDK）"
	@handler oauthCodeLogin
	post /beaver/api/account/auth_public/v1/oauth_code_login (OAuthCodeLoginReq) returns (OAuthCodeLoginRes)

	@doc "用户认证（服务内校验 Token）"
	@handler authentication
	get /beaver/api/account/auth_public/v1/authentication (AuthenticationReq) returns (AuthenticationRes)

	@doc "手机号注册"
	@handler phoneRegister
	post /beaver/api/account/auth_public/v1/phone_register (PhoneRegisterReq) returns (PhoneRegisterRes)

	@doc "邮箱注册"
	@handler emailRegister
	post /beaver/api/account/auth_public/v1/email_register (EmailRegisterReq) returns (EmailRegisterRes)

	@doc "获取手机验证码"
	@handler getPhoneCode
	post /beaver/api/account/auth_public/v1/phonecode (GetPhoneCodeReq) returns (GetPhoneCodeRes)

	@doc "获取邮箱验证码"
	@handler getEmailCode
	post /beaver/api/account/auth_public/v1/emailcode (GetEmailCodeReq) returns (GetEmailCodeRes)

	@doc "邮箱验证码登录"
	@handler emailLogin
	post /beaver/api/account/auth_public/v1/email_login (EmailLoginReq) returns (EmailLoginRes)

	@doc "找回密码"
	@handler resetPassword
	post /beaver/api/account/auth_public/v1/reset_password (ResetPasswordReq) returns (ResetPasswordRes)

	@doc "扫码登录-生成二维码（PC）"
	@handler qrcodeGenerate
	post /beaver/api/account/auth_public/v1/qrcode_generate (QrcodeGenerateReq) returns (QrcodeGenerateRes)

	@doc "扫码登录-轮询状态（PC）"
	@handler qrcodeStatus
	get /beaver/api/account/auth_public/v1/qrcode_status (QrcodeStatusReq) returns (QrcodeStatusRes)

	@doc "S2S 机器票换发（client_credentials，靠 client_secret 自身鉴权，不走身份闸门）"
	@handler s2sToken
	post /beaver/api/account/auth_token/v1/issue (S2STokenReq) returns (S2STokenRes)
}
