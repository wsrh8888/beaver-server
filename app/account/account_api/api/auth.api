syntax = "v1"

// ==================== 认证接口（需 Gateway JWT，注入 Beaver-User-Id 或 Header Token）====================
type (
	LogoutReq {
		DeviceID string `header:"deviceId"`
	}
	LogoutRes  {}
)

type (
	QrcodeScanReq {
		Token     string `json:"token"`
		AuthToken string `header:"Token"`
	}
	QrcodeScanRes  {}
)

type (
	GetDevicesReq {
	}
	GetDevicesRes {
		Devices []DeviceInfo `json:"devices"`
	}
	DeviceInfo {
		DeviceID        string `json:"deviceId"`
		DeviceType      string `json:"deviceType"`
		DeviceOS        string `json:"deviceOs"`
		DeviceModel     string `json:"deviceModel"`
		DeviceOsVersion string `json:"deviceOsVersion"`
		DeviceName      string `json:"deviceName"`
		LastLoginTime   string `json:"lastLoginTime"`
		IsOnline        bool   `json:"isOnline"`
		LastLoginIP     string `json:"lastLoginIp"`
	}
)

type (
	KickDeviceReq {
		DeviceID string `json:"deviceId"`
	}
	KickDeviceRes  {}
)

type (
	UpdatePasswordReq {
		OldPassword string `json:"oldPassword"`
		NewPassword string `json:"newPassword"`
	}
	UpdatePasswordRes  {}
)

@server (
	group: auth
	jwt: Auth
)
service account {
	@doc "用户登出"
	@handler logout
	post /api/auth/auth/v1/logout (LogoutReq) returns (LogoutRes)

	@doc "扫码登录-确认扫码（移动端，Header Token）"
	@handler qrcodeScan
	post /api/auth/auth/v1/qrcode/scan (QrcodeScanReq) returns (QrcodeScanRes)

	@doc "获取登录设备列表"
	@handler getDevices
	get /api/auth/auth/v1/devices (GetDevicesReq) returns (GetDevicesRes)

	@doc "强制下线指定设备"
	@handler kickDevice
	post /api/auth/auth/v1/kick_device (KickDeviceReq) returns (KickDeviceRes)

	@doc "修改密码（需验证旧密码）"
	@handler updatePassword
	post /api/auth/auth/v1/update_password (UpdatePasswordReq) returns (UpdatePasswordRes)
}

// goctl api go -api auth_api.api -dir . --home ../../../template

// ==================== 队间换票面（client_credentials → 受众 core:api 的机器票）====================
type (
	S2STokenReq {
		GrantType    string `json:"grant_type,optional"`
		ClientID     string `json:"client_id"`
		ClientSecret string `json:"client_secret"`
	}
	S2STokenRes {
		AccessToken string `json:"access_token"`
		TokenType   string `json:"token_type"`
		ExpiresIn   int64  `json:"expires_in"`
	}
)

// 一个团队一套票：本团队全部业务面（account/message/relation/asset/notification/platform）
// 共用同一受众，收费仓换一次票即可打所有面，省掉每服务各换一次的往返。
// 该路由本身不走身份闸门（否则换不到票），靠 client_secret 常量时间比对鉴权。
@server (
	group: auth_token
)
service account {
	@doc "S2S 机器票换发（client_credentials）"
	@handler s2sToken
	post /api/auth/token (S2STokenReq) returns (S2STokenRes)
}

// ==================== 队间机器视图：认证域凭据与设备维护 ====================
// 与 C 端共用 /api/auth 契约文件；入出参 JSON 与旧 S2S 门面逐字对齐。
type (
	VerifyPasswordReq {
		UserId   string `json:"user_id,optional"`
		Password string `json:"password,optional"`
	}
	VerifyPasswordRes {
		Valid bool `json:"valid,optional"`
	}
)

type (
	CreateCredentialReq {
		UserId   string `json:"user_id,optional"`
		Password string `json:"password,optional"`
	}
	CreateCredentialRes {
		Success bool `json:"success,optional"`
	}
)

type (
	ListUserDevicesReq {
		UserId string `json:"user_id,optional"`
	}
	ListUserDevicesRes {
		List []UserDeviceItem `json:"list,optional"`
	}
)

type (
	ResetUserPasswordReq {
		UserId      string `json:"user_id,optional"`
		NewPassword string `json:"new_password,optional"`
	}
	ResetUserPasswordRes {
		Success bool `json:"success,optional"`
	}
)

@server (
	group: auth_machine
	middleware: AuthGate
)
service account {
	@doc "校验账号密码（开放平台 / 管理端代登录）"
	@handler verifyPassword
	post /api/auth/v1/verify_password (VerifyPasswordReq) returns (VerifyPasswordRes)

	@doc "创建账号密码凭据"
	@handler createCredential
	post /api/auth/v1/create_credential (CreateCredentialReq) returns (CreateCredentialRes)

	@doc "查指定用户的登录设备"
	@handler listUserDevices
	post /api/auth/v1/devices (ListUserDevicesReq) returns (ListUserDevicesRes)

	@doc "重置指定用户密码（无需旧密码）"
	@handler resetUserPassword
	post /api/auth/v1/reset_password (ResetUserPasswordReq) returns (ResetUserPasswordRes)
}
