syntax = "v1"

// ==================== 认证接口：网关 JwtS2s（C端用户票注入可信身份头）====================
type (
	LogoutReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		DeviceID string `header:"deviceId"`
	}
	LogoutRes  {}
)

type (
	QrcodeScanReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Token     string `json:"token"`
		AuthToken string `header:"Token"`
	}
	QrcodeScanRes  {}
)

type (
	GetDevicesReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
	}
	GetDevicesRes {
		Devices []DeviceInfo `json:"devices"`
	}
	DeviceInfo {
		DeviceID        string `json:"deviceId"`
		DeviceType      string `json:"deviceType"`
		DeviceOS        string `json:"deviceOs"`
		DeviceModel     string `json:"deviceModel"`
		DeviceOSVersion string `json:"deviceOsVersion"`
		DeviceName      string `json:"deviceName"`
		LastLoginTime   string `json:"lastLoginTime"`
		IsOnline        bool   `json:"isOnline"`
		LastLoginIP     string `json:"lastLoginIp"`
	}
)

type (
	KickDeviceReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		DeviceID string `json:"deviceId"`
	}
	KickDeviceRes  {}
)

type (
	UpdatePasswordReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		OldPassword string `json:"oldPassword"`
		NewPassword string `json:"newPassword"`
	}
	UpdatePasswordRes  {}
)

@server (
	group: auth
	middleware: JwtS2s
)
service account {
	@doc "用户登出"
	@handler logout
	post /beaver/api/account/auth/v1/logout (LogoutReq) returns (LogoutRes)

	@doc "扫码登录-确认扫码（移动端，Header Token）"
	@handler qrcodeScan
	post /beaver/api/account/auth/v1/qrcode_scan (QrcodeScanReq) returns (QrcodeScanRes)

	@doc "获取登录设备列表"
	@handler getDevices
	get /beaver/api/account/auth/v1/devices (GetDevicesReq) returns (GetDevicesRes)

	@doc "强制下线指定设备"
	@handler kickDevice
	post /beaver/api/account/auth/v1/kick_device (KickDeviceReq) returns (KickDeviceRes)

	@doc "修改密码（需验证旧密码）"
	@handler updatePassword
	post /beaver/api/account/auth/v1/update_password (UpdatePasswordReq) returns (UpdatePasswordRes)
}
