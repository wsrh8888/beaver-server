syntax = "v1"

// 用户信息
type (
	UserInfoReq {
		UserID string `header:"Beaver-User-Id"` // 用户ID，从请求头获取
	}
	UserInfoRes {
		UserID   string `json:"userId"` // 用户唯一标识
		NickName string `json:"nickName"` // 用户昵称
		Avatar   string `json:"avatar"` // 用户头像URL
		Abstract string `json:"abstract"` // 用户个性签名
		Phone    string `json:"phone,optional"` // 用户手机号
		Email    string `json:"email,optional"` // 用户邮箱（可选）
		Gender   int8   `json:"gender"` // 用户性别：1-男 2-女 0-未知
		Version  int64  `json:"version"` // 用户数据版本号
	}
)

// 更新用户信息
type (
	UpdateInfoReq {
		UserID   string  `header:"Beaver-User-Id"` // 用户ID，从请求头获取
		NickName *string `json:"nickName,optional"` // 新昵称（可选）
		Avatar   *string `json:"avatar,optional"` // 新头像URL（可选）
		Abstract *string `json:"abstract,optional"` // 新个性签名（可选）
		Gender   *int8   `json:"gender,optional"` // 性别：1-男 2-女 0-未知（可选）
	}
	UpdateInfoRes  {}
)

// 修改邮箱
type (
	UpdateEmailReq {
		UserID string `header:"Beaver-User-Id"` // 用户ID，从请求头获取
		Email  string `json:"email"` // 新邮箱地址
		Code   string `json:"code"` // 验证码
	}
	UpdateEmailRes  {}
)

// 用户数据同步（大厂用户独立版本号方式）
type (
	UserVersion {
		UserID  string `json:"userId"` // 用户ID
		Version int64  `json:"version"` // 该用户的最后同步版本号
	}
	UserSyncReq {
		UserID       string        `header:"Beaver-User-Id"`
		UserVersions []UserVersion `json:"userVersions"` // 用户版本号数组
	}
	UserSyncRes {
		Users []UserSyncItem `json:"users"` // 用户列表
	}
	UserSyncItem {
		UserID    string `json:"userId"` // 用户ID
		NickName  string `json:"nickName"` // 用户昵称
		Avatar    string `json:"avatar"` // 用户头像
		Abstract  string `json:"abstract"` // 个性签名
		Phone     string `json:"phone"` // 手机号
		Email     string `json:"email"` // 邮箱
		Gender    int8   `json:"gender"` // 性别
		Status    int8   `json:"status"` // 状态
		UserType  int8   `json:"userType"` // 1普通用户 2bot 3digital
		Version   int64  `json:"version"` // 版本号
		CreatedAt int64  `json:"createdAt"` // 创建时间戳
		UpdatedAt int64  `json:"updatedAt"` // 更新时间戳
	}
)

// 获取用户设置
type (
	GetUserSettingsReq {
		UserID string `header:"Beaver-User-Id"` // 用户ID，从请求头获取
	}
	GetUserSettingsPrivacyItem {
		AllowFriendRequest bool `json:"allowFriendRequest"` // 是否允许添加好友
		ShowOnlineStatus   bool `json:"showOnlineStatus"` // 是否展示在线状态
		AllowSearchByPhone bool `json:"allowSearchByPhone"` // 是否允许通过手机号搜索
		AllowSearchByEmail bool `json:"allowSearchByEmail"` // 是否允许通过邮箱搜索
	}
	GetUserSettingsNotificationItem {
		NotifyFriendRequest bool `json:"notifyFriendRequest"` // 是否接收好友申请通知
		NotifyGroupMessage  bool `json:"notifyGroupMessage"` // 是否接收群消息通知
		NotifyMoment        bool `json:"notifyMoment"` // 是否接收朋友圈通知
	}
	GetUserSettingsKeyboardItem {
		Screenshot   string `json:"screenshot"` // 区域截图
		ToggleWindow string `json:"toggleWindow"` // 显示/隐藏主窗口
		SendMessage  string `json:"sendMessage"` // 发送消息
	}
	GetUserSettingsRes {
		Privacy      GetUserSettingsPrivacyItem      `json:"privacy"` // 隐私设置
		Notification GetUserSettingsNotificationItem `json:"notification"` // 通知策略
		Keyboard     GetUserSettingsKeyboardItem     `json:"keyboard"` // 快捷键
	}
)

// 更新用户设置
type (
	UpdateUserSettingsPrivacyItem {
		AllowFriendRequest *bool `json:"allowFriendRequest,optional"` // 是否允许添加好友
		ShowOnlineStatus   *bool `json:"showOnlineStatus,optional"` // 是否展示在线状态
		AllowSearchByPhone *bool `json:"allowSearchByPhone,optional"` // 是否允许通过手机号搜索
		AllowSearchByEmail *bool `json:"allowSearchByEmail,optional"` // 是否允许通过邮箱搜索
	}
	UpdateUserSettingsNotificationItem {
		NotifyFriendRequest *bool `json:"notifyFriendRequest,optional"` // 是否接收好友申请通知
		NotifyGroupMessage  *bool `json:"notifyGroupMessage,optional"` // 是否接收群消息通知
		NotifyMoment        *bool `json:"notifyMoment,optional"` // 是否接收朋友圈通知
	}
	UpdateUserSettingsKeyboardItem {
		Screenshot   *string `json:"screenshot,optional"` // 区域截图
		ToggleWindow *string `json:"toggleWindow,optional"` // 显示/隐藏主窗口
		SendMessage  *string `json:"sendMessage,optional"` // 发送消息
	}
	UpdateUserSettingsReq {
		UserID       string                              `header:"Beaver-User-Id"` // 用户ID，从请求头获取
		Privacy      *UpdateUserSettingsPrivacyItem      `json:"privacy,optional"` // 隐私设置（可选，局部更新）
		Notification *UpdateUserSettingsNotificationItem `json:"notification,optional"` // 通知策略（可选，局部更新）
		Keyboard     *UpdateUserSettingsKeyboardItem     `json:"keyboard,optional"` // 快捷键（可选，局部更新）
	}
	UpdateUserSettingsRes  {}
)

// 用户服务
@server (
	group: user
)
service account {
	@doc "获取用户基础信息"
	@handler userInfo
	get /api/user/v1/user_info (UserInfoReq) returns (UserInfoRes)

	@doc "更新用户基础信息（昵称、头像、个性签名、性别）"
	@handler updateInfo
	post /api/user/v1/update_info (UpdateInfoReq) returns (UpdateInfoRes)

	@doc "修改用户邮箱（需要验证码）"
	@handler updateEmail
	post /api/user/v1/update_email (UpdateEmailReq) returns (UpdateEmailRes)

	@doc "用户数据增量同步（基于用户独立版本号，大厂标准方式）"
	@handler userSync
	post /api/user/v1/sync (UserSyncReq) returns (UserSyncRes)

	@doc "获取用户设置（隐私、通知策略、快捷键）"
	@handler getUserSettings
	get /api/user/v1/settings (GetUserSettingsReq) returns (GetUserSettingsRes)

	@doc "更新用户设置（隐私、通知策略、快捷键，支持局部更新）"
	@handler updateUserSettings
	post /api/user/v1/update_settings (UpdateUserSettingsReq) returns (UpdateUserSettingsRes)
}

// goctl api go -api account_api.api -dir . --home ../../../template

// ==================== 队间机器视图：用户域批量与维护能力 ====================
// 与 C 端共用 /api/user 契约文件；入出参 JSON 与旧 S2S 门面逐字对齐，调用方零改动。
// 与 C 端视图的差别是「资源视图」不同（这里含 status/source/user_type 等管理字段），
// 不是第二套契约——都在本 .api 里。
type (
	UserLookupInfo {
		UserId    string `json:"user_id,optional"`
		NickName  string `json:"nick_name,optional"`
		Avatar    string `json:"avatar,optional"`
		Version   int64  `json:"version,optional"`
		Email     string `json:"email,optional"`
		Abstract  string `json:"abstract,optional"`
		Phone     string `json:"phone,optional"`
		Status    int32  `json:"status,optional"`
		Source    int32  `json:"source,optional"`
		UserType  int32  `json:"user_type,optional"`
		CreatedAt string `json:"created_at,optional"`
		UpdatedAt string `json:"updated_at,optional"`
	}
	UserDeviceItem {
		DeviceId        string `json:"device_id,optional"`
		DeviceType      string `json:"device_type,optional"`
		DeviceOs        string `json:"device_os,optional"`
		DeviceModel     string `json:"device_model,optional"`
		DeviceOsVersion string `json:"device_os_version,optional"`
		DeviceName      string `json:"device_name,optional"`
		LastLoginTime   string `json:"last_login_time,optional"`
		LastLoginIp     string `json:"last_login_ip,optional"`
		IsOnline        bool   `json:"is_online,optional"`
	}
)

// 单个用户信息（按 user_id 查，含管理字段）
type (
	UserLookupReq {
		UserID string `json:"userID,optional"`
	}
	UserLookupRes {
		UserInfo UserLookupInfo `json:"user_info"`
	}
)

// 批量用户信息
type (
	UserListInfoReq {
		UserIdList     []string `json:"user_id_list,optional"`
		SinceTimestamp int64    `json:"since_timestamp,optional"`
	}
	UserListInfoRes {
		UserInfo map[string]UserLookupInfo `json:"user_info,optional"`
	}
)

// 创建用户
type (
	UserCreateReq {
		Phone    string `json:"phone,optional"`
		Source   int32  `json:"source,optional"`
		Email    string `json:"email,optional"`
		NickName string `json:"nick_name,optional"`
		UserType int32  `json:"user_type,optional"`
		Abstract string `json:"abstract,optional"`
	}
	UserCreateRes {
		UserID string `json:"userID,optional"`
	}
)

// 搜索用户
type (
	UserSearchReq {
		Keyword string `json:"keyword,optional"`
		Type    string `json:"type,optional"`
	}
	UserSearchRes {
		UserInfo UserLookupInfo `json:"user_info"`
	}
)

// 更新展示信息
type (
	UserUpdateDisplayReq {
		UserId   string `json:"user_id,optional"`
		NickName string `json:"nick_name,optional"`
		Avatar   string `json:"avatar,optional"`
	}
	UserUpdateDisplayRes {
		Version int64 `json:"version,optional"`
	}
)

// 管理端分页列表
type (
	UserListReq {
		Page     int32  `json:"page,optional"`
		PageSize int32  `json:"page_size,optional"`
		Email    string `json:"email,optional"`
		Status   int32  `json:"status,optional"`
		Source   int32  `json:"source,optional"`
		UserId   string `json:"user_id,optional"`
		Keyword  string `json:"keyword,optional"`
		UserType int32  `json:"user_type,optional"`
	}
	UserListRes {
		Total int64            `json:"total,optional"`
		List  []UserLookupInfo `json:"list,optional"`
	}
)

// 批量更新
type (
	UserUpdateReq {
		UserIds       []string `json:"user_ids,optional"`
		PatchNickName *string  `json:"patch_nick_name,optional"`
		PatchEmail    *string  `json:"patch_email,optional"`
		PatchAvatar   *string  `json:"patch_avatar,optional"`
		PatchAbstract *string  `json:"patch_abstract,optional"`
	}
	UserUpdateRes {
		AffectedCount int64 `json:"affected_count,optional"`
	}
)

// 批量删除
type (
	UserDeleteReq {
		UserIds []string `json:"user_ids,optional"`
	}
	UserDeleteRes {
		AffectedCount int64 `json:"affected_count,optional"`
	}
)

// 批量改状态
type (
	UserUpdateStatusReq {
		UserIds []string `json:"user_ids,optional"`
		Status  int32    `json:"status,optional"`
	}
	UserUpdateStatusRes {
		AffectedCount int64 `json:"affected_count,optional"`
	}
)

@server (
	group: user_machine
)
service account {
	@doc "按 user_id 查用户信息（含管理字段）"
	@handler userLookup
	post /api/user/v1/info (UserLookupReq) returns (UserLookupRes)

	@doc "批量查用户信息"
	@handler userListInfo
	post /api/user/v1/list_info (UserListInfoReq) returns (UserListInfoRes)

	@doc "创建用户"
	@handler userCreate
	post /api/user/v1/create (UserCreateReq) returns (UserCreateRes)

	@doc "搜索用户"
	@handler userSearch
	post /api/user/v1/search (UserSearchReq) returns (UserSearchRes)

	@doc "更新用户展示信息（昵称、头像）"
	@handler userUpdateDisplay
	post /api/user/v1/update_display (UserUpdateDisplayReq) returns (UserUpdateDisplayRes)

	@doc "管理端用户分页列表"
	@handler userList
	post /api/user/v1/list (UserListReq) returns (UserListRes)

	@doc "批量更新用户资料"
	@handler userUpdate
	post /api/user/v1/update (UserUpdateReq) returns (UserUpdateRes)

	@doc "批量删除用户"
	@handler userDelete
	post /api/user/v1/delete (UserDeleteReq) returns (UserDeleteRes)

	@doc "批量修改用户状态"
	@handler userUpdateStatus
	post /api/user/v1/update_status (UserUpdateStatusReq) returns (UserUpdateStatusRes)
}
