syntax = "v1"

// ==================== 组织（客户端，需登录）====================
// 只提供查询。部门、成员的新增、修改、删除在 platform_rpc，由后台调整。

type (
	GetOrganizationReq {
		UserID string `header:"Beaver-User-Id"` // string 当前用户 ID
	}
	GetOrganizationRes {
		OrgID string `json:"orgId"` // string 组织 ID
		Name  string `json:"name"` // string 组织名
	}
	DepartmentTreeReq {
		UserID string `header:"Beaver-User-Id"` // string 当前用户 ID
	}
	DepartmentNode {
		DeptID      string           `json:"deptId"` // string 部门 ID
		ParentID    string           `json:"parentId"` // string 父部门 ID，空字符串表示根
		Name        string           `json:"name"` // string 部门名
		Sort        int              `json:"sort"` // int 同级排序
		MemberCount int              `json:"memberCount"` // int 直属成员人数，不含子部门
		Children    []DepartmentNode `json:"children"` // array 子部门
	}
	DepartmentTreeRes {
		List []DepartmentNode `json:"list"` // array 部门树，根在最外层
	}
	ListMemberReq {
		UserID string `header:"Beaver-User-Id"` // string 当前用户 ID
		DeptID string `form:"deptId,optional"` // string 按部门过滤，不传则全部
	}
	MemberItem {
		UserID   string `json:"userId"` // string 用户 ID
		NickName string `json:"nickName"` // string 昵称
		Avatar   string `json:"avatar"` // string 头像
		DeptID   string `json:"deptId"` // string 所属部门
		Role     int    `json:"role"` // int 1拥有者 2管理员 3成员
	}
	ListMemberRes {
		List []MemberItem `json:"list"` // array 成员
	}
)

@server (
	group: org
)
service platform {
	@doc "查询当前组织"
	@handler GetOrganization
	get /api/org/v1/organization (GetOrganizationReq) returns (GetOrganizationRes)

	@doc "部门树，节点带直属成员人数"
	@handler DepartmentTree
	get /api/org/v1/department/tree (DepartmentTreeReq) returns (DepartmentTreeRes)

	@doc "成员列表，可按部门过滤"
	@handler ListMember
	get /api/org/v1/member/list (ListMemberReq) returns (ListMemberRes)
}
