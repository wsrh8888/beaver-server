// 平台后台管理 API（队间能力面）
//
// 后台管理仓（beaver-backend）直接调用本组标准机器视图，身份由 JwtS2s 中间件按机器票判定。
//
// 与 C 端的 /beaver/api/platform/* 视图不重叠：这里是运维/运营视角，可以按记录维度读写。

type (
AdminLogItem {
		ID         uint64 `json:"id,optional"` // 日志记录ID
		Level      string `json:"level,optional"` // 日志级别
		Data       string `json:"data,optional"` // 日志数据JSON
		BucketID   string `json:"bucketId,optional"` // Bucket ID
		BucketName string `json:"bucketName,optional"` // Bucket名称
		Timestamp  int64  `json:"timestamp,optional"` // 时间戳（毫秒）
		CreatedAt  string `json:"createdAt,optional"` // 创建时间
	}

AdminQueryLogsReq {
		BucketID   string `json:"bucketId,optional"` // Bucket ID
		Level      string `json:"level,optional"` // 日志级别
		StartTime  int64  `json:"startTime,optional"` // 开始时间（毫秒）
		EndTime    int64  `json:"endTime,optional"` // 结束时间（毫秒）
		Keyword    string `json:"keyword,optional"` // 关键词
		UserFilter string `json:"userFilter,optional"` // 用户筛选
		Page       int32  `json:"page,optional"` // 页码
		PageSize   int32  `json:"pageSize,optional"` // 每页条数
	}

AdminQueryLogsRes {
		Total int64          `json:"total,optional"` // 总数
		Logs  []AdminLogItem `json:"logs,optional"` // 日志列表
	}
)

type (
CreateAppReq {
		Name        string `json:"name,optional"` // 应用名称
		Description string `json:"description,optional"` // 描述
	}

CreateAppRes {
		ID    uint64 `json:"id,optional"` // 记录ID
		AppID string `json:"appId,optional"` // 应用ID
	}
)

type (
AppItem {
		ID          uint64 `json:"id,optional"` // 记录ID
		AppID       string `json:"appId,optional"` // 应用ID
		Name        string `json:"name,optional"` // 应用名称
		Description string `json:"description,optional"` // 描述
		IsActive    bool   `json:"isActive,optional"` // 是否启用
		CreatedAt   string `json:"createdAt,optional"` // 创建时间
		UpdatedAt   string `json:"updatedAt,optional"` // 更新时间
	}

ListAppsReq {
		Page     int32 `json:"page,optional"` // 页码
		PageSize int32 `json:"pageSize,optional"` // 每页条数
		IsActive *bool `json:"isActive,optional"` // 启用状态筛选
	}

ListAppsRes {
		Total int64     `json:"total,optional"` // 总数
		Apps  []AppItem `json:"apps,optional"` // 应用列表
	}
)

type (
CreateArchitectureReq {
		AppID       string `json:"appId,optional"` // 应用ID
		PlatformID  uint32 `json:"platformId,optional"` // 平台ID
		ArchID      uint32 `json:"archId,optional"` // 架构类型
		Description string `json:"description,optional"` // 架构描述
	}

CreateArchitectureRes {
		ID uint64 `json:"id,optional"` // 记录ID
	}
)

type (
UpdateArchitectureReq {
		ID          uint64 `json:"id,optional"` // 记录ID
		Description string `json:"description,optional"` // 架构描述
		IsActive    bool   `json:"isActive,optional"` // 是否启用
	}

UpdateArchitectureRes {}
)

type (
ArchitectureItem {
		ID          uint64 `json:"id,optional"` // 记录ID
		AppID       string `json:"appId,optional"` // 应用ID
		AppName     string `json:"appName,optional"` // 应用名称
		PlatformID  uint32 `json:"platformId,optional"` // 平台ID
		ArchID      uint32 `json:"archId,optional"` // 架构类型
		Description string `json:"description,optional"` // 架构描述
		IsActive    bool   `json:"isActive,optional"` // 是否启用
		CreatedAt   string `json:"createdAt,optional"` // 创建时间
		UpdatedAt   string `json:"updatedAt,optional"` // 更新时间
	}

ListArchitecturesReq {
		AppID    string `json:"appId,optional"` // 应用ID
		Page     int32  `json:"page,optional"` // 页码
		PageSize int32  `json:"pageSize,optional"` // 每页条数
		IsActive *bool  `json:"isActive,optional"` // 启用状态筛选
	}

ListArchitecturesRes {
		Total         int64              `json:"total,optional"` // 总数
		Architectures []ArchitectureItem `json:"architectures,optional"` // 架构列表
	}
)

type (
CreateVersionReq {
		ArchitectureID uint64 `json:"architectureId,optional"` // 架构ID
		Version        string `json:"version,optional"` // 版本号
		FileUrl        string `json:"fileUrl,optional"` // 安装包地址
		Description    string `json:"description,optional"` // 描述
		ReleaseNotes   string `json:"releaseNotes,optional"` // 发布说明
	}

CreateVersionRes {
		VersionID uint64 `json:"versionId,optional"` // 版本ID
	}
)

type (
DeleteVersionReq {
		VersionID uint64 `json:"versionId,optional"` // 版本ID
	}

DeleteVersionRes {}
)

type (
VersionItem {
		VersionID      uint64 `json:"versionId,optional"` // 版本ID
		ArchitectureID uint64 `json:"architectureId,optional"` // 架构ID
		Version        string `json:"version,optional"` // 版本号
		FileUrl        string `json:"fileUrl,optional"` // 安装包地址
		Description    string `json:"description,optional"` // 描述
		ReleaseNotes   string `json:"releaseNotes,optional"` // 发布说明
		CreatedAt      string `json:"createdAt,optional"` // 创建时间
		UpdatedAt      string `json:"updatedAt,optional"` // 更新时间
	}

ListVersionsReq {
		ArchitectureID uint64 `json:"architectureId,optional"` // 架构ID
		Page           int32  `json:"page,optional"` // 页码
		PageSize       int32  `json:"pageSize,optional"` // 每页条数
	}

ListVersionsRes {
		Total    int64         `json:"total,optional"` // 总数
		Versions []VersionItem `json:"versions,optional"` // 版本列表
	}
)

type (
AppVersionBrief {
		VersionID uint64 `json:"versionId,optional"` // 版本ID
		Version   string `json:"version,optional"` // 版本号
	}

AppVersionsArchItem {
		ArchitectureID uint64            `json:"architectureId,optional"` // 架构ID
		ArchID         uint32            `json:"archId,optional"` // 架构类型
		Description    string            `json:"description,optional"` // 架构描述
		Versions       []AppVersionBrief `json:"versions,optional"` // 版本列表
	}

ListAppVersionsReq {
		AppID    string `json:"appId,optional"` // 应用ID
		Page     int32  `json:"page,optional"` // 页码
		PageSize int32  `json:"pageSize,optional"` // 每页条数
	}

ListAppVersionsRes {
		Total         int64                 `json:"total,optional"` // 总数
		Architectures []AppVersionsArchItem `json:"architectures,optional"` // 按架构分组的版本
	}
)

type (
UpsertReleasePolicyReq {
		AppID           string `json:"appId,optional"` // 应用ID
		ArchitectureID  uint64 `json:"architectureId,optional"` // 架构ID
		StableVersionID uint64 `json:"stableVersionId,optional"` // 稳定版版本ID
		GrayVersionID   uint64 `json:"grayVersionId,optional"` // 灰度版版本ID
		RolloutPercent  uint32 `json:"rolloutPercent,optional"` // 灰度比例
		MinVersion      string `json:"minVersion,optional"` // 最低可用版本
		ForceUpdate     bool   `json:"forceUpdate,optional"` // 是否强制更新
		IsActive        bool   `json:"isActive,optional"` // 是否启用
	}

UpsertReleasePolicyRes {
		ID uint64 `json:"id,optional"` // 记录ID
	}
)

type (
ReleasePolicyItem {
		ID              uint64 `json:"id,optional"` // 记录ID
		AppID           string `json:"appId,optional"` // 应用ID
		ArchitectureID  uint64 `json:"architectureId,optional"` // 架构ID
		StableVersionID uint64 `json:"stableVersionId,optional"` // 稳定版版本ID
		GrayVersionID   uint64 `json:"grayVersionId,optional"` // 灰度版版本ID
		RolloutPercent  uint32 `json:"rolloutPercent,optional"` // 灰度比例
		MinVersion      string `json:"minVersion,optional"` // 最低可用版本
		ForceUpdate     bool   `json:"forceUpdate,optional"` // 是否强制更新
		IsActive        bool   `json:"isActive,optional"` // 是否启用
		StableVersion   string `json:"stableVersion,optional"` // 稳定版版本号
		GrayVersion     string `json:"grayVersion,optional"` // 灰度版版本号
		CreatedAt       string `json:"createdAt,optional"` // 创建时间
		UpdatedAt       string `json:"updatedAt,optional"` // 更新时间
	}

ListReleasePoliciesReq {
		AppID string `json:"appId,optional"` // 应用ID
	}

ListReleasePoliciesRes {
		Policies []ReleasePolicyItem `json:"policies,optional"` // 策略列表
	}
)

type (
FeedbackItem {
		ID           uint64   `json:"id,optional"` // 反馈ID
		UserID       string   `json:"userId,optional"` // 用户ID
		Content      string   `json:"content,optional"` // 反馈内容
		Type         int32    `json:"type,optional"` // 反馈类型
		Status       int32    `json:"status,optional"` // 状态
		FileNames    []string `json:"fileNames,optional"` // 附件
		HandlerID    int64    `json:"handlerId,optional"` // 处理人ID
		HandleTime   string   `json:"handleTime,optional"` // 处理时间
		HandleResult string   `json:"handleResult,optional"` // 处理结果
		CreatedAt    string   `json:"createdAt,optional"` // 创建时间
		UpdatedAt    string   `json:"updatedAt,optional"` // 更新时间
	}

ListFeedbackReq {
		Page     int32  `json:"page,optional"` // 页码
		PageSize int32  `json:"pageSize,optional"` // 每页条数
		Status   int32  `json:"status,optional"` // 状态筛选
		Type     int32  `json:"type,optional"` // 类型筛选
		UserID   string `json:"userId,optional"` // 用户ID筛选
		Keywords string `json:"keywords,optional"` // 关键词
	}

ListFeedbackRes {
		Total int64          `json:"total,optional"` // 总数
		List  []FeedbackItem `json:"list,optional"` // 反馈列表
	}
)

type (
GetFeedbackReq {
		ID uint64 `json:"id,optional"` // 反馈ID
	}

GetFeedbackRes {
		Feedback *FeedbackItem `json:"feedback,optional"` // 反馈详情
	}
)

type (
HandleFeedbackReq {
		ID           uint64 `json:"id,optional"` // 反馈ID
		Status       int32  `json:"status,optional"` // 目标状态
		HandleResult string `json:"handleResult,optional"` // 处理结果
		HandlerID    string `json:"handlerId,optional"` // 处理人ID
	}

HandleFeedbackRes {}
)

type (
DeleteFeedbackReq {
		ID uint64 `json:"id,optional"` // 反馈ID
	}

DeleteFeedbackRes {}
)

type (
ContentReportItem {
		ID             uint64   `json:"id,optional"` // 举报ID
		ReporterUserID string   `json:"reporterUserId,optional"` // 举报人ID
		TargetType     int32    `json:"targetType,optional"` // 对象类型 1用户 2消息 3动态 4群组
		TargetID       string   `json:"targetId,optional"` // 对象ID
		ReasonType     int32    `json:"reasonType,optional"` // 原因类型
		Content        string   `json:"content,optional"` // 补充说明
		FileNames      []string `json:"fileNames,optional"` // 证据附件
		Status         int32    `json:"status,optional"` // 状态
		CaseID         uint64   `json:"caseId,optional"` // 关联工单ID
		HandlerID      string   `json:"handlerId,optional"` // 处理人ID
		HandleRemark   string   `json:"handleRemark,optional"` // 处理备注
		CreatedAt      string   `json:"createdAt,optional"` // 创建时间
	}

ListContentReportsReq {
		Page           int32  `json:"page,optional"` // 页码
		PageSize       int32  `json:"pageSize,optional"` // 每页条数
		Status         int32  `json:"status,optional"` // 状态筛选
		TargetType     int32  `json:"targetType,optional"` // 对象类型筛选
		TargetID       string `json:"targetId,optional"` // 对象ID筛选
		ReporterUserID string `json:"reporterUserId,optional"` // 举报人筛选
	}

ListContentReportsRes {
		Total int64               `json:"total,optional"` // 总数
		List  []ContentReportItem `json:"list,optional"` // 举报列表
	}
)

type (
GetContentReportReq {
		ID uint64 `json:"id,optional"` // 举报ID
	}

GetContentReportRes {
		Report *ContentReportItem `json:"report,optional"` // 举报详情
	}
)

type (
UpdateContentReportsReq {
		IDs          []uint64 `json:"ids,optional"` // 举报ID列表
		Action       int32    `json:"action,optional"` // 批量操作
		HandlerID    string   `json:"handlerId,optional"` // 处理人ID
		HandleRemark string   `json:"handleRemark,optional"` // 处理备注
		CaseID       uint64   `json:"caseId,optional"` // 关联工单ID
	}

UpdateContentReportsRes {
		AffectedCount int64 `json:"affectedCount,optional"` // 影响条数
	}
)

type (
CreateWorkbenchAppReq {
		Name        string                `json:"name,optional"` // 名称
		Description string                `json:"description,optional"` // 描述
		Icon        string                `json:"icon,optional"` // 图标
		AppType     int32                 `json:"appType,optional"` // 应用类型
		ClientScope int32                 `json:"clientScope,optional"` // 端范围
		EntryConfig *WorkbenchEntryConfig `json:"entryConfig,optional"` // 入口配置
		Category    int32                 `json:"category,optional"` // 分类
		Sort        int32                 `json:"sort,optional"` // 排序
		Status      int32                 `json:"status,optional"` // 状态
		Remark      string                `json:"remark,optional"` // 备注
		OperatorID  string                `json:"operatorId,optional"` // 操作人
		OpenMode    int32                 `json:"openMode,optional"` // 打开方式
	}

CreateWorkbenchAppRes {
		WorkbenchAppID string `json:"workbenchAppId,optional"` // 工作台应用ID
	}
)

type (
UpdateWorkbenchAppReq {
		WorkbenchAppID string                `json:"workbenchAppId,optional"` // 工作台应用ID
		Name           string                `json:"name,optional"` // 名称
		Description    string                `json:"description,optional"` // 描述
		Icon           string                `json:"icon,optional"` // 图标
		AppType        *int32                `json:"appType,optional"` // 应用类型
		ClientScope    *int32                `json:"clientScope,optional"` // 端范围
		EntryConfig    *WorkbenchEntryConfig `json:"entryConfig,optional"` // 入口配置
		Category       *int32                `json:"category,optional"` // 分类
		Sort           *int32                `json:"sort,optional"` // 排序
		Status         *int32                `json:"status,optional"` // 状态
		Remark         string                `json:"remark,optional"` // 备注
		OperatorID     string                `json:"operatorId,optional"` // 操作人
		OpenMode       *int32                `json:"openMode,optional"` // 打开方式
	}

UpdateWorkbenchAppRes {}
)

type (
DeleteWorkbenchAppReq {
		WorkbenchAppID string `json:"workbenchAppId,optional"` // 工作台应用ID
	}

DeleteWorkbenchAppRes {}
)

type (
GetWorkbenchAppReq {
		WorkbenchAppID string `json:"workbenchAppId,optional"` // 工作台应用ID
	}

GetWorkbenchAppRes {
		App *WorkbenchAppItem `json:"app,optional"` // 应用详情
	}
)

type (
WorkbenchAppItem {
		ID             uint64               `json:"id,optional"` // 记录ID
		WorkbenchAppID string               `json:"workbenchAppId,optional"` // 工作台应用ID
		Name           string               `json:"name,optional"` // 名称
		Description    string               `json:"description,optional"` // 描述
		Icon           string               `json:"icon,optional"` // 图标
		AppType        int32                `json:"appType,optional"` // 应用类型
		ClientScope    int32                `json:"clientScope,optional"` // 端范围
		EntryConfig    *WorkbenchEntryConfig `json:"entryConfig,optional"` // 入口配置
		Category       int32                `json:"category,optional"` // 分类
		Sort           int32                `json:"sort,optional"` // 排序
		Status         int32                `json:"status,optional"` // 状态
		CreatedBy      string               `json:"createdBy,optional"` // 创建人
		LastModifiedBy string               `json:"lastModifiedBy,optional"` // 最后修改人
		Remark         string               `json:"remark,optional"` // 备注
		CreatedAt      string               `json:"createdAt,optional"` // 创建时间
		UpdatedAt      string               `json:"updatedAt,optional"` // 更新时间
		OpenMode       int32                `json:"openMode,optional"` // 打开方式
	}

AdminListWorkbenchAppsReq {
		Page     int32  `json:"page,optional"` // 页码
		PageSize int32  `json:"pageSize,optional"` // 每页条数
		Status   int32  `json:"status,optional"` // 状态筛选
		Category *int32 `json:"category,optional"` // 分类筛选
		Keywords string `json:"keywords,optional"` // 关键词
	}

AdminListWorkbenchAppsRes {
		Total int64              `json:"total,optional"` // 总数
		List  []WorkbenchAppItem `json:"list,optional"` // 应用列表
	}
)

@server (
	group: admin
	middleware: JwtS2s
)
service platform {
	@doc "队间：查询后台操作日志"
	@handler adminQueryLogs
	post /beaver/api/platform/admin/v1/admin_query_logs (AdminQueryLogsReq) returns (AdminQueryLogsRes)

	@doc "队间：创建应用"
	@handler createApp
	post /beaver/api/platform/admin/v1/create_app (CreateAppReq) returns (CreateAppRes)

	@doc "队间：分页查询应用"
	@handler listApps
	post /beaver/api/platform/admin/v1/list_apps (ListAppsReq) returns (ListAppsRes)

	@doc "队间：创建应用架构"
	@handler createArchitecture
	post /beaver/api/platform/admin/v1/create_architecture (CreateArchitectureReq) returns (CreateArchitectureRes)

	@doc "队间：更新应用架构"
	@handler updateArchitecture
	post /beaver/api/platform/admin/v1/update_architecture (UpdateArchitectureReq) returns (UpdateArchitectureRes)

	@doc "队间：分页查询应用架构"
	@handler listArchitectures
	post /beaver/api/platform/admin/v1/list_architectures (ListArchitecturesReq) returns (ListArchitecturesRes)

	@doc "队间：创建版本"
	@handler createVersion
	post /beaver/api/platform/admin/v1/create_version (CreateVersionReq) returns (CreateVersionRes)

	@doc "队间：删除版本"
	@handler deleteVersion
	post /beaver/api/platform/admin/v1/delete_version (DeleteVersionReq) returns (DeleteVersionRes)

	@doc "队间：分页查询版本"
	@handler listVersions
	post /beaver/api/platform/admin/v1/list_versions (ListVersionsReq) returns (ListVersionsRes)

	@doc "队间：按应用查询版本（按架构分组）"
	@handler listAppVersions
	post /beaver/api/platform/admin/v1/list_app_versions (ListAppVersionsReq) returns (ListAppVersionsRes)

	@doc "队间：新增或更新发布策略"
	@handler upsertReleasePolicy
	post /beaver/api/platform/admin/v1/upsert_release_policy (UpsertReleasePolicyReq) returns (UpsertReleasePolicyRes)

	@doc "队间：查询发布策略"
	@handler listReleasePolicies
	post /beaver/api/platform/admin/v1/list_release_policies (ListReleasePoliciesReq) returns (ListReleasePoliciesRes)

	@doc "队间：分页查询用户反馈"
	@handler listFeedback
	post /beaver/api/platform/admin/v1/list_feedback (ListFeedbackReq) returns (ListFeedbackRes)

	@doc "队间：查询单条用户反馈"
	@handler getFeedback
	post /beaver/api/platform/admin/v1/get_feedback (GetFeedbackReq) returns (GetFeedbackRes)

	@doc "队间：处理用户反馈"
	@handler handleFeedback
	post /beaver/api/platform/admin/v1/handle_feedback (HandleFeedbackReq) returns (HandleFeedbackRes)

	@doc "队间：删除用户反馈"
	@handler deleteFeedback
	post /beaver/api/platform/admin/v1/delete_feedback (DeleteFeedbackReq) returns (DeleteFeedbackRes)

	@doc "队间：分页查询内容举报"
	@handler listContentReports
	post /beaver/api/platform/admin/v1/list_content_reports (ListContentReportsReq) returns (ListContentReportsRes)

	@doc "队间：查询单条内容举报"
	@handler getContentReport
	post /beaver/api/platform/admin/v1/get_content_report (GetContentReportReq) returns (GetContentReportRes)

	@doc "队间：批量处理内容举报"
	@handler updateContentReports
	post /beaver/api/platform/admin/v1/update_content_reports (UpdateContentReportsReq) returns (UpdateContentReportsRes)

	@doc "队间：创建工作台应用"
	@handler createWorkbenchApp
	post /beaver/api/platform/admin/v1/create_workbench_app (CreateWorkbenchAppReq) returns (CreateWorkbenchAppRes)

	@doc "队间：更新工作台应用"
	@handler updateWorkbenchApp
	post /beaver/api/platform/admin/v1/update_workbench_app (UpdateWorkbenchAppReq) returns (UpdateWorkbenchAppRes)

	@doc "队间：删除工作台应用"
	@handler deleteWorkbenchApp
	post /beaver/api/platform/admin/v1/delete_workbench_app (DeleteWorkbenchAppReq) returns (DeleteWorkbenchAppRes)

	@doc "队间：查询单条工作台应用"
	@handler getWorkbenchApp
	post /beaver/api/platform/admin/v1/get_workbench_app (GetWorkbenchAppReq) returns (GetWorkbenchAppRes)

	@doc "队间：分页查询工作台应用"
	@handler adminListWorkbenchApps
	post /beaver/api/platform/admin/v1/list_workbench_apps (AdminListWorkbenchAppsReq) returns (AdminListWorkbenchAppsRes)
}
