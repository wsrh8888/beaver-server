syntax = "v1"

// 消息同步 API：消息版本/删除列表/媒体状态/会话元信息/用户会话设置

// 同步聊天消息
type (
	GetSyncChatMessagesReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Since  int64  `json:"since,optional"` // 从这个序列号之后开始同步，不传则同步所有
	}
	GetSyncChatMessagesRes {
		MessageVersions []ChatMessageVersionItem `json:"messageVersions"` // 变更的消息版本摘要
		ServerTimestamp int64                    `json:"serverTimestamp"` // 服务端处理时间戳
	}
	ChatMessageVersionItem {
		ConversationID string `json:"conversationId"` // 会话ID
		Seq            int64  `json:"seq"` // 会话最新消息序列号
	}
)

// 同步被删除的消息 ID 列表（仅自己可见的删除动作同步）
type (
	GetSyncDeletedMessagesReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Since  int64  `json:"since,optional"` // 从这个时间戳之后开始同步
	}
	GetSyncDeletedMessagesRes {
		MessageIDs      []string `json:"messageIds"` // 被删除的消息ID列表
		ServerTimestamp int64    `json:"serverTimestamp"` // 服务端同步时间戳
	}
)

// 同步消息媒体状态（语音已听等）
type (
	GetSyncMessageMediasReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Since  int64  `json:"since,optional"` // 从这个时间戳之后开始同步
	}
	GetSyncMessageMediasRes {
		MessageIDs      []string `json:"messageIds"` // 已标记媒体状态的消息ID列表
		ServerTimestamp int64    `json:"serverTimestamp"` // 服务端同步时间戳
	}
)

// 同步会话元信息
type (
	GetSyncChatConversationsReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Since  int64  `json:"since,optional"` // 从这个版本号之后开始同步，不传则同步所有
	}
	GetSyncChatConversationsRes {
		ConversationVersions []ChatConversationVersionItem `json:"conversationVersions"` // 变更的会话版本摘要
		ServerTimestamp      int64                         `json:"serverTimestamp"` // 服务端处理时间戳
	}
	ChatConversationVersionItem {
		ConversationID string `json:"conversationId"` // 会话ID
		Version        int64  `json:"version"` // 会话版本号
	}
)

// 同步用户会话设置
type (
	GetSyncChatUserConversationsReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Since  int64  `json:"since,optional"` // 从这个版本号之后开始同步，不传则同步所有
	}
	GetSyncChatUserConversationsRes {
		UserConversationVersions []ChatUserConversationVersionItem `json:"userConversationVersions"` // 变更的用户会话设置版本摘要
		ServerTimestamp          int64                             `json:"serverTimestamp"` // 服务端处理时间戳
	}
	ChatUserConversationVersionItem {
		ConversationID string `json:"conversationId"` // 会话ID
		Version        int64  `json:"version"` // 用户会话设置版本号
	}
)

@server (
	middleware: JwtS2s
	group: sync
)
service datasync {
	@doc "获取所有需要更新的聊天消息版本"
	@handler getSyncChatMessages
	post /beaver/api/datasync/sync/v1/get_sync_chat_messages (GetSyncChatMessagesReq) returns (GetSyncChatMessagesRes)

	@doc "获取所有需要更新的已删除消息ID列表"
	@handler getSyncDeletedMessages
	post /beaver/api/datasync/sync/v1/get_sync_deleted_messages (GetSyncDeletedMessagesReq) returns (GetSyncDeletedMessagesRes)

	@doc "获取所有需要同步的消息媒体状态"
	@handler getSyncMessageMedias
	post /beaver/api/datasync/sync/v1/get_sync_message_medias (GetSyncMessageMediasReq) returns (GetSyncMessageMediasRes)

	@doc "获取所有需要更新的会话元信息版本"
	@handler getSyncChatConversations
	post /beaver/api/datasync/sync/v1/get_sync_chat_conversations (GetSyncChatConversationsReq) returns (GetSyncChatConversationsRes)

	@doc "获取所有需要更新的用户会话设置版本"
	@handler getSyncChatUserConversations
	post /beaver/api/datasync/sync/v1/get_sync_chat_user_conversations (GetSyncChatUserConversationsReq) returns (GetSyncChatUserConversationsRes)
}

