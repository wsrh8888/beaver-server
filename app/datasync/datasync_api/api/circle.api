syntax = "v1"

// 圈子同步 API：圈子资料版本

// 同步圈子信息
type (
	GetSyncCircleInfoReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Since  int64  `json:"since,optional"` // 从这个版本号之后开始同步，不传则同步所有
	}
	GetSyncCircleInfoRes {
		CircleVersions  []CircleInfoVersionItem `json:"circleVersions"` // 变更的圈子信息版本摘要
		ServerTimestamp int64                   `json:"serverTimestamp"` // 服务端处理时间戳
	}
	CircleInfoVersionItem {
		CircleID string `json:"circleId"` // 圈子ID
		Version  int64  `json:"version"` // 圈子资料版本
	}
)

@server (
	middleware: JwtS2s
	group: sync
)
service datasync {
	@doc "获取所有需要更新的圈子信息版本"
	@handler getSyncCircleInfo
	post /beaver/api/datasync/sync/v1/get_sync_circle_info (GetSyncCircleInfoReq) returns (GetSyncCircleInfoRes)
}

