syntax = "v1"

// 通知同步 API：事件/收件箱/已读游标版本摘要

// 同步通知事件版本（NotificationEvent）
type (
	GetSyncNotificationEventsReq {
		SinceVersion int64 `json:"sinceVersion,optional"` // 事件表的版本游标，>sinceVersion
		Limit        int32 `json:"limit,optional"` // 可选分页大小
	}
	GetSyncNotificationEventsRes {
		EventVersions   []NotificationEventVersionItem `json:"eventVersions"` // 事件版本摘要
		MaxVersion      int64                          `json:"maxVersion"` // 本次返回的最大版本
		ServerTimestamp int64                          `json:"serverTimestamp"` // 服务端处理时间戳
	}
	NotificationEventVersionItem {
		EventID string `json:"eventId"` // 事件ID
		Version int64  `json:"version"` // 事件版本
	}
)

// 同步通知收件箱版本（NotificationInbox，按用户）
type (
	GetSyncNotificationInboxesReq {
		SinceVersion int64  `json:"sinceVersion,optional"` // 收件箱表的版本游标，>sinceVersion
		Limit        int32  `json:"limit,optional"` // 可选分页大小
	}
	GetSyncNotificationInboxesRes {
		InboxVersions   []NotificationInboxVersionItem `json:"inboxVersions"` // 收件箱版本摘要
		MaxVersion      int64                          `json:"maxVersion"` // 本次返回的最大版本
		ServerTimestamp int64                          `json:"serverTimestamp"` // 服务端处理时间戳
	}
	NotificationInboxVersionItem {
		EventID string `json:"eventId"` // 事件ID
		Version int64  `json:"version"` // 收件箱版本
	}
)

// 同步通知已读游标版本（NotificationRead，按用户+分类）
type (
	GetSyncNotificationReadCursorsReq {
		SinceVersion int64  `json:"sinceVersion,optional"` // 已读游标表的版本游标，>sinceVersion
	}
	GetSyncNotificationReadCursorsRes {
		CursorVersions  []NotificationReadCursorVersionItem `json:"cursorVersions"` // 已读游标版本摘要
		MaxVersion      int64                               `json:"maxVersion"` // 本次返回的最大版本
		ServerTimestamp int64                               `json:"serverTimestamp"` // 服务端处理时间戳
	}
	NotificationReadCursorVersionItem {
		Category string `json:"category"` // 分类
		Version  int64  `json:"version"` // 游标版本
	}
)

@server (
	jwt: Auth
)
service datasync {
	@doc "获取通知事件版本摘要"
	@handler getSyncNotificationEvents
	post /api/datasync/v1/getSyncNotificationEvents (GetSyncNotificationEventsReq) returns (GetSyncNotificationEventsRes)

	@doc "获取通知收件箱版本摘要"
	@handler getSyncNotificationInboxes
	post /api/datasync/v1/getSyncNotificationInboxes (GetSyncNotificationInboxesReq) returns (GetSyncNotificationInboxesRes)

	@doc "获取通知已读游标版本摘要"
	@handler getSyncNotificationReadCursors
	post /api/datasync/v1/getSyncNotificationReadCursors (GetSyncNotificationReadCursorsReq) returns (GetSyncNotificationReadCursorsRes)
}

