syntax = "v1"

// 添加表情
type (
	AddEmojiReq {
		UserID    string       `header:"Beaver-User-Id"`
		FileKey   string       `json:"fileKey"`
		Title     string       `json:"title"`
		PackageID string       `json:"packageId,optional"`
		EmojiInfo AddEmojiInfo `json:"emojiInfo"`
	}
	AddEmojiInfo {
		Width  int `json:"width"`
		Height int `json:"height"`
	}
	AddEmojiRes  {}
)

// 更新表情收藏状态
type (
	UpdateFavoriteEmojiReq {
		UserID    string  `header:"Beaver-User-Id"`
		EmojiID   string  `json:"emojiId"`
		PackageID *string `json:"packageId,optional"` // 可选，表情所属的表情包ID，用于扩展功能
		Type      string  `json:"type"` // "favorite" or "unfavorite"
	}
	UpdateFavoriteEmojiRes  {}
)

// 获取用户收藏的表情列表
type (
	GetEmojisListReq {
		UserID string `header:"Beaver-User-Id"`
		Page   int    `json:"page"`
		Size   int    `json:"size"`
	}
	EmojiItem {
		EmojiID   string        `json:"emojiId"`
		FileKey   string        `json:"fileKey"`
		Title     string        `json:"title"`
		EmojiInfo *GetEmojiInfo `json:"emojiInfo"`
		PackageID *string       `json:"packageId"`
	}
	GetEmojiInfo {
		Width  int `json:"width"`
		Height int `json:"height"`
	}
	GetEmojisListRes {
		Count int64       `json:"count"`
		List  []EmojiItem `json:"list"`
	}
)

// 获取表情包列表
type (
	GetEmojiPackagesReq {
		UserID     string `header:"Beaver-User-Id"`
		CategoryID uint   `json:"categoryId,optional"` // 可选，按分类筛选
		Type       string `json:"type,optional"` // 可选，按类型筛选：official-官方，user-用户自定义
		Page       int    `json:"page"`
		Size       int    `json:"size"`
	}
	GetEmojiPackagesSimpleItem {
		EmojiID   string               `json:"emojiId"`
		FileKey   string               `json:"fileKey"`
		Title     string               `json:"title"`
		Version   int64                `json:"version"`
		Status    int8                 `json:"status"`
		EmojiInfo GetEmojiPackagesInfo `json:"emojiInfo"`
	}
	GetEmojiPackagesInfo {
		Width  int `json:"width"`
		Height int `json:"height"`
	}
	EmojiPackageItem {
		PackageID    string                       `json:"packageId"`
		Title        string                       `json:"title"`
		CoverFile    string                       `json:"coverFile"`
		Description  string                       `json:"description"`
		Type         string                       `json:"type"` // 类型：official-官方，user-用户自定义
		CollectCount int                          `json:"collectCount"`
		EmojiCount   int                          `json:"emojiCount"`
		IsCollected  bool                         `json:"isCollected"` // 当前用户是否已收藏
		IsAuthor     bool                         `json:"isAuthor"` // 当前用户是否是作者
		RecentEmojis []GetEmojiPackagesSimpleItem `json:"recentEmojis"` // 最近6个表情
	}
	GetEmojiPackagesRes {
		Count int64              `json:"count"`
		List  []EmojiPackageItem `json:"list"`
	}
)

// 获取表情包详情
type (
	GetEmojiPackageDetailReq {
		UserID    string `header:"Beaver-User-Id"`
		PackageID string `json:"packageId"`
	}
	GetEmojiPackageEmojiItem {
		EmojiID   string               `json:"emojiId"`
		FileKey   string               `json:"fileKey"`
		Title     string               `json:"title"`
		EmojiInfo *GetEmojiPackageInfo `json:"emojiInfo"`
		PackageID *string              `json:"packageId"`
	}
	GetEmojiPackageInfo {
		Width  int `json:"width"`
		Height int `json:"height"`
	}
	GetEmojiPackageDetailRes {
		PackageID    string                     `json:"packageId"`
		Title        string                     `json:"title"`
		CoverFile    string                     `json:"coverFile"`
		Description  string                     `json:"description"`
		Type         string                     `json:"type"` // 类型：official-官方，user-用户自定义
		CollectCount int                        `json:"collectCount"`
		EmojiCount   int                        `json:"emojiCount"`
		IsCollected  bool                       `json:"isCollected"`
		IsAuthor     bool                       `json:"isAuthor"` // 当前用户是否是作者
		Emojis       []GetEmojiPackageEmojiItem `json:"emojis"`
	}
)

// 更新表情包收藏状态
type (
	UpdateFavoriteEmojiPackageReq {
		UserID    string `header:"Beaver-User-Id"`
		PackageID string `json:"packageId"`
		Type      string `json:"type"` // "favorite" or "unfavorite"
	}
	UpdateFavoriteEmojiPackageRes  {}
)

// 获取用户收藏的表情包列表
type (
	GetUserFavoritePackagesReq {
		UserID string `header:"Beaver-User-Id"`
		Page   int    `json:"page"`
		Size   int    `json:"size"`
	}
	GetUserFavoritePackagesRes {
		Count int64              `json:"count"`
		List  []EmojiPackageItem `json:"list"`
	}
)

// 批量获取表情详情
type (
	GetEmojisByIdsReq {
		UserID string   `header:"Beaver-User-Id"`
		Ids    []string `json:"ids"` // 表情ID列表
	}
	GetEmojisByIdsRes {
		Emojis []EmojiDetailItem `json:"emojis"`
	}
	GetEmojiByIdsInfo {
		Width  int `json:"width"`
		Height int `json:"height"`
	}
	EmojiDetailItem {
		EmojiID   string            `json:"emojiId"`
		FileKey   string            `json:"fileKey"`
		Title     string            `json:"title"`
		EmojiInfo GetEmojiByIdsInfo `json:"emojiInfo"`
		PackageID *string           `json:"packageId"`
		Status    int8              `json:"status"`
		Version   int64             `json:"version"`
		CreatedAt int64             `json:"createdAt"`
		UpdatedAt int64             `json:"updatedAt"`
	}
)

// 按ID批量获取表情基础信息
type (
	GetEmojisByUuidsReq {
		Ids []string `json:"ids"` // 表情ID列表
	}
	GetEmojiByUuidsInfo {
		Width  int `json:"width"`
		Height int `json:"height"`
	}
	EmojiSimpleItem {
		EmojiID   string              `json:"emojiId"`
		FileKey   string              `json:"fileKey"`
		Title     string              `json:"title"`
		Version   int64               `json:"version"`
		Status    int8                `json:"status"`
		EmojiInfo GetEmojiByUuidsInfo `json:"emojiInfo"`
	}
	GetEmojisByUuidsRes {
		Emojis []EmojiSimpleItem `json:"emojis"`
	}
)

// 批量获取表情包详情
type (
	GetEmojiPackagesByIdsReq {
		UserID string   `header:"Beaver-User-Id"`
		Ids    []string `json:"ids"` // 表情包ID列表
	}
	GetEmojiPackagesByIdsRes {
		Packages []EmojiPackageDetailItem `json:"packages"`
	}
	EmojiPackageDetailItem {
		PackageID    string `json:"packageId"`
		Title        string `json:"title"`
		CoverFile    string `json:"coverFile"`
		UserID       string `json:"userId"`
		Description  string `json:"description"`
		Type         string `json:"type"`
		Status       int8   `json:"status"`
		CollectCount int    `json:"collectCount"`
		CreatedAt    int64  `json:"createdAt"`
		UpdatedAt    int64  `json:"updatedAt"`
		Version      int64  `json:"version"`
	}
)

// 批量获取用户收藏的表情记录详情（同步用）
type (
	GetEmojiCollectsByIdsReq {
		UserID string   `header:"Beaver-User-Id"`
		Ids    []string `json:"ids"` // 收藏记录ID列表
	}
	GetEmojiCollectsByIdsRes {
		Collects []EmojiCollectDetailItem `json:"collects"`
	}
	EmojiCollectDetailItem {
		EmojiCollectID string  `json:"emojiCollectId"`
		UserID         string  `json:"userId"`
		EmojiID        string  `json:"emojiId"`
		FileKey        string  `json:"fileKey"`
		Title          string  `json:"title"`
		PackageID      *string `json:"packageId"`
		IsDeleted      bool    `json:"isDeleted"`
		Version        int64   `json:"version"`
		CreatedAt      int64   `json:"createdAt"`
		UpdatedAt      int64   `json:"updatedAt"`
	}
)

// 按收藏ID批量获取表情收藏记录（同步补齐）
type (
	GetEmojiCollectsByUuidsReq {
		Ids []string `json:"ids"` // 收藏记录ID列表
	}
	GetEmojiCollectsByUuidsRes {
		Collects []EmojiCollectDetailItem `json:"collects"`
	}
)

// 批量获取用户收藏的表情包记录详情（同步用）
type (
	GetEmojiPackageCollectsByIdsReq {
		UserID string   `header:"Beaver-User-Id"`
		Ids    []string `json:"ids"` // 收藏记录ID列表
	}
	GetEmojiPackageCollectsByIdsRes {
		Collects []EmojiPackageCollectDetailItem `json:"collects"`
	}
	EmojiPackageCollectDetailItem {
		PackageCollectID string `json:"packageCollectId"`
		UserID           string `json:"userId"`
		PackageID        string `json:"packageId"`
		IsDeleted        bool   `json:"isDeleted"`
		Version          int64  `json:"version"`
		CreatedAt        int64  `json:"createdAt"`
		UpdatedAt        int64  `json:"updatedAt"`
	}
)

// 批量获取表情包内容详情（同步用）
type (
	GetEmojiPackageContentsByPackageIdsReq {
		UserID     string   `header:"Beaver-User-Id"`
		PackageIds []string `json:"packageIds"` // 表情包ID列表
	}
	GetEmojiPackageContentsByPackageIdsRes {
		Contents []EmojiPackageContentDetailItem `json:"contents"`
	}
	EmojiPackageContentDetailItem {
		RelationID string `json:"relationId"`
		PackageID  string `json:"packageId"`
		EmojiID    string `json:"emojiId"`
		SortOrder  int    `json:"sortOrder"`
		Version    int64  `json:"version"`
		CreatedAt  int64  `json:"createdAt"`
		UpdatedAt  int64  `json:"updatedAt"`
	}
)

// 批量获取表情包内容详情（通过relationIds，同步用）
type (
	GetEmojiPackageContentsByRelationIdsReq {
		UserID      string   `header:"Beaver-User-Id"`
		RelationIds []string `json:"relationIds"` // 关联ID列表
	}
	GetEmojiPackageContentsByRelationIdsRes {
		Contents []EmojiPackageContentDetailItem `json:"contents"`
	}
)

@server (
	group: emoji
)
service asset {
	@doc "添加表情，并且自动收藏"
	@handler AddEmoji
	post /api/emoji/v1/add (AddEmojiReq) returns (AddEmojiRes)

	@doc "收藏或者取消收藏表情"
	@handler UpdateFavoriteEmoji
	post /api/emoji/v1/favoriteEmoji (UpdateFavoriteEmojiReq) returns (UpdateFavoriteEmojiRes)

	@doc "获取用户收藏的表情列表"
	@handler GetEmojisList
	post /api/emoji/v1/favoriteList (GetEmojisListReq) returns (GetEmojisListRes)

	@doc "获取表情包列表"
	@handler GetEmojiPackages
	post /api/emoji/v1/packageList (GetEmojiPackagesReq) returns (GetEmojiPackagesRes)

	@doc "获取表情包详情"
	@handler GetEmojiPackageDetail
	post /api/emoji/v1/packageInfo (GetEmojiPackageDetailReq) returns (GetEmojiPackageDetailRes)

	@doc "收藏或取消收藏表情包"
	@handler UpdateFavoriteEmojiPackage
	post /api/emoji/v1/packageFavorite (UpdateFavoriteEmojiPackageReq) returns (UpdateFavoriteEmojiPackageRes)

	@doc "获取用户收藏的表情包列表"
	@handler GetUserFavoritePackages
	post /api/emoji/v1/favoritePackageList (GetUserFavoritePackagesReq) returns (GetUserFavoritePackagesRes)

	@doc "批量获取表情详情（数据库同步）"
	@handler GetEmojisByIds
	post /api/emoji/v1/emojis-by-ids (GetEmojisByIdsReq) returns (GetEmojisByIdsRes)

	@doc "按ID批量查询表情基础信息（数据库同步）"
	@handler GetEmojisByUuids
	post /api/emoji/v1/getEmojisByUuids (GetEmojisByUuidsReq) returns (GetEmojisByUuidsRes)

	@doc "批量获取表情包详情（数据库同步）"
	@handler GetEmojiPackagesByIds
	post /api/emoji/v1/packages-by-ids (GetEmojiPackagesByIdsReq) returns (GetEmojiPackagesByIdsRes)

	@doc "批量获取用户收藏的表情记录详情（数据库同步）"
	@handler GetEmojiCollectsByIds
	post /api/emoji/v1/collects-by-ids (GetEmojiCollectsByIdsReq) returns (GetEmojiCollectsByIdsRes)

	@doc "批量获取用户收藏的表情包记录详情（数据库同步）"
	@handler GetEmojiPackageCollectsByIds
	post /api/emoji/v1/package-collects-by-ids (GetEmojiPackageCollectsByIdsReq) returns (GetEmojiPackageCollectsByIdsRes)

	@doc "批量获取表情包内容详情（数据库同步）"
	@handler GetEmojiPackageContentsByPackageIds
	post /api/emoji/v1/package-contents-by-package-ids (GetEmojiPackageContentsByPackageIdsReq) returns (GetEmojiPackageContentsByPackageIdsRes)

	@doc "批量获取表情包内容详情（通过relationIds，数据库同步）"
	@handler GetEmojiPackageContentsByRelationIds
	post /api/emoji/v1/package-contents-by-relation-ids (GetEmojiPackageContentsByRelationIdsReq) returns (GetEmojiPackageContentsByRelationIdsRes)
}

// ==================== 队间（S2S）能力面 ====================
// 与上面 C 端视图共用同一套 /api 契约，身份由 authgate 中间件区分。
// C 端按「当前用户」取表情，队间按「记录维度」分页与写入，路径刻意错开。

type (
	MachineEmojiInfo {
		Width  int32 `json:"width,optional"` // 宽
		Height int32 `json:"height,optional"` // 高
	}
	MachineEmojiItem {
		EmojiId   string            `json:"emoji_id,optional"` // 表情ID
		FileKey   string            `json:"file_key,optional"` // 文件Key
		Title     string            `json:"title,optional"` // 表情名称
		EmojiInfo *MachineEmojiInfo `json:"emoji_info,optional"` // 尺寸信息
		Status    int32             `json:"status,optional"` // 状态：1=正常 2=审核中 3=违规禁用
		CreatedAt string            `json:"created_at,optional"` // 创建时间
		UpdatedAt string            `json:"updated_at,optional"` // 更新时间
	}
	MachineEmojiPackageItem {
		PackageId   string `json:"package_id,optional"` // 表情包ID
		Title       string `json:"title,optional"` // 名称
		CoverFile   string `json:"cover_file,optional"` // 封面文件Key
		UserId      string `json:"user_id,optional"` // 所属用户ID
		Description string `json:"description,optional"` // 描述
		Type        string `json:"type,optional"` // 类型：official / user
		Status      int32  `json:"status,optional"` // 状态
		CreatedAt   string `json:"created_at,optional"` // 创建时间
		UpdatedAt   string `json:"updated_at,optional"` // 更新时间
	}
	EmojiCollectItem {
		CollectId    string `json:"collect_id,optional"` // 收藏记录ID
		UserId       string `json:"user_id,optional"` // 用户ID
		EmojiId      string `json:"emoji_id,optional"` // 表情ID
		EmojiTitle   string `json:"emoji_title,optional"` // 表情名称
		EmojiFileKey string `json:"emoji_file_key,optional"` // 表情文件Key
		CreatedAt    string `json:"created_at,optional"` // 创建时间
		UpdatedAt    string `json:"updated_at,optional"` // 更新时间
	}

	ListEmojisReq {
		Page      int32  `json:"page,optional"` // 页码
		PageSize  int32  `json:"page_size,optional"` // 每页条数
		Title     string `json:"title,optional"` // 表情名称筛选
		StartTime string `json:"start_time,optional"` // 开始时间
		EndTime   string `json:"end_time,optional"` // 结束时间
		EmojiId   string `json:"emoji_id,optional"` // 表情ID精确查
		PackageId string `json:"package_id,optional"` // 表情包ID筛选
	}
	ListEmojisRes {
		Total int64              `json:"total,optional"` // 总数
		List  []MachineEmojiItem `json:"list,optional"` // 表情列表
	}

	ListEmojiPackagesReq {
		Page      int32  `json:"page,optional"` // 页码
		PageSize  int32  `json:"page_size,optional"` // 每页条数
		UserId    string `json:"user_id,optional"` // 所属用户筛选
		Type      string `json:"type,optional"` // 类型筛选
		Status    int32  `json:"status,optional"` // 状态筛选
		Title     string `json:"title,optional"` // 名称筛选
		StartTime string `json:"start_time,optional"` // 开始时间
		EndTime   string `json:"end_time,optional"` // 结束时间
		PackageId string `json:"package_id,optional"` // 表情包ID精确查
	}
	ListEmojiPackagesRes {
		Total int64                     `json:"total,optional"` // 总数
		List  []MachineEmojiPackageItem `json:"list,optional"` // 表情包列表
	}

	ListEmojiCollectsReq {
		Page      int32  `json:"page,optional"` // 页码
		PageSize  int32  `json:"page_size,optional"` // 每页条数
		UserId    string `json:"user_id,optional"` // 用户ID筛选
		EmojiId   string `json:"emoji_id,optional"` // 表情ID筛选
		StartTime string `json:"start_time,optional"` // 开始时间
		EndTime   string `json:"end_time,optional"` // 结束时间
	}
	ListEmojiCollectsRes {
		Total int64               `json:"total,optional"` // 总数
		List  []EmojiCollectItem  `json:"list,optional"` // 收藏列表
	}

	SaveEmojiReq {
		EmojiId      string            `json:"emoji_id,optional"` // 表情ID，空表示新建
		FileKey      string            `json:"file_key,optional"` // 文件Key
		Title        string            `json:"title,optional"` // 表情名称
		EmojiInfo    *MachineEmojiInfo `json:"emoji_info,optional"` // 尺寸信息
		PatchFileKey *string           `json:"patch_file_key,optional"` // 增量改文件Key
		PatchTitle   *string           `json:"patch_title,optional"` // 增量改名称
		Delete       *bool             `json:"delete,optional"` // 删除标记
	}
	SaveEmojiRes {
		EmojiId string `json:"emoji_id,optional"` // 表情ID
	}

	SaveEmojiPackageReq {
		PackageId        string  `json:"package_id,optional"` // 表情包ID，空表示新建
		Title            string  `json:"title,optional"` // 名称
		CoverFile        string  `json:"cover_file,optional"` // 封面文件Key
		UserId           string  `json:"user_id,optional"` // 所属用户ID
		Description      string  `json:"description,optional"` // 描述
		Type             string  `json:"type,optional"` // 类型
		PatchTitle       *string `json:"patch_title,optional"` // 增量改名称
		PatchCoverFile   *string `json:"patch_cover_file,optional"` // 增量改封面
		PatchDescription *string `json:"patch_description,optional"` // 增量改描述
		PatchType        *string `json:"patch_type,optional"` // 增量改类型
		PatchStatus      *int32  `json:"patch_status,optional"` // 增量改状态
		Delete           *bool   `json:"delete,optional"` // 删除标记
	}
	SaveEmojiPackageRes {
		PackageId string `json:"package_id,optional"` // 表情包ID
	}

	UpdateEmojiPackageContentReq {
		PackageId string            `json:"package_id,optional"` // 表情包ID
		Action    int32             `json:"action,optional"` // 操作类型
		EmojiId   string            `json:"emoji_id,optional"` // 表情ID
		FileKey   string            `json:"file_key,optional"` // 文件Key
		Title     string            `json:"title,optional"` // 表情名称
		EmojiInfo *MachineEmojiInfo `json:"emoji_info,optional"` // 尺寸信息
	}
	UpdateEmojiPackageContentRes {
		RelationId string `json:"relation_id,optional"` // 关联记录ID
		EmojiId    string `json:"emoji_id,optional"` // 表情ID
	}
)

@server (
	group: emoji_machine
)
service asset {
	@doc "队间：分页查询表情"
	@handler EmojiList
	post /api/emoji/v1/list_emojis (ListEmojisReq) returns (ListEmojisRes)

	@doc "队间：分页查询表情包"
	@handler EmojiPackageList
	post /api/emoji/v1/list_packages (ListEmojiPackagesReq) returns (ListEmojiPackagesRes)

	@doc "队间：分页查询用户收藏的表情"
	@handler EmojiCollectList
	post /api/emoji/v1/list_collects (ListEmojiCollectsReq) returns (ListEmojiCollectsRes)

	@doc "队间：新建/增量更新表情"
	@handler EmojiSave
	post /api/emoji/v1/save (SaveEmojiReq) returns (SaveEmojiRes)

	@doc "队间：新建/增量更新表情包"
	@handler EmojiPackageSave
	post /api/emoji/v1/save_package (SaveEmojiPackageReq) returns (SaveEmojiPackageRes)

	@doc "队间：增删表情包内容"
	@handler EmojiPackageContentUpdate
	post /api/emoji/v1/update_package_content (UpdateEmojiPackageContentReq) returns (UpdateEmojiPackageContentRes)
}

// goctl api go -api asset_api.api -dir . --home ../../../template
