syntax = "v1"

// 添加表情

// 更新表情收藏状态

// 获取用户收藏的表情列表

// 获取表情包列表

// 获取表情包详情

// 更新表情包收藏状态

// 获取用户收藏的表情包列表

// 批量获取表情详情

// 按ID批量获取表情基础信息

// 批量获取表情包详情

// 批量获取用户收藏的表情记录详情（同步用）

// 按收藏ID批量获取表情收藏记录（同步补齐）

// 批量获取用户收藏的表情包记录详情（同步用）

// 批量获取表情包内容详情（同步用）

// 批量获取表情包内容详情（通过relationIds，同步用）

type (
AddEmojiReq {
		UserID    string       `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		FileKey   string       `json:"fileKey"`
		Title     string       `json:"title"`
		PackageID string       `json:"packageId,optional"`
		EmojiInfo AddEmojiInfo `json:"emojiInfo"`
	}

AddEmojiRes  {}
)

type (
UpdateFavoriteEmojiReq {
		UserID    string  `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		EmojiID   string  `json:"emojiId"`
		PackageID *string `json:"packageId,optional"` // 可选，表情所属的表情包ID，用于扩展功能
		Type      string  `json:"type"` // "favorite" or "unfavorite"
	}

UpdateFavoriteEmojiRes  {}
)

type (
GetEmojisListReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Page   int    `json:"page"`
		Size   int    `json:"size"`
	}

EmojiItem {
		EmojiID   string        `json:"emojiId"`
		FileKey   string        `json:"fileKey"`
		Title     string        `json:"title"`
		EmojiInfo *GetEmojiInfo `json:"emojiInfo"`
		PackageID *string       `json:"packageId"`
	}

GetEmojisListRes {
		Count int64       `json:"count"`
		List  []EmojiItem `json:"list"`
	}
)

type (
GetEmojiPackagesReq {
		UserID     string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		CategoryID uint   `json:"categoryId,optional"` // 可选，按分类筛选
		Type       string `json:"type,optional"` // 可选，按类型筛选：official-官方，user-用户自定义
		Page       int    `json:"page"`
		Size       int    `json:"size"`
	}

GetEmojiPackagesRes {
		Count int64              `json:"count"`
		List  []EmojiPackageItem `json:"list"`
	}
)

type (
GetEmojiPackageDetailReq {
		UserID    string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		PackageID string `json:"packageId"`
	}

GetEmojiPackageEmojiItem {
		EmojiID   string               `json:"emojiId"`
		FileKey   string               `json:"fileKey"`
		Title     string               `json:"title"`
		EmojiInfo *GetEmojiPackageInfo `json:"emojiInfo"`
		PackageID *string              `json:"packageId"`
	}

GetEmojiPackageDetailRes {
		PackageID    string                     `json:"packageId"`
		Title        string                     `json:"title"`
		CoverFile    string                     `json:"coverFile"`
		Description  string                     `json:"description"`
		Type         string                     `json:"type"` // 类型：official-官方，user-用户自定义
		CollectCount int                        `json:"collectCount"`
		EmojiCount   int                        `json:"emojiCount"`
		IsCollected  bool                       `json:"isCollected"`
		IsAuthor     bool                       `json:"isAuthor"` // 当前用户是否是作者
		Emojis       []GetEmojiPackageEmojiItem `json:"emojis"`
	}
)

type (
UpdateFavoriteEmojiPackageReq {
		UserID    string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		PackageID string `json:"packageId"`
		Type      string `json:"type"` // "favorite" or "unfavorite"
	}

UpdateFavoriteEmojiPackageRes  {}
)

type (
GetUserFavoritePackagesReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Page   int    `json:"page"`
		Size   int    `json:"size"`
	}

GetUserFavoritePackagesRes {
		Count int64              `json:"count"`
		List  []EmojiPackageItem `json:"list"`
	}
)

type (
GetEmojisByIdsReq {
		UserID string   `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		IDs    []string `json:"ids"` // 表情ID列表
	}

GetEmojisByIdsRes {
		Emojis []EmojiDetailItem `json:"emojis"`
	}

EmojiDetailItem {
		EmojiID   string            `json:"emojiId"`
		FileKey   string            `json:"fileKey"`
		Title     string            `json:"title"`
		EmojiInfo GetEmojiByIdsInfo `json:"emojiInfo"`
		PackageID *string           `json:"packageId"`
		Status    int8              `json:"status"`
		Version   int64             `json:"version"`
		CreatedAt int64             `json:"createdAt"`
		UpdatedAt int64             `json:"updatedAt"`
	}
)

type (
GetEmojisByUuidsReq {
		UserID string   `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		IDs    []string `json:"ids"` // 表情ID列表
	}

EmojiSimpleItem {
		EmojiID   string              `json:"emojiId"`
		FileKey   string              `json:"fileKey"`
		Title     string              `json:"title"`
		Version   int64               `json:"version"`
		Status    int8                `json:"status"`
		EmojiInfo GetEmojiByUuidsInfo `json:"emojiInfo"`
	}

GetEmojisByUuidsRes {
		Emojis []EmojiSimpleItem `json:"emojis"`
	}
)

type (
GetEmojiPackagesByIdsReq {
		UserID string   `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		IDs    []string `json:"ids"` // 表情包ID列表
	}

GetEmojiPackagesByIdsRes {
		Packages []EmojiPackageDetailItem `json:"packages"`
	}

EmojiPackageDetailItem {
		PackageID    string `json:"packageId"`
		Title        string `json:"title"`
		CoverFile    string `json:"coverFile"`
		UserID       string `json:"userId"`
		Description  string `json:"description"`
		Type         string `json:"type"`
		Status       int8   `json:"status"`
		CollectCount int    `json:"collectCount"`
		CreatedAt    int64  `json:"createdAt"`
		UpdatedAt    int64  `json:"updatedAt"`
		Version      int64  `json:"version"`
	}
)

type (
GetEmojiCollectsByIdsReq {
		UserID string   `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		IDs    []string `json:"ids"` // 收藏记录ID列表
	}

GetEmojiCollectsByIdsRes {
		Collects []EmojiCollectDetailItem `json:"collects"`
	}

EmojiCollectDetailItem {
		EmojiCollectID string  `json:"emojiCollectId"`
		UserID         string  `json:"userId"`
		EmojiID        string  `json:"emojiId"`
		FileKey        string  `json:"fileKey"`
		Title          string  `json:"title"`
		PackageID      *string `json:"packageId"`
		IsDeleted      bool    `json:"isDeleted"`
		Version        int64   `json:"version"`
		CreatedAt      int64   `json:"createdAt"`
		UpdatedAt      int64   `json:"updatedAt"`
	}
)

type (
GetEmojiPackageCollectsByIdsReq {
		UserID string   `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		IDs    []string `json:"ids"` // 收藏记录ID列表
	}

GetEmojiPackageCollectsByIdsRes {
		Collects []EmojiPackageCollectDetailItem `json:"collects"`
	}

EmojiPackageCollectDetailItem {
		PackageCollectID string `json:"packageCollectId"`
		UserID           string `json:"userId"`
		PackageID        string `json:"packageId"`
		IsDeleted        bool   `json:"isDeleted"`
		Version          int64  `json:"version"`
		CreatedAt        int64  `json:"createdAt"`
		UpdatedAt        int64  `json:"updatedAt"`
	}
)

type (
GetEmojiPackageContentsByPackageIdsReq {
		UserID     string   `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		PackageIDs []string `json:"packageIds"` // 表情包ID列表
	}

GetEmojiPackageContentsByPackageIdsRes {
		Contents []EmojiPackageContentDetailItem `json:"contents"`
	}
)

type (
GetEmojiPackageContentsByRelationIdsReq {
		UserID      string   `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		RelationIDs []string `json:"relationIds"` // 关联ID列表
	}

GetEmojiPackageContentsByRelationIdsRes {
		Contents []EmojiPackageContentDetailItem `json:"contents"`
	}
)













type (
GetEmojiPackagesSimpleItem {
		EmojiID   string               `json:"emojiId"`
		FileKey   string               `json:"fileKey"`
		Title     string               `json:"title"`
		Version   int64                `json:"version"`
		Status    int8                 `json:"status"`
		EmojiInfo GetEmojiPackagesInfo `json:"emojiInfo"`
	}

EmojiPackageItem {
		PackageID    string                       `json:"packageId"`
		Title        string                       `json:"title"`
		CoverFile    string                       `json:"coverFile"`
		Description  string                       `json:"description"`
		Type         string                       `json:"type"` // 类型：official-官方，user-用户自定义
		CollectCount int                          `json:"collectCount"`
		EmojiCount   int                          `json:"emojiCount"`
		IsCollected  bool                         `json:"isCollected"` // 当前用户是否已收藏
		IsAuthor     bool                         `json:"isAuthor"` // 当前用户是否是作者
		RecentEmojis []GetEmojiPackagesSimpleItem `json:"recentEmojis"` // 最近6个表情
	}

EmojiPackageContentDetailItem {
		RelationID string `json:"relationId"`
		PackageID  string `json:"packageId"`
		EmojiID    string `json:"emojiId"`
		SortOrder  int    `json:"sortOrder"`
		Version    int64  `json:"version"`
		CreatedAt  int64  `json:"createdAt"`
		UpdatedAt  int64  `json:"updatedAt"`
	}
)

type (
AddEmojiInfo {
		Width  int `json:"width"`
		Height int `json:"height"`
	}

GetEmojiInfo {
		Width  int `json:"width"`
		Height int `json:"height"`
	}

GetEmojiPackagesInfo {
		Width  int `json:"width"`
		Height int `json:"height"`
	}

GetEmojiPackageInfo {
		Width  int `json:"width"`
		Height int `json:"height"`
	}

GetEmojiByIdsInfo {
		Width  int `json:"width"`
		Height int `json:"height"`
	}

GetEmojiByUuidsInfo {
		Width  int `json:"width"`
		Height int `json:"height"`
	}

GetEmojiCollectsByUuidsReq {
		IDs []string `json:"ids"` // 收藏记录ID列表
	}

GetEmojiCollectsByUuidsRes {
		Collects []EmojiCollectDetailItem `json:"collects"`
	}

MachineEmojiInfo {
		Width  int32 `json:"width,optional"` // 宽
		Height int32 `json:"height,optional"` // 高
	}
)

type (
MachineEmojiItem {
		EmojiID   string            `json:"emojiId,optional"` // 表情ID
		FileKey   string            `json:"fileKey,optional"` // 文件Key
		Title     string            `json:"title,optional"` // 表情名称
		EmojiInfo *MachineEmojiInfo `json:"emojiInfo,optional"` // 尺寸信息
		Status    int32             `json:"status,optional"` // 状态：1=正常 2=审核中 3=违规禁用
		CreatedAt string            `json:"createdAt,optional"` // 创建时间
		UpdatedAt string            `json:"updatedAt,optional"` // 更新时间
	}

ListEmojisReq {
		Page      int32  `json:"page,optional"` // 页码
		PageSize  int32  `json:"pageSize,optional"` // 每页条数
		Title     string `json:"title,optional"` // 表情名称筛选
		StartTime string `json:"startTime,optional"` // 开始时间
		EndTime   string `json:"endTime,optional"` // 结束时间
		EmojiID   string `json:"emojiId,optional"` // 表情ID精确查
		PackageID string `json:"packageId,optional"` // 表情包ID筛选
	}

ListEmojisRes {
		Total int64              `json:"total,optional"` // 总数
		List  []MachineEmojiItem `json:"list,optional"` // 表情列表
	}
)

type (
MachineEmojiPackageItem {
		PackageID   string `json:"packageId,optional"` // 表情包ID
		Title       string `json:"title,optional"` // 名称
		CoverFile   string `json:"coverFile,optional"` // 封面文件Key
		UserID      string `json:"userId,optional"` // 所属用户ID
		Description string `json:"description,optional"` // 描述
		Type        string `json:"type,optional"` // 类型：official / user
		Status      int32  `json:"status,optional"` // 状态
		CreatedAt   string `json:"createdAt,optional"` // 创建时间
		UpdatedAt   string `json:"updatedAt,optional"` // 更新时间
	}

ListEmojiPackagesReq {
		Page      int32  `json:"page,optional"` // 页码
		PageSize  int32  `json:"pageSize,optional"` // 每页条数
		UserID    string `json:"userId,optional"` // 所属用户筛选
		Type      string `json:"type,optional"` // 类型筛选
		Status    int32  `json:"status,optional"` // 状态筛选
		Title     string `json:"title,optional"` // 名称筛选
		StartTime string `json:"startTime,optional"` // 开始时间
		EndTime   string `json:"endTime,optional"` // 结束时间
		PackageID string `json:"packageId,optional"` // 表情包ID精确查
	}

ListEmojiPackagesRes {
		Total int64                     `json:"total,optional"` // 总数
		List  []MachineEmojiPackageItem `json:"list,optional"` // 表情包列表
	}
)

type (
EmojiCollectItem {
		CollectID    string `json:"collectId,optional"` // 收藏记录ID
		UserID       string `json:"userId,optional"` // 用户ID
		EmojiID      string `json:"emojiId,optional"` // 表情ID
		EmojiTitle   string `json:"emojiTitle,optional"` // 表情名称
		EmojiFileKey string `json:"emojiFileKey,optional"` // 表情文件Key
		CreatedAt    string `json:"createdAt,optional"` // 创建时间
		UpdatedAt    string `json:"updatedAt,optional"` // 更新时间
	}

ListEmojiCollectsReq {
		Page      int32  `json:"page,optional"` // 页码
		PageSize  int32  `json:"pageSize,optional"` // 每页条数
		UserID    string `json:"userId,optional"` // 用户ID筛选
		EmojiID   string `json:"emojiId,optional"` // 表情ID筛选
		StartTime string `json:"startTime,optional"` // 开始时间
		EndTime   string `json:"endTime,optional"` // 结束时间
	}

ListEmojiCollectsRes {
		Total int64              `json:"total,optional"` // 总数
		List  []EmojiCollectItem `json:"list,optional"` // 收藏列表
	}
)

type (
SaveEmojiReq {
		EmojiID      string            `json:"emojiId,optional"` // 表情ID，空表示新建
		FileKey      string            `json:"fileKey,optional"` // 文件Key
		Title        string            `json:"title,optional"` // 表情名称
		EmojiInfo    *MachineEmojiInfo `json:"emojiInfo,optional"` // 尺寸信息
		PatchFileKey *string           `json:"patchFileKey,optional"` // 增量改文件Key
		PatchTitle   *string           `json:"patchTitle,optional"` // 增量改名称
		Delete       *bool             `json:"delete,optional"` // 删除标记
	}

SaveEmojiRes {
		EmojiID string `json:"emojiId,optional"` // 表情ID
	}
)

type (
SaveEmojiPackageReq {
		PackageID        string  `json:"packageId,optional"` // 表情包ID，空表示新建
		Title            string  `json:"title,optional"` // 名称
		CoverFile        string  `json:"coverFile,optional"` // 封面文件Key
		UserID           string  `json:"userId,optional"` // 所属用户ID
		Description      string  `json:"description,optional"` // 描述
		Type             string  `json:"type,optional"` // 类型
		PatchTitle       *string `json:"patchTitle,optional"` // 增量改名称
		PatchCoverFile   *string `json:"patchCoverFile,optional"` // 增量改封面
		PatchDescription *string `json:"patchDescription,optional"` // 增量改描述
		PatchType        *string `json:"patchType,optional"` // 增量改类型
		PatchStatus      *int32  `json:"patchStatus,optional"` // 增量改状态
		Delete           *bool   `json:"delete,optional"` // 删除标记
	}

SaveEmojiPackageRes {
		PackageID string `json:"packageId,optional"` // 表情包ID
	}
)

type (
UpdateEmojiPackageContentReq {
		PackageID string            `json:"packageId,optional"` // 表情包ID
		Action    int32             `json:"action,optional"` // 操作类型
		EmojiID   string            `json:"emojiId,optional"` // 表情ID
		FileKey   string            `json:"fileKey,optional"` // 文件Key
		Title     string            `json:"title,optional"` // 表情名称
		EmojiInfo *MachineEmojiInfo `json:"emojiInfo,optional"` // 尺寸信息
	}

UpdateEmojiPackageContentRes {
		RelationID string `json:"relationId,optional"` // 关联记录ID
		EmojiID    string `json:"emojiId,optional"` // 表情ID
	}
)

@server (
	group:      emoji
	middleware: JwtS2s
)
service asset {
	@doc "添加表情，并且自动收藏"
	@handler AddEmoji
	post /beaver/api/asset/emoji/v1/add (AddEmojiReq) returns (AddEmojiRes)

	@doc "收藏或者取消收藏表情"
	@handler UpdateFavoriteEmoji
	post /beaver/api/asset/emoji/v1/favorite_emoji (UpdateFavoriteEmojiReq) returns (UpdateFavoriteEmojiRes)

	@doc "获取用户收藏的表情列表"
	@handler GetEmojisList
	post /beaver/api/asset/emoji/v1/favorite_list (GetEmojisListReq) returns (GetEmojisListRes)

	@doc "获取表情包列表"
	@handler GetEmojiPackages
	post /beaver/api/asset/emoji/v1/package_list (GetEmojiPackagesReq) returns (GetEmojiPackagesRes)

	@doc "获取表情包详情"
	@handler GetEmojiPackageDetail
	post /beaver/api/asset/emoji/v1/package_info (GetEmojiPackageDetailReq) returns (GetEmojiPackageDetailRes)

	@doc "收藏或取消收藏表情包"
	@handler UpdateFavoriteEmojiPackage
	post /beaver/api/asset/emoji/v1/package_favorite (UpdateFavoriteEmojiPackageReq) returns (UpdateFavoriteEmojiPackageRes)

	@doc "获取用户收藏的表情包列表"
	@handler GetUserFavoritePackages
	post /beaver/api/asset/emoji/v1/favorite_package_list (GetUserFavoritePackagesReq) returns (GetUserFavoritePackagesRes)

	@doc "批量获取表情详情（数据库同步）"
	@handler GetEmojisByIds
	post /beaver/api/asset/emoji/v1/emojis_by_ids (GetEmojisByIdsReq) returns (GetEmojisByIdsRes)

	@doc "按ID批量查询表情基础信息（数据库同步）"
	@handler GetEmojisByUuids
	post /beaver/api/asset/emoji/v1/get_emojis_by_uuids (GetEmojisByUuidsReq) returns (GetEmojisByUuidsRes)

	@doc "批量获取表情包详情（数据库同步）"
	@handler GetEmojiPackagesByIds
	post /beaver/api/asset/emoji/v1/packages_by_ids (GetEmojiPackagesByIdsReq) returns (GetEmojiPackagesByIdsRes)

	@doc "批量获取用户收藏的表情记录详情（数据库同步）"
	@handler GetEmojiCollectsByIds
	post /beaver/api/asset/emoji/v1/collects_by_ids (GetEmojiCollectsByIdsReq) returns (GetEmojiCollectsByIdsRes)

	@doc "批量获取用户收藏的表情包记录详情（数据库同步）"
	@handler GetEmojiPackageCollectsByIds
	post /beaver/api/asset/emoji/v1/package_collects_by_ids (GetEmojiPackageCollectsByIdsReq) returns (GetEmojiPackageCollectsByIdsRes)

	@doc "批量获取表情包内容详情（数据库同步）"
	@handler GetEmojiPackageContentsByPackageIds
	post /beaver/api/asset/emoji/v1/package_contents_by_package_ids (GetEmojiPackageContentsByPackageIdsReq) returns (GetEmojiPackageContentsByPackageIdsRes)

	@doc "批量获取表情包内容详情（通过relationIds，数据库同步）"
	@handler GetEmojiPackageContentsByRelationIds
	post /beaver/api/asset/emoji/v1/package_contents_by_relation_ids (GetEmojiPackageContentsByRelationIdsReq) returns (GetEmojiPackageContentsByRelationIdsRes)

@doc "队间：分页查询表情"
	@handler EmojiList
	post /beaver/api/asset/emoji_s2s/v1/list_emojis (ListEmojisReq) returns (ListEmojisRes)

	@doc "队间：分页查询表情包"
	@handler EmojiPackageList
	post /beaver/api/asset/emoji_s2s/v1/list_packages (ListEmojiPackagesReq) returns (ListEmojiPackagesRes)

	@doc "队间：分页查询用户收藏的表情"
	@handler EmojiCollectList
	post /beaver/api/asset/emoji_s2s/v1/list_collects (ListEmojiCollectsReq) returns (ListEmojiCollectsRes)

	@doc "队间：新建/增量更新表情"
	@handler EmojiSave
	post /beaver/api/asset/emoji_s2s/v1/save (SaveEmojiReq) returns (SaveEmojiRes)

	@doc "队间：新建/增量更新表情包"
	@handler EmojiPackageSave
	post /beaver/api/asset/emoji_s2s/v1/save_package (SaveEmojiPackageReq) returns (SaveEmojiPackageRes)

	@doc "队间：增删表情包内容"
	@handler EmojiPackageContentUpdate
	post /beaver/api/asset/emoji_s2s/v1/update_package_content (UpdateEmojiPackageContentReq) returns (UpdateEmojiPackageContentRes)






}
