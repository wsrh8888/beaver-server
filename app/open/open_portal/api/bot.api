syntax = "v1"

// ==================== 群通知机器人（一级开放能力）====================

type (
	CreateBotReq {
		Name        string `json:"name" validate:"required,min=2,max=50"`
		Description string `json:"description,optional" validate:"max=512"`
		Avatar      string `json:"avatar,optional"`
		GroupID     string `json:"groupId,optional"` // 创建后拉入该群（不落 Bot 表）
		Visibility  string `json:"visibility,optional" validate:"omitempty,oneof=private partial public"`
		UserID      string `header:"Beaver-User-Id"`
	}
	CreateBotRes {
		BotID      string `json:"botId"`
		WebhookURL string `json:"webhookUrl"`
		Token      string `json:"token"`
		Secret     string `json:"secret"`
	}
)

type (
	BotInfo {
		BotID       string   `json:"botId"`
		Name        string   `json:"name"`
		Avatar      string   `json:"avatar,optional"`
		Description string   `json:"description,optional"`
		Visibility  string   `json:"visibility"`
		WebhookURL  string   `json:"webhookUrl"`
		AdminIDs    []string `json:"adminIds,optional"`
		ViewerIDs   []string `json:"viewerIds,optional"`
		CreatedAt   int64    `json:"createdAt"`
	}
)

type (
	ListBotReq {
		Page     int    `form:"page,default=1"`
		PageSize int    `form:"pageSize,default=10"`
		UserID   string `header:"Beaver-User-Id"`
	}
	ListBotRes {
		Total int64     `json:"total"`
		List  []BotInfo `json:"list"`
	}
)

type (
	GetBotDetailReq {
		BotID  string `form:"botId"`
		UserID string `header:"Beaver-User-Id"`
	}
	GetBotDetailRes {
		Bot BotInfo `json:"bot"`
	}
)

type (
	UpdateBotReq {
		BotID      string `json:"botId"`
		Name       string `json:"name,optional"`
		Avatar     string `json:"avatar,optional"`
		Visibility string `json:"visibility,optional" validate:"omitempty,oneof=private partial public"`
		UserID     string `header:"Beaver-User-Id"`
	}
	UpdateBotRes {}
)

type (
	DeleteBotReq {
		BotID  string `json:"botId"`
		UserID string `header:"Beaver-User-Id"`
	}
	DeleteBotRes {}
)

type (
	ResetBotSecretReq {
		BotID  string `json:"botId"`
		UserID string `header:"Beaver-User-Id"`
	}
	ResetBotSecretRes {
		Secret string `json:"secret"`
	}
)

type (
	SetBotAdminsReq {
		BotID   string   `json:"botId"`
		UserIDs []string `json:"userIds"`
		UserID  string   `header:"Beaver-User-Id"`
	}
	SetBotAdminsRes {}
)

type (
	SetBotViewersReq {
		BotID   string   `json:"botId"`
		UserIDs []string `json:"userIds"`
		UserID  string   `header:"Beaver-User-Id"`
	}
	SetBotViewersRes {}
)

@server (
	group: bot
	middleware: DeveloperAuthMiddleware, RequireDeveloperMiddleware
)
service open {
	@doc "创建群通知机器人"
	@handler CreateBot
	post /api/open_portal/bot/v1/create (CreateBotReq) returns (CreateBotRes)

	@doc "机器人列表"
	@handler ListBot
	get /api/open_portal/bot/v1/list (ListBotReq) returns (ListBotRes)

	@doc "机器人详情"
	@handler GetBotDetail
	get /api/open_portal/bot/v1/detail (GetBotDetailReq) returns (GetBotDetailRes)

	@doc "更新机器人"
	@handler UpdateBot
	post /api/open_portal/bot/v1/update (UpdateBotReq) returns (UpdateBotRes)

	@doc "删除机器人"
	@handler DeleteBot
	post /api/open_portal/bot/v1/delete (DeleteBotReq) returns (DeleteBotRes)

	@doc "重置加签密钥"
	@handler ResetBotSecret
	post /api/open_portal/bot/v1/reset_secret (ResetBotSecretReq) returns (ResetBotSecretRes)

	@doc "设置机器人管理员"
	@handler SetBotAdmins
	post /api/open_portal/bot/v1/admins/set (SetBotAdminsReq) returns (SetBotAdminsRes)

	@doc "设置机器人可见用户（partial）"
	@handler SetBotViewers
	post /api/open_portal/bot/v1/viewers/set (SetBotViewersReq) returns (SetBotViewersRes)
}
