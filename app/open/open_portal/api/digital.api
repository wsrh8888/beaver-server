syntax = "v1"

// ==================== 数字伙伴（一级实体）====================

type (
	CreateDigitalReq {
		Name        string `json:"name" validate:"required,min=2,max=50"`
		Description string `json:"description,optional" validate:"max=512"`
		Avatar      string `json:"avatar,optional"`
		Runtime     string `json:"runtime" validate:"required,oneof=builtin external workflow"`
		Visibility  string `json:"visibility,optional" validate:"omitempty,oneof=private partial public"`
		UserID      string `header:"Beaver-User-Id"`
	}
	CreateDigitalRes {
		DigitalID string `json:"digitalId"`
		AppKey    string `json:"appKey,optional"`
		AppSecret string `json:"appSecret,optional"` // 仅 external 创建时返回一次
	}
)

type (
	DigitalInfo {
		DigitalID   string   `json:"digitalId"`
		Name        string   `json:"name"`
		Avatar      string   `json:"avatar,optional"`
		WorkID      string   `json:"workId,optional"` // 工号，空=未申请
		Description string   `json:"description"`
		Runtime     string   `json:"runtime"`
		Visibility  string   `json:"visibility"`
		Status      int      `json:"status"` // 1启用 0停用（OpenDigital.Status，建表默认 1；不是发布状态，服务端目前没有发布流程）
		AppKey      string   `json:"appKey,optional"`
		AppSecret   string   `json:"appSecret,optional"` // 掩码；external 才有
		AdminIDs    []string `json:"adminIds,optional"`
		ViewerIDs   []string `json:"viewerIds,optional"`
		// 编排配置里的引用数量，列表卡片直接展示，免去逐条拉配置
		ToolCount      int   `json:"toolCount"`
		KnowledgeCount int   `json:"knowledgeCount"`
		McpCount       int   `json:"mcpCount"`
		CreatedAt      int64 `json:"createdAt"`
		UpdatedAt      int64 `json:"updatedAt"`
	}
)

type (
	ListDigitalReq {
		Page     int    `form:"page,default=1"`
		PageSize int    `form:"pageSize,default=10"`
		UserID   string `header:"Beaver-User-Id"`
	}
	ListDigitalRes {
		Total int64         `json:"total"`
		List  []DigitalInfo `json:"list"`
	}
)

type (
	GetDigitalDetailReq {
		DigitalID string `form:"digitalId"`
		UserID    string `header:"Beaver-User-Id"`
	}
	GetDigitalDetailRes {
		Digital DigitalInfo `json:"digital"`
	}
)

type (
	UpdateDigitalReq {
		DigitalID   string `json:"digitalId"`
		Name        string `json:"name,optional"`
		Avatar      string `json:"avatar,optional"`
		WorkID      string `json:"workId,optional"`     // 自定义工号，非空时校验唯一
		ApplyWorkID bool   `json:"applyWorkId,optional"` // 申请平台分配一个工号（已有则忽略）
		Description string `json:"description,optional"`
		Visibility  string `json:"visibility,optional" validate:"omitempty,oneof=private partial public"`
		Runtime     string `json:"runtime,optional" validate:"omitempty,oneof=builtin external workflow"`
		UserID      string `header:"Beaver-User-Id"`
	}
	UpdateDigitalRes {
		// 切换到长链接接入且此前没有凭据时，这里返回一次性明文，前端需提示用户保存
		AppKey    string `json:"appKey,optional"`
		AppSecret string `json:"appSecret,optional"`
	}
)

type (
	DeleteDigitalReq {
		DigitalID string `json:"digitalId"`
		UserID    string `header:"Beaver-User-Id"`
	}
	DeleteDigitalRes {}
)

type (
	ResetDigitalSecretReq {
		DigitalID string `json:"digitalId"`
		UserID    string `header:"Beaver-User-Id"`
	}
	ResetDigitalSecretRes {
		AppSecret string `json:"appSecret"`
	}
)

type (
	SetDigitalAdminsReq {
		DigitalID string   `json:"digitalId"`
		UserIDs   []string `json:"userIds"`
		UserID    string   `header:"Beaver-User-Id"`
	}
	SetDigitalAdminsRes {}
)

type (
	SetDigitalViewersReq {
		DigitalID string   `json:"digitalId"`
		UserIDs   []string `json:"userIds"`
		UserID    string   `header:"Beaver-User-Id"`
	}
	SetDigitalViewersRes {}
)

// ==================== 数字伙伴编排配置 ====================

type (
	GetDigitalConfigReq {
		DigitalID string `form:"digitalId"`
		UserID    string `header:"Beaver-User-Id"`
	}
	GetDigitalConfigRes {
		DigitalID      string `json:"digitalId"`
		Runtime        string `json:"runtime"`                       // builtin|external|workflow
		BuiltinConfig  string `json:"builtinConfig,optional"`  // BuiltinConfig JSON（Runtime=builtin 时非空）
		ExternalConfig string `json:"externalConfig,optional"` // ExternalConfig JSON（Runtime=external 时非空）
		WorkflowConfig string `json:"workflowConfig,optional"` // WorkflowConfig JSON（Runtime=workflow 时非空）
	}
)

type (
	SaveDigitalConfigReq {
		DigitalID      string `json:"digitalId"`
		BuiltinConfig  string `json:"builtinConfig,optional"`  // BuiltinConfig JSON（Runtime=builtin 时传）
		ExternalConfig string `json:"externalConfig,optional"` // ExternalConfig JSON（Runtime=external 时传）
		WorkflowConfig string `json:"workflowConfig,optional"` // WorkflowConfig JSON（Runtime=workflow 时传）
		UserID         string `header:"Beaver-User-Id"`
	}
	SaveDigitalConfigRes {}
)

// ==================== 平台知识库（本体） ====================
// 知识库是平台级资源（platform 域的集合 / 文档 / 索引），归开发者所有，
// 集合本身由 platform_rpc 维护，这里只做控制台侧的门面与归属校验。
// digitalId 是可选上下文：传入时代表「智能体知识源」场景，会计算/校验引用关系；
// 平台「知识库」板块不传，只按开发者身份操作平台集合，不触碰任何智能体引用。
// 注意：知识源不是知识库，知识源是下面那组独立接口里的一等实体。

type (
	DigitalKnowledgeItem {
		CollectionID  string `json:"collectionId"`
		Name          string `json:"name"`
		Description   string `json:"description"`
		Kind          string `json:"kind"`
		Status        int    `json:"status"`        // 1启用 2停用
		TopK          int    `json:"topK"`          // 检索条数（indexConfig.top_k，0 = 平台默认）
		DocumentCount int64  `json:"documentCount"` // 文档数
		Bound         bool   `json:"bound"`         // 是否已绑定本数字伙伴
		IndexConfig   string `json:"indexConfig,optional"` // 原始 indexConfig JSON，设置页回显分段/检索参数
	}
	ListDigitalKnowledgeReq {
		DigitalID string `form:"digitalId,optional"`
		UserID    string `header:"Beaver-User-Id"`
	}
	ListDigitalKnowledgeRes {
		List  []DigitalKnowledgeItem `json:"list"`
		Total int64                  `json:"total"`
	}
)

type (
	SaveDigitalKnowledgeReq {
		DigitalID    string `json:"digitalId,optional"`
		CollectionID string `json:"collectionId,optional"` // 空=新建
		Name         string `json:"name,optional"`         // 空=不改
		Description  string `json:"description,optional"`
		TopK         int    `json:"topK,optional"`        // 0=不改
		IndexConfig  string `json:"indexConfig,optional"` // JSON，分段/清洗配置，空=不改
		UserID       string `header:"Beaver-User-Id"`
	}
	SaveDigitalKnowledgeRes {
		CollectionID string `json:"collectionId"`
	}
)

type (
	DeleteDigitalKnowledgeReq {
		DigitalID    string `json:"digitalId,optional"`
		CollectionID string `json:"collectionId"`
		UserID       string `header:"Beaver-User-Id"`
	}
	DeleteDigitalKnowledgeRes {}
)

type (
	DigitalKnowledgeDoc {
		DocumentID  string `json:"documentId"`
		Title       string `json:"title"`
		DocType     string `json:"docType"`
		ByteSize    int64  `json:"byteSize"`
		IndexStatus string `json:"indexStatus"` // pending|indexing|ready|failed
		IndexError  string `json:"indexError,optional"`
		IndexedAt   int64  `json:"indexedAt"`
	}
	ListDigitalKnowledgeDocReq {
		DigitalID    string `form:"digitalId,optional"`
		CollectionID string `form:"collectionId"`
		Keyword      string `form:"keyword,optional"`
		UserID       string `header:"Beaver-User-Id"`
	}
	ListDigitalKnowledgeDocRes {
		List  []DigitalKnowledgeDoc `json:"list"`
		Total int64                 `json:"total"`
	}
)

type (
	SaveDigitalKnowledgeDocReq {
		DigitalID    string `json:"digitalId,optional"`
		CollectionID string `json:"collectionId,optional"` // 新建时必填
		DocumentID   string `json:"documentId,optional"`   // 空=新建
		Title        string `json:"title"`
		ContentText  string `json:"contentText,optional"`
		Reindex      bool   `json:"reindex,optional"` // 更新正文后是否重建索引
		UserID       string `header:"Beaver-User-Id"`
	}
	SaveDigitalKnowledgeDocRes {
		DocumentID string `json:"documentId"`
	}
)

type (
	DeleteDigitalKnowledgeDocReq {
		DigitalID  string `json:"digitalId,optional"`
		DocumentID string `json:"documentId"`
		UserID     string `header:"Beaver-User-Id"`
	}
	DeleteDigitalKnowledgeDocRes {}
)

type (
	RetrieveDigitalKnowledgeReq {
		DigitalID    string `json:"digitalId,optional"`
		CollectionID string `json:"collectionId"`
		Query        string `json:"query"`
		TopK         int    `json:"topK,optional"`
		UserID       string `header:"Beaver-User-Id"`
	}
	DigitalKnowledgeHit {
		DocumentID string  `json:"documentId"`
		Title      string  `json:"title"`
		ChunkIndex int     `json:"chunkIndex"`
		Content    string  `json:"content"`
		Score      float64 `json:"score"`
	}
	RetrieveDigitalKnowledgeRes {
		Hits   []DigitalKnowledgeHit `json:"hits"`
		Notice string                `json:"notice,optional"` // 无结果原因，有命中时为空
	}
)

// ==================== 知识源（后端一等实体） ====================
// 知识源归某个数字伙伴所有，落在 open 库 open_knowledge_source 表；
// 知识库是 platform 域的集合 / 文档 / 索引本体，二者不是同一层实体。
// 一个知识源可以引入 N 个知识库（只存 collectionId 引用，不复制内容），
// 同一个知识库也可以被不同知识源引入。
// 运行时仍只认 builtinConfig.knowledgeIds：知识源增删改后由后端把所有
// knowledgeIds 合并去重回写，agent 侧不用感知分组。
// 下面的接口全部要求 digitalId 且校验归属，不允许跨智能体读写知识源。

type (
	DigitalKnowledgeSourceItem {
		KnowledgeSourceID string   `json:"knowledgeSourceId"`
		Name              string   `json:"name"`
		RetrievalTopK     int      `json:"retrievalTopK"`
		IndexConfig       string   `json:"indexConfig,optional"` // 分段 / 清洗配置 JSON
		KnowledgeIDs      []string `json:"knowledgeIds"`         // 引入的平台知识库 ID
		DocumentCount     int64    `json:"documentCount"`        // 引入的所有知识库的文档总数
		CreatedAt         int64    `json:"createdAt"`
	}
	ListDigitalKnowledgeSourceReq {
		DigitalID string `form:"digitalId"`
		UserID    string `header:"Beaver-User-Id"`
	}
	ListDigitalKnowledgeSourceRes {
		List  []DigitalKnowledgeSourceItem `json:"list"`
		Total int64                        `json:"total"`
	}
)

type (
	SaveDigitalKnowledgeSourceReq {
		DigitalID         string `json:"digitalId"`
		KnowledgeSourceID string `json:"knowledgeSourceId,optional"` // 空 = 新建
		Name              string `json:"name,optional"`              // 空 = 不改
		RetrievalTopK     int    `json:"retrievalTopK,optional"`     // 0 = 不改
		IndexConfig       string `json:"indexConfig,optional"`       // JSON，空 = 不改
		UserID            string `header:"Beaver-User-Id"`
	}
	SaveDigitalKnowledgeSourceRes {
		KnowledgeSourceID string `json:"knowledgeSourceId"`
	}
)

type (
	DeleteDigitalKnowledgeSourceReq {
		DigitalID         string `json:"digitalId"`
		KnowledgeSourceID string `json:"knowledgeSourceId"`
		UserID            string `header:"Beaver-User-Id"`
	}
	DeleteDigitalKnowledgeSourceRes {}
)

type (
	BindDigitalKnowledgeSourceReq {
		DigitalID         string   `json:"digitalId"`
		KnowledgeSourceID string   `json:"knowledgeSourceId"`
		KnowledgeIDs      []string `json:"knowledgeIds"` // 要引入的平台知识库 ID，可多选
		UserID            string   `header:"Beaver-User-Id"`
	}
	BindDigitalKnowledgeSourceRes {
		KnowledgeIDs []string `json:"knowledgeIds"` // 变更后该知识源的完整引用列表
	}
)

type (
	UnbindDigitalKnowledgeSourceReq {
		DigitalID         string `json:"digitalId"`
		KnowledgeSourceID string `json:"knowledgeSourceId"`
		CollectionID      string `json:"collectionId"`
		UserID            string `header:"Beaver-User-Id"`
	}
	UnbindDigitalKnowledgeSourceRes {
		KnowledgeIDs []string `json:"knowledgeIds"`
	}
)

type (
	DigitalKnowledgeSourceDoc {
		DocumentID     string `json:"documentId"`
		Title          string `json:"title"`
		DocType        string `json:"docType"`
		ByteSize       int64  `json:"byteSize"`
		IndexStatus    string `json:"indexStatus"` // pending|indexing|ready|failed
		IndexError     string `json:"indexError,optional"`
		IndexedAt      int64  `json:"indexedAt"`
		CollectionID   string `json:"collectionId"`
		CollectionName string `json:"collectionName"`
	}
	ListDigitalKnowledgeSourceDocReq {
		DigitalID         string `form:"digitalId"`
		KnowledgeSourceID string `form:"knowledgeSourceId"`
		Keyword           string `form:"keyword,optional"`
		UserID            string `header:"Beaver-User-Id"`
	}
	ListDigitalKnowledgeSourceDocRes {
		List  []DigitalKnowledgeSourceDoc `json:"list"`
		Total int64                       `json:"total"`
	}
)

type (
	RetrieveDigitalKnowledgeSourceReq {
		DigitalID         string `json:"digitalId"`
		KnowledgeSourceID string `json:"knowledgeSourceId"`
		Query             string `json:"query"`
		TopK              int    `json:"topK,optional"` // 0 = 用知识源自身的 retrievalTopK
		UserID            string `header:"Beaver-User-Id"`
	}
	DigitalKnowledgeSourceHit {
		DocumentID     string  `json:"documentId"`
		CollectionID   string  `json:"collectionId"`
		CollectionName string  `json:"collectionName"`
		Title          string  `json:"title"`
		ChunkIndex     int     `json:"chunkIndex"`
		Content        string  `json:"content"`
		Score          float64 `json:"score"`
	}
	RetrieveDigitalKnowledgeSourceRes {
		Hits   []DigitalKnowledgeSourceHit `json:"hits"`
		Notice string                     `json:"notice,optional"` // 无结果原因
	}
)

// ==================== 工具与 MCP 目录 ====================

type (
	DigitalToolItem {
		ToolID   string `json:"toolId"`
		Name     string `json:"name"`
		ToolType string `json:"toolType"` // builtin|mcp|api
		Source   string `json:"source"`   // official|custom
		Status   int    `json:"status"`
		Config   string `json:"config,optional"`
	}
	DigitalMcpItem {
		McpServerID string `json:"mcpServerId"`
		Name        string `json:"name"`
		ServerName  string `json:"serverName"`
		Transport   string `json:"transport"` // stdio|sse|websocket
		Source      string `json:"source"`
		Status      int    `json:"status"`
		Config      string `json:"config,optional"`
		Tools       string `json:"tools,optional"` // 工具清单 JSON
	}
	ListDigitalCatalogReq {
		UserID string `header:"Beaver-User-Id"`
	}
	ListDigitalCatalogRes {
		Tools      []DigitalToolItem `json:"tools"`
		McpServers []DigitalMcpItem  `json:"mcpServers"`
	}
)

type (
	SaveDigitalMcpReq {
		DigitalID   string `json:"digitalId"`
		McpServerID string `json:"mcpServerId,optional"` // 空=新建
		Name        string `json:"name,optional"`
		ServerName  string `json:"serverName,optional"`
		Transport   string `json:"transport,optional"` // stdio|sse|websocket
		Config      string `json:"config,optional"`    // 连接配置 JSON
		Tools       string `json:"tools,optional"`     // 能力清单 JSON
		UserID      string `header:"Beaver-User-Id"`
	}
	SaveDigitalMcpRes {
		McpServerID string `json:"mcpServerId"`
	}
	DeleteDigitalMcpReq {
		DigitalID   string `json:"digitalId"`
		McpServerID string `json:"mcpServerId"`
		UserID      string `header:"Beaver-User-Id"`
	}
	DeleteDigitalMcpRes {}
)

@server (
	group: digital
	middleware: DeveloperAuthMiddleware, RequireDeveloperMiddleware
)
service open {
	@doc "创建数字伙伴"
	@handler CreateDigital
	post /api/open_portal/digital/v1/create (CreateDigitalReq) returns (CreateDigitalRes)

	@doc "数字伙伴列表"
	@handler ListDigital
	get /api/open_portal/digital/v1/list (ListDigitalReq) returns (ListDigitalRes)

	@doc "数字伙伴详情"
	@handler GetDigitalDetail
	get /api/open_portal/digital/v1/detail (GetDigitalDetailReq) returns (GetDigitalDetailRes)

	@doc "更新数字伙伴"
	@handler UpdateDigital
	post /api/open_portal/digital/v1/update (UpdateDigitalReq) returns (UpdateDigitalRes)

	@doc "删除数字伙伴"
	@handler DeleteDigital
	post /api/open_portal/digital/v1/delete (DeleteDigitalReq) returns (DeleteDigitalRes)

	@doc "重置外接凭据密钥"
	@handler ResetDigitalSecret
	post /api/open_portal/digital/v1/reset_secret (ResetDigitalSecretReq) returns (ResetDigitalSecretRes)

	@doc "设置数字伙伴管理员"
	@handler SetDigitalAdmins
	post /api/open_portal/digital/v1/admins/set (SetDigitalAdminsReq) returns (SetDigitalAdminsRes)

	@doc "设置数字伙伴可见用户（partial）"
	@handler SetDigitalViewers
	post /api/open_portal/digital/v1/viewers/set (SetDigitalViewersReq) returns (SetDigitalViewersRes)

	@doc "获取数字伙伴编排配置"
	@handler GetDigitalConfig
	get /api/open_portal/digital/v1/config/get (GetDigitalConfigReq) returns (GetDigitalConfigRes)

	@doc "保存数字伙伴编排配置"
	@handler SaveDigitalConfig
	post /api/open_portal/digital/v1/config/save (SaveDigitalConfigReq) returns (SaveDigitalConfigRes)

	@doc "平台知识库列表（传 digitalId 时附带引用状态）"
	@handler ListDigitalKnowledge
	get /api/open_portal/digital/v1/knowledge/list (ListDigitalKnowledgeReq) returns (ListDigitalKnowledgeRes)

	@doc "新建/更新知识库"
	@handler SaveDigitalKnowledge
	post /api/open_portal/digital/v1/knowledge/save (SaveDigitalKnowledgeReq) returns (SaveDigitalKnowledgeRes)

	@doc "删除知识库"
	@handler DeleteDigitalKnowledge
	post /api/open_portal/digital/v1/knowledge/delete (DeleteDigitalKnowledgeReq) returns (DeleteDigitalKnowledgeRes)

	@doc "知识库文档列表"
	@handler ListDigitalKnowledgeDoc
	get /api/open_portal/digital/v1/knowledge/docs (ListDigitalKnowledgeDocReq) returns (ListDigitalKnowledgeDocRes)

	@doc "新增/更新知识文档"
	@handler SaveDigitalKnowledgeDoc
	post /api/open_portal/digital/v1/knowledge/doc/save (SaveDigitalKnowledgeDocReq) returns (SaveDigitalKnowledgeDocRes)

	@doc "删除知识文档"
	@handler DeleteDigitalKnowledgeDoc
	post /api/open_portal/digital/v1/knowledge/doc/delete (DeleteDigitalKnowledgeDocReq) returns (DeleteDigitalKnowledgeDocRes)

	@doc "知识库召回测试"
	@handler RetrieveDigitalKnowledge
	post /api/open_portal/digital/v1/knowledge/retrieve (RetrieveDigitalKnowledgeReq) returns (RetrieveDigitalKnowledgeRes)

	@doc "知识源列表（后端实体）"
	@handler ListDigitalKnowledgeSource
	get /api/open_portal/digital/v1/knowledge/source/list (ListDigitalKnowledgeSourceReq) returns (ListDigitalKnowledgeSourceRes)

	@doc "新建 / 更新知识源"
	@handler SaveDigitalKnowledgeSource
	post /api/open_portal/digital/v1/knowledge/source/save (SaveDigitalKnowledgeSourceReq) returns (SaveDigitalKnowledgeSourceRes)

	@doc "删除知识源"
	@handler DeleteDigitalKnowledgeSource
	post /api/open_portal/digital/v1/knowledge/source/delete (DeleteDigitalKnowledgeSourceReq) returns (DeleteDigitalKnowledgeSourceRes)

	@doc "知识源引入 N 个知识库"
	@handler BindDigitalKnowledgeSource
	post /api/open_portal/digital/v1/knowledge/source/bind (BindDigitalKnowledgeSourceReq) returns (BindDigitalKnowledgeSourceRes)

	@doc "知识源移除某个知识库引用"
	@handler UnbindDigitalKnowledgeSource
	post /api/open_portal/digital/v1/knowledge/source/unbind (UnbindDigitalKnowledgeSourceReq) returns (UnbindDigitalKnowledgeSourceRes)

	@doc "知识源引入的所有知识库里的文档"
	@handler ListDigitalKnowledgeSourceDoc
	get /api/open_portal/digital/v1/knowledge/source/docs (ListDigitalKnowledgeSourceDocReq) returns (ListDigitalKnowledgeSourceDocRes)

	@doc "知识源跨库召回测试"
	@handler RetrieveDigitalKnowledgeSource
	post /api/open_portal/digital/v1/knowledge/source/retrieve (RetrieveDigitalKnowledgeSourceReq) returns (RetrieveDigitalKnowledgeSourceRes)

	@doc "工具与 MCP 目录"
	@handler ListDigitalCatalog
	get /api/open_portal/digital/v1/tool/catalog (ListDigitalCatalogReq) returns (ListDigitalCatalogRes)

	@doc "新建/更新 MCP 服务"
	@handler SaveDigitalMcp
	post /api/open_portal/digital/v1/tool/mcp/save (SaveDigitalMcpReq) returns (SaveDigitalMcpRes)

	@doc "删除 MCP 服务"
	@handler DeleteDigitalMcp
	post /api/open_portal/digital/v1/tool/mcp/delete (DeleteDigitalMcpReq) returns (DeleteDigitalMcpRes)
}
