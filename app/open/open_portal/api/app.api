syntax = "v1"

// ==================== OAuth 应用管理（开发者门户，对应 OpenOAuth）====================

type (
	CreateAppReq {
		Name        string `json:"name" validate:"required,min=2,max=50"`
		Description string `json:"description,optional" validate:"max=200"`
		Icon        string `json:"icon,optional"`
		UserID      string `header:"Beaver-User-Id"`
	}
	CreateAppRes {
		OAuthID     string `json:"oauthId"`
		OAuthSecret string `json:"oauthSecret"`
	}
)

type (
	UpdateAppReq {
		OAuthID     string `json:"oauthId"`
		Name        string `json:"name,optional"`
		Description string `json:"description,optional"`
		Icon        string `json:"icon,optional"`
		UserID      string `header:"Beaver-User-Id"`
	}
	UpdateAppRes {}
)

type (
	DeleteAppReq {
		OAuthID string `json:"oauthId"`
		UserID  string `header:"Beaver-User-Id"`
	}
	DeleteAppRes {}
)

type (
	ResetAppSecretReq {
		OAuthID string `json:"oauthId"`
		UserID  string `header:"Beaver-User-Id"`
	}
	ResetAppSecretRes {
		OAuthSecret string `json:"oauthSecret"`
	}
)

type (
	GetAppDetailReq {
		OAuthID string `form:"oauthId"`
		UserID  string `header:"Beaver-User-Id"`
	}
	AppInfo {
		OAuthID     string `json:"oauthId"`
		Name        string `json:"name"`
		Description string `json:"description"`
		Icon        string `json:"icon,optional"`
		OAuthSecret string `json:"oauthSecret"`
		Status      int    `json:"status"` // 1启用 0禁用
		CreatedAt   int64  `json:"createdAt"`
	}
	GetAppDetailRes {
		App AppInfo `json:"app"`
	}
)

type (
	GetAppListReq {
		Page     int    `form:"page,default=1"`
		PageSize int    `form:"pageSize,default=10"`
		Status   int    `form:"status,optional"`
		UserID   string `header:"Beaver-User-Id"`
	}
	GetAppListRes {
		Total int64     `json:"total"`
		List  []AppInfo `json:"list"`
	}
)

type (
	GetAppScopesReq {
		OAuthID string `form:"oauthId"`
		UserID  string `header:"Beaver-User-Id"`
	}
	ScopeInfo {
		Scope       string `json:"scope"`
		Name        string `json:"name"`
		Description string `json:"description"`
		Enabled     bool   `json:"enabled"`
		Required    bool   `json:"required"`
	}
	GetAppScopesRes {
		Scopes []ScopeInfo `json:"scopes"`
	}
)

type (
	UpdateAppScopesReq {
		OAuthID string   `json:"oauthId"`
		Scopes  []string `json:"scopes"`
		UserID  string   `header:"Beaver-User-Id"`
	}
	UpdateAppScopesRes {}
)

@server (
	group: app
	middleware: DeveloperAuthMiddleware, RequireDeveloperMiddleware
)
service open {
	@doc "创建 OAuth 应用"
	@handler CreateApp
	post /api/open_portal/app/v1/create (CreateAppReq) returns (CreateAppRes)

	@doc "更新应用"
	@handler UpdateApp
	post /api/open_portal/app/v1/update (UpdateAppReq) returns (UpdateAppRes)

	@doc "删除应用"
	@handler DeleteApp
	post /api/open_portal/app/v1/delete (DeleteAppReq) returns (DeleteAppRes)

	@doc "重置应用密钥"
	@handler ResetAppSecret
	post /api/open_portal/app/v1/reset_secret (ResetAppSecretReq) returns (ResetAppSecretRes)

	@doc "获取应用详情"
	@handler GetAppDetail
	get /api/open_portal/app/v1/detail (GetAppDetailReq) returns (GetAppDetailRes)

	@doc "获取应用列表"
	@handler GetAppList
	get /api/open_portal/app/v1/list (GetAppListReq) returns (GetAppListRes)

	@doc "获取应用权限列表"
	@handler GetAppScopes
	get /api/open_portal/app/v1/scopes (GetAppScopesReq) returns (GetAppScopesRes)

	@doc "更新应用权限"
	@handler UpdateAppScopes
	post /api/open_portal/app/v1/scopes/update (UpdateAppScopesReq) returns (UpdateAppScopesRes)
}
