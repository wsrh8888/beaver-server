syntax = "v1"

// ==================== Digital 接口（外接数字伙伴） ====================
// Digital 通过**长连接**接收 IM 事件（连接端点由长连接服务提供），
// 通过此 API 把回复发回 IM。

type (
	// 获取 Digital 自身信息
	GetDigitalInfoReq {
	}

	GetDigitalInfoRes {
		DigitalID   string `json:"digitalId"` // string Digital 在 IM 中的用户 ID，用于 @ 提及
		DigitalName string `json:"digitalName"` // string Digital 昵称（取自用户资料）
		Avatar      string `json:"avatar,optional"` // string 头像 URL，可选（取自用户资料）
		AppID       string `json:"appId"` // string 所属应用 ID
	}
)

type (
	// Digital 发送消息
	DigitalSendMessageReq {
		ConversationID string `json:"conversationId"` // string 会话 ID，从长连接事件中获取
		MsgType        string `json:"msgType"` // string 消息类型：text / markdown
		Content        string `json:"content"` // string 消息内容
		ReplyMsgID     string `json:"replyMsgId,optional"` // string 引用回复的消息 ID，可选
	}

	DigitalSendMessageRes {
		MessageID string `json:"messageId"` // string 消息 ID
		SendTime  int64  `json:"sendTime"` // int64 发送时间 Unix 秒
	}
)

type (
	// 将 Digital 加入群
	AddDigitalToGroupReq {
		GroupID string `json:"groupId"` // string 群组 ID
	}

	AddDigitalToGroupRes {
		DigitalID string `json:"digitalId"` // string Digital 在群内的用户 ID
	}
)

type (
	// 将 Digital 从群移除
	RemoveDigitalFromGroupReq {
		GroupID string `json:"groupId"` // string 群组 ID
	}

	RemoveDigitalFromGroupRes {
		Success bool `json:"success"` // bool 是否成功
	}
)

@server (
	group: digital
)
service open {
	@doc "获取 Digital 自身信息"
	@handler GetDigitalInfo
	get /api/open/digital/v1/info (GetDigitalInfoReq) returns (GetDigitalInfoRes)

	@doc "Digital 发送消息到 IM 会话"
	@handler DigitalSendMessage
	post /api/open/digital/v1/send_message (DigitalSendMessageReq) returns (DigitalSendMessageRes)

	@doc "将 Digital 加入群"
	@handler AddDigitalToGroup
	post /api/open/digital/v1/add_to_group (AddDigitalToGroupReq) returns (AddDigitalToGroupRes)

	@doc "将 Digital 从群移除"
	@handler RemoveDigitalFromGroup
	post /api/open/digital/v1/remove_from_group (RemoveDigitalFromGroupReq) returns (RemoveDigitalFromGroupRes)
}
