syntax = "v1"

// ==================== Digital 接口（外接数字伙伴） ====================

type (
	GetDigitalInfoReq {
	}

	GetDigitalInfoRes {
		DigitalID   string `json:"digitalId"`
		DigitalName string `json:"digitalName"`
		Avatar      string `json:"avatar,optional"`
		AppKey      string `json:"appKey"`
	}
)

type (
	DigitalSendMessageReq {
		ConversationID string `json:"conversationId"`
		MsgType        string `json:"msgType"` // text / markdown
		Content        string `json:"content"`
		ReplyMsgID     string `json:"replyMsgId,optional"`
	}

	DigitalSendMessageRes {
		MessageID string `json:"messageId"`
		SendTime  int64  `json:"sendTime"`
	}
)

type (
	AddDigitalToGroupReq {
		GroupID string `json:"groupId"`
	}

	AddDigitalToGroupRes {
		DigitalID string `json:"digitalId"`
	}
)

type (
	RemoveDigitalFromGroupReq {
		GroupID string `json:"groupId"`
	}

	RemoveDigitalFromGroupRes {
		Success bool `json:"success"`
	}
)

@server (
	group: digital
)
service open {
	@doc "获取 Digital 自身信息"
	@handler GetDigitalInfo
	get /api/open/digital/v1/info (GetDigitalInfoReq) returns (GetDigitalInfoRes)

	@doc "Digital 发送消息到 IM 会话"
	@handler DigitalSendMessage
	post /api/open/digital/v1/send_message (DigitalSendMessageReq) returns (DigitalSendMessageRes)

	@doc "将 Digital 加入群"
	@handler AddDigitalToGroup
	post /api/open/digital/v1/add_to_group (AddDigitalToGroupReq) returns (AddDigitalToGroupRes)

	@doc "将 Digital 从群移除"
	@handler RemoveDigitalFromGroup
	post /api/open/digital/v1/remove_from_group (RemoveDigitalFromGroupReq) returns (RemoveDigitalFromGroupRes)
}
