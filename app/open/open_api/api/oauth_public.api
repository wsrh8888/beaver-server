syntax = "v1"

// ==================== OAuth 公开接口（无需认证）====================

type (
	GenerateQrCodeReq {
		OAuthID string `json:"oauthId"`
	}
	GenerateQrCodeRes {
		SceneID  string `json:"sceneId"`
		ExpireIn int64  `json:"expireIn"`
	}
)

type (
	CheckQrCodeStatusReq {
		SceneID string `form:"sceneId"`
	}
	CheckQrCodeStatusRes {
		Status string `json:"status"` // waiting / scanned / confirmed / cancelled / expired
		Code   string `json:"code,optional"`
	}
)

type (
	GetQrCodeSceneReq {
		SceneID string `form:"sceneId"`
	}
	GetQrCodeSceneRes {
		SceneID  string   `json:"sceneId"`
		OAuthID  string   `json:"oauthId"`
		AppName  string   `json:"appName"`
		AppIcon  string   `json:"appIcon"`
		Status   string   `json:"status"`
		ExpireIn int64    `json:"expireIn"`
		Scopes   []string `json:"scopes"`
	}
)

type (
	PasswordLoginReq {
		OAuthID  string `json:"oauthId"`
		Account  string `json:"account"`
		Password string `json:"password"`
	}
	PasswordLoginRes {
		Code     string `json:"code"`
		ExpireIn int64  `json:"expireIn"`
	}
)

@server (
	group: oauth_public
)
service open {
	@doc "生成扫码登录二维码"
	@handler GenerateQrCode
	post /api/open/oauth_public/v1/qrcode (GenerateQrCodeReq) returns (GenerateQrCodeRes)

	@doc "查询扫码状态（轮询）"
	@handler CheckQrCodeStatus
	get /api/open/oauth_public/v1/qrcode_status (CheckQrCodeStatusReq) returns (CheckQrCodeStatusRes)

	@doc "查询扫码会话信息"
	@handler GetQrCodeScene
	get /api/open/oauth_public/v1/qrcode_scene (GetQrCodeSceneReq) returns (GetQrCodeSceneRes)

	@doc "账号密码登录"
	@handler PasswordLogin
	post /api/open/oauth_public/v1/password_login (PasswordLoginReq) returns (PasswordLoginRes)
}
