syntax = "v1"

// ==================== 开放平台长连接（WebSocket）====================
//
// 外接数字伙伴通过此端点建立长连接，接收 IM 事件。
//
// 鉴权：URL query 携带 appKey + ticket
//   ticket = POST /api/open/auth_public/v1/token 换得的 accessToken
//   服务端据 appKey 加载 OpenDigital（runtime=external），连接代表该数字伙伴
//
// 回复统一走 OAPI POST /api/open/digital/v1/send_message，不走本连接。

type (
	OpenWsReq {
		AppKey string `form:"appKey"`
		Ticket string `form:"ticket"`
	}

	OpenWsRes {
	}
)

@server (
	group: ws
)
service open {
	@doc "建立长连接（WebSocket 升级）"
	@handler OpenWs
	get /api/open/ws/v1/connect (OpenWsReq) returns (OpenWsRes)
}
