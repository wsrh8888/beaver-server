syntax = "v1"

// 消息相关数据类型

// 发送消息

// 获取会话信息

// 获取最近会话列表

// 获取聊天记录

// 搜索消息

// 删除最近会话

// 置顶会话

// 设置会话免打扰

// 隐藏/显示会话

// 消息撤回

// 批量删除消息

// 标记消息媒体状态（语音已听等）

// 消息转发

// 获取合并转发详情

// 聊天数据同步

// 批量获取会话数据

// 批量获取用户会话设置数据

// 更新会话已读序列号

type (
SendMsgReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		ConversationID string `json:"conversationId"` //会话id
		MessageID      string `json:"messageId"` //客户端消息ID
		Msg            Msg    `json:"msg"`
	}

SendMsgRes {
		ID             uint   `json:"id"` //数据库自增ID
		MessageID      string `json:"messageId"` //客户端消息ID
		ConversationID string `json:"conversationId"` //会话id
		Msg            Msg    `json:"msg"`
		Sender         Sender `json:"sender"` //发送者
		CreatedAt      string `json:"createdAt"` //消息时间
		MsgPreview     string `json:"msgPreview"` //消息预览
		Seq            int64  `json:"seq"` //消息序列号，用于数据同步
	}
)

type (
ConversationInfoReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		ConversationID string `json:"conversationId"` //会话id
	}
)

type (
RecentChatListReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Page   int    `form:"page,optional"`
		Limit  int    `form:"limit,optional"`
	}

RecentChatListRes {
		Count int64                 `json:"count"`
		List  []ConversationInfoRes `json:"list"`
	}
)

type (
ChatHistoryReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		ConversationID string `json:"conversationId"` // 会话Id
		Page           int    `json:"page,optional"`
		Limit          int    `json:"limit,optional"`
	}

ChatHistoryRes {
		Count int64     `json:"count"`
		List  []Message `json:"list"`
	}
)

type (
SearchMessagesReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Keyword        string `json:"keyword"` // 搜索关键词
		ConversationID string `json:"conversationId,optional"` // 可选，限定在某个会话内搜索
		Page           int    `json:"page,optional"`
		Limit          int    `json:"limit,optional"`
	}

SearchMessagesRes {
		Count int64     `json:"count"`
		List  []Message `json:"list"`
	}
)

type (
DeleteRecentReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		ConversationID string `json:"conversationId"` //会话id
	}

DeleteRecentRes  {}
)

type (
PinnedChatReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		ConversationID string `json:"conversationId"` //会话id
		IsPinned       bool   `json:"isPinned"` // true表示置顶 false表示不置顶
	}

PinnedChatRes  {}
)

type (
MuteChatReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		ConversationID string `json:"conversationId"` //会话id
		IsMuted        bool   `json:"isMuted"` // true表示免打扰 false表示取消免打扰
	}

MuteChatRes  {}
)

type (
HideChatReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		ConversationID string `json:"conversationId"` //会话id
		IsHidden       bool   `json:"isHidden"` // true表示隐藏 false表示显示
	}

HideChatRes  {}
)

type (
RecallMessageReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		MessageID string `json:"messageId"` // 客户端消息ID
	}

RecallMessageRes {
		MessageID  string `json:"messageId"` // 客户端消息ID
		RecallTime string `json:"recallTime"` // 撤回时间
	}
)

type (
DeleteMessagesReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		MessageIDs []string `json:"messageIds"` // 支持批量删除，最多100条
	}

DeleteMessagesRes  {}
)

type (
MarkMessageMediaReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		MessageIDs []string `json:"messageIds"` // 消息ID列表，最多100条
	}

MarkMessageMediaRes  {}
)

type (
ForwardMessageReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		MessageIDs  []string `json:"messageIds"` // 原始消息ID列表
		TargetID    string   `json:"targetId"` // 目标会话ID
		ForwardType int      `json:"forwardType"` // 1: 单聊 2: 群聊
		ForwardMode int      `json:"forwardMode"` // 1: 逐条转发 2: 合并转发
	}

ForwardMessageRes {
		ForwardTime string `json:"forwardTime"`
	}
)

type (
ChatSyncReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		ConversationID string `json:"conversationId,optional"` // 会话ID，可选，不传则同步所有会话
		FromSeq        int64  `json:"fromSeq"` // 起始序列号
		ToSeq          int64  `json:"toSeq"` // 结束序列号
		Limit          int    `json:"limit,optional"` // 限制数量，默认100
	}

ChatSyncRes {
		Messages []ChatSyncMessage `json:"messages"` // 消息列表
		HasMore  bool              `json:"hasMore"` // 是否还有更多数据
		NextSeq  int64             `json:"nextSeq"` // 下次同步的起始序列号
	}

ChatSyncMessage {
		MessageID        string `json:"messageId"` //客户端消息ID
		ConversationID   string `json:"conversationId"` //会话id
		ConversationType int    `json:"conversationType"` //会话类型（1=私聊 2=群聊）
		SendUserID       string `json:"sendUserId"` //发送者用户ID
		MsgType          uint32 `json:"msgType"` //消息类型
		MsgPreview       string `json:"msgPreview"` //消息预览
		Msg              string `json:"msg"` //消息内容JSON字符串
		IsDeleted        bool   `json:"isDeleted"` //是否已删除
		Seq              int64  `json:"seq"` //序列号，用于数据同步
		CreatedAt        int64  `json:"createdAt"` //创建时间戳
	}
)

type (
GetConversationsListByIdsReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		ConversationIDs []string `json:"conversationIds"` // 会话ID列表
	}

GetConversationsListByIdsRes {
		Conversations []ConversationById `json:"conversations"` // 会话列表
	}

ConversationById {
		ConversationID string `json:"conversationId"` // 会话ID
		Type           int    `json:"type"` // 会话类型 1=私聊 2=群聊 3=系统会话
		MaxSeq         int64  `json:"maxSeq"` // 会话消息的最大Seq
		LastMessage    string `json:"lastMessage"` // 会话最后一条消息预览
		Version        int64  `json:"version"` // 版本号
		CreatedAt      int64  `json:"createdAt"` // 创建时间戳
		UpdatedAt      int64  `json:"updatedAt"` // 更新时间戳
	}
)

type (
GetUserConversationSettingsListByIdsReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		ConversationIDs []string `json:"conversationIds"` // 会话ID列表
	}

GetUserConversationSettingsListByIdsRes {
		UserConversationSettings []UserConversationSettingById `json:"userConversationSettings"` // 用户会话设置列表
	}

UserConversationSettingById {
		UserID         string `json:"userId"` // 用户ID
		ConversationID string `json:"conversationId"` // 会话ID
		IsHidden       bool   `json:"isHidden"` // 是否隐藏
		IsPinned       bool   `json:"isPinned"` // 是否置顶
		IsMuted        bool   `json:"isMuted"` // 是否免打扰
		UserReadSeq    int64  `json:"userReadSeq"` // 用户已读序列号
		Version        int64  `json:"version"` // 版本号
		CreatedAt      int64  `json:"createdAt"` // 创建时间戳
		UpdatedAt      int64  `json:"updatedAt"` // 更新时间戳
	}
)

type (
UpdateReadSeqReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		ConversationID string `json:"conversationId"` // 会话ID
		ReadSeq        int64  `json:"readSeq"` // 已读序列号（用户已读到的消息seq）
	}

UpdateReadSeqRes {
		Success bool `json:"success"` // 是否成功
	}
)

type (
GetForwardDetailsReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		RecordID string `form:"recordId"`
	}

GetForwardDetailsRes {
		List []Message `json:"list"` // 返回完整的消息快照列表
	}
)















type (
ConversationInfoRes {
		Avatar         string `json:"avatar"`
		NickName       string `json:"nickName"`
		MsgPreview     string `json:"msgPreview"` //消息预览
		UpdatedAt      string `json:"updatedAt"` //消息时间
		IsTop          bool   `json:"isTop"` //是否置顶
		ConversationID string `json:"conversationId"` //会话id
		ChatType       int    `json:"chatType"` //会话类型 1:好友 2:群聊 3:AI机器人
		Notice         string `json:"notice"` //备注
	}

Message {
		ID               uint   `json:"id"` //数据库自增ID
		MessageID        string `json:"messageId"` //客户端消息ID
		ConversationID   string `json:"conversationId"` //会话id
		ConversationType int    `json:"conversationType"` //会话类型（1=私聊 2=群聊）
		Msg              Msg    `json:"msg"`
		Sender           Sender `json:"sender"` //发送者
		CreatedAt        string `json:"createdAt"` //消息时间
		Seq              int64  `json:"seq"` //序列号，用于数据同步
	}
)

type (
TextMsg {
		Content string `json:"content"` //文本消息内容
	}

FileMsg {
		FileUrl   string `json:"fileUrl"` // 文件完整 URL
		FileName  string `json:"fileName,optional"` // 原始文件名
		Size      int64  `json:"size,optional"` // 文件大小（字节）
		MimeType  string `json:"mimeType,optional"` // MIME 类型
		Extension string `json:"extension,optional"` // 扩展名：docx、pptx、xlsx、pdf
		OpenMode  int    `json:"openMode,optional"` // 1=下载 2=预览 3=在线编辑
	}

CloudDocMsg {
		DocID    string `json:"docId"` // 文档唯一标识
		DocType  int    `json:"docType"` // 1=文档 2=表格 3=幻灯片 4=思维笔记
		Title    string `json:"title"` // 标题
		OwnerID  string `json:"ownerId,optional"` // 所有者用户ID
		Perm     int    `json:"perm,optional"` // 1=只读 2=可评论 3=可编辑
		CoverURL string `json:"coverUrl,optional"` // 封面图
		Revision int64  `json:"revision,optional"` // 版本号
	}

CardMsg {
		CardType    int    `json:"cardType"` // 1=个人 2=群 3=圈子
		ID          string `json:"id"` // 目标实体 ID
		ExpireAt    int64  `json:"expireAt,optional"` // 过期时间戳(秒)，0=不过期
		InviteToken string `json:"inviteToken,optional"` // 分享邀请凭证（群/圈）
	}

VideoMsg {
		FileUrl      string `json:"fileUrl"` // 视频完整 URL
		Width        int    `json:"width,optional"` //视频宽度（可选）
		Height       int    `json:"height,optional"` //视频高度（可选）
		Duration     int    `json:"duration,optional"` //视频时长（秒，可选）
		ThumbnailUrl string `json:"thumbnailUrl,optional"` // 视频封面完整 URL
		Size         int64  `json:"size,optional"` //文件大小（字节，可选）
	}

VoiceMsg {
		FileUrl  string `json:"fileUrl"` // 语音文件完整 URL
		Duration int    `json:"duration,optional"` //语音时长（秒，可选）
		Size     int64  `json:"size,optional"` //文件大小（字节，可选）
	}

ImageMsg {
		FileUrl string `json:"fileUrl"` // 图片完整 URL
		Width   int    `json:"width,optional"` //图片宽度（可选）
		Height  int    `json:"height,optional"` //图片高度（可选）
		Size    int64  `json:"size,optional"` //文件大小（字节，可选）
	}

NotificationMsg {
		Type   int      `json:"type"` // 通知类型：1=好友欢迎 2=创建群 3=加入群 4=退出群 5=踢出成员 6=转让群主 7=添加群机器人 8=移除群机器人
		Actors []string `json:"actors"` // 相关用户ID列表
	}

AudioFileMsg {
		FileUrl  string `json:"fileUrl"` // 音频文件完整 URL
		FileName string `json:"fileName,optional"` //原始文件名（可选，用于显示）
		Duration int    `json:"duration,optional"` //音频时长（秒，可选）
		Size     int64  `json:"size,optional"` //文件大小（字节，可选）
	}

EmojiMsg {
		FileUrl   string `json:"fileUrl"` // 表情图片完整 URL
		EmojiID   string `json:"emojiId"` // 表情ID（Emoji.Id，单个表情时使用）
		PackageID string `json:"packageId"` // 表情包ID（EmojiPackage.Id，表情包分享时使用）
	}

ReplyMsg {
		OriginMsgID string `json:"originMsgId"` // 被回复的消息ID
		OriginMsg   *Msg   `json:"originMsg,optional"` // 被回复的消息内容快照
		ReplyMsg    *Msg   `json:"replyMsg"` // 回复的消息主体 (可以是文本、图片等)
	}

WithdrawMsg {
		OriginMsgID string `json:"originMsgId"` // 被撤回的消息ID
		OriginMsg   *Msg   `json:"originMsg,optional"` // 原消息快照
	}

CallMsg {
		RoomID   string `json:"roomId"` // 房间ID
		CallType int    `json:"callType"` // 通话类型: 1-私聊, 2-群聊
		Status   int    `json:"status"` // 状态: 1-进行中, 2-已结束
		Duration int64  `json:"duration,optional"` // 通话时长(秒)
	}

ForwardMsg {
		Title    string `json:"title"` // 标题
		RecordID string `json:"recordId,optional"` // 详情记录ID
		Count    int    `json:"count"` // 消息总数
	}

Msg {
		Type            uint32           `json:"type"` // 消息类型 1:文本 2:图片 3:视频 4:文件 5:语音 6:表情 7:通知 8:音频 9:通话 10:撤回 11:回复 12:转发 13:markdown 14:链接 15:云文档 16:名片
		AtUserIDs       []string         `json:"atUserIds,optional"` // @的用户ID列表
		TextMsg         *TextMsg         `json:"textMsg,optional"` // 文本消息
		ImageMsg        *ImageMsg        `json:"imageMsg,optional"` // 图片
		VideoMsg        *VideoMsg        `json:"videoMsg,optional"` // 视频
		FileMsg         *FileMsg         `json:"fileMsg,optional"` // 文件附件（Office/PDF 等）
		VoiceMsg        *VoiceMsg        `json:"voiceMsg,optional"` // 语音
		EmojiMsg        *EmojiMsg        `json:"emojiMsg,optional"` // 表情
		NotificationMsg *NotificationMsg `json:"notificationMsg,optional"` // 通知消息
		AudioFileMsg    *AudioFileMsg    `json:"audioFileMsg,optional"` // 音频文件
		CallMsg         *CallMsg         `json:"callMsg,optional"` // 音视频通话
		WithdrawMsg     *WithdrawMsg     `json:"withdrawMsg,optional"` // 撤回消息
		ReplyMsg        *ReplyMsg        `json:"replyMsg,optional"` // 回复消息
		ForwardMsg      *ForwardMsg      `json:"forwardMsg,optional"` // 转发消息（集合）
		CloudDocMsg     *CloudDocMsg     `json:"cloudDocMsg,optional"` // 云文档分享卡片
		CardMsg         *CardMsg         `json:"cardMsg,optional"` // 通用名片（个人/群/圈子）
	}

Sender {
		UserID   string `json:"userId"`
		Avatar   string `json:"avatar"`
		NickName string `json:"nickName"`
		UserType int8   `json:"userType"` // 1普通用户 2bot 3digital
	}

PeerTextMsg {
		Content string `json:"content,optional"`
	}

PeerImageMsg {
		FileUrl string `json:"fileUrl,optional"`
		Width   int32  `json:"width,optional"`
		Height  int32  `json:"height,optional"`
		Size    int64  `json:"size,optional"`
	}

PeerVideoMsg {
		FileUrl      string `json:"fileUrl,optional"`
		Width        int32  `json:"width,optional"`
		Height       int32  `json:"height,optional"`
		Duration     int32  `json:"duration,optional"`
		ThumbnailUrl string `json:"thumbnailUrl,optional"`
		Size         int64  `json:"size,optional"`
	}

PeerFileMsg {
		FileUrl   string `json:"fileUrl,optional"`
		FileName  string `json:"fileName,optional"`
		Size      int64  `json:"size,optional"`
		MimeType  string `json:"mimeType,optional"`
		Extension string `json:"extension,optional"`
		OpenMode  int32  `json:"openMode,optional"`
	}

PeerVoiceMsg {
		FileUrl  string `json:"fileUrl,optional"`
		Duration int32  `json:"duration,optional"`
		Size     int64  `json:"size,optional"`
	}

PeerEmojiMsg {
		FileUrl   string `json:"fileUrl,optional"`
		EmojiID   string `json:"emojiId,optional"`
		PackageID string `json:"packageId,optional"`
		Width     int64  `json:"width,optional"`
		Height    int64  `json:"height,optional"`
	}

PeerNotificationMsg {
		Type   int32    `json:"type,optional"`
		Actors []string `json:"actors,optional"`
	}

PeerAudioFileMsg {
		FileUrl  string `json:"fileUrl,optional"`
		FileName string `json:"fileName,optional"`
		Duration int32  `json:"duration,optional"`
		Size     int64  `json:"size,optional"`
	}

PeerCallMsg {
		RoomID   string `json:"roomId,optional"`
		CallType int32  `json:"callType,optional"`
		Status   int32  `json:"status,optional"`
		Duration int64  `json:"duration,optional"`
	}

PeerForwardMsg {
		Title    string `json:"title,optional"`
		RecordID string `json:"recordId,optional"`
		Count    int32  `json:"count,optional"`
	}

PeerMarkdownMsg {
		Content string `json:"content,optional"`
		Title   string `json:"title,optional"`
	}

PeerLinkMsg {
		Url      string `json:"url,optional"`
		Title    string `json:"title,optional"`
		Desc     string `json:"desc,optional"`
		ImageUrl string `json:"imageUrl,optional"`
	}

PeerCloudDocMsg {
		DocID    string `json:"docId,optional"`
		DocType  int32  `json:"docType,optional"`
		Title    string `json:"title,optional"`
		OwnerID  string `json:"ownerId,optional"`
		Perm     int32  `json:"perm,optional"`
		CoverUrl string `json:"coverUrl,optional"`
		Revision int64  `json:"revision,optional"`
	}

PeerCardMsg {
		CardType    int32  `json:"cardType,optional"`
		ID          string `json:"id,optional"`
		ExpireAt    int64  `json:"expireAt,optional"`
		InviteToken string `json:"inviteToken,optional"`
	}

PeerMsg {
		Type            uint32            `json:"type,optional"`
		TargetMsgID     string            `json:"targetMsgId,optional"`
		TextMsg         *PeerTextMsg      `json:"textMsg,optional"`
		ImageMsg        *PeerImageMsg     `json:"imageMsg,optional"`
		VideoMsg        *PeerVideoMsg     `json:"videoMsg,optional"`
		FileMsg         *PeerFileMsg      `json:"fileMsg,optional"`
		VoiceMsg        *PeerVoiceMsg     `json:"voiceMsg,optional"`
		EmojiMsg        *PeerEmojiMsg     `json:"emojiMsg,optional"`
		NotificationMsg *PeerNotificationMsg `json:"notificationMsg,optional"`
		AudioFileMsg    *PeerAudioFileMsg `json:"audioFileMsg,optional"`
		CallMsg         *PeerCallMsg      `json:"callMsg,optional"`
		WithdrawMsg     *PeerWithdrawMsg  `json:"withdrawMsg,optional"`
		ReplyMsg        *PeerReplyMsg     `json:"replyMsg,optional"`
		ForwardMsg      *PeerForwardMsg   `json:"forwardMsg,optional"`
		MarkdownMsg     *PeerMarkdownMsg  `json:"markdownMsg,optional"`
		LinkMsg         *PeerLinkMsg      `json:"linkMsg,optional"`
		AtUserIDs       []string          `json:"atUserIds,optional"`
		CloudDocMsg     *PeerCloudDocMsg  `json:"cloudDocMsg,optional"`
		CardMsg         *PeerCardMsg      `json:"cardMsg,optional"`
	}

PeerWithdrawMsg {
		OriginMsgID string   `json:"originMsgId,optional"`
		OriginMsg   *PeerMsg `json:"originMsg,optional"`
	}

PeerReplyMsg {
		OriginMsgID string   `json:"originMsgId,optional"`
		OriginMsg   *PeerMsg `json:"originMsg,optional"`
		ReplyMsg    *PeerMsg `json:"replyMsg,optional"`
	}

PeerSender {
		UserID   string `json:"userId,optional"`
		Avatar   string `json:"avatar,optional"`
		NickName string `json:"nickName,optional"`
		UserType int32  `json:"userType,optional"`
	}
)

type (
PeerSendMsgReq {
		UserID         string   `json:"userId,optional"`
		ConversationID string   `json:"conversationId,optional"`
		MessageID      string   `json:"messageId,optional"`
		Msg            *PeerMsg `json:"msg,optional"`
		DeviceID       string   `json:"deviceId,optional"`
	}

PeerSendMsgRes {
		ID               uint32      `json:"id,optional"`
		MessageID        string      `json:"messageId,optional"`
		ConversationID   string      `json:"conversationId,optional"`
		Msg              *PeerMsg    `json:"msg,optional"`
		Sender           *PeerSender `json:"sender,optional"`
		CreatedAt        string      `json:"createdAt,optional"`
		MsgPreview       string      `json:"msgPreview,optional"`
		Status           uint32      `json:"status,optional"`
		Seq              int64       `json:"seq,optional"`
		ConversationType uint32      `json:"conversationType,optional"`
	}
)

type (
PeerInitializeConversationReq {
		ConversationID string   `json:"conversationId,optional"`
		Type           int32    `json:"type,optional"`
		UserIDs        []string `json:"userIds,optional"`
	}

PeerInitializeConversationRes {
		ConversationID string `json:"conversationId,optional"`
	}
)

type (
PeerSendNotificationMessageReq {
		ConversationID string   `json:"conversationId,optional"`
		MessageType    int32    `json:"messageType,optional"`
		Content        string   `json:"content,optional"`
		RelatedUserID  string   `json:"relatedUserId,optional"`
		ReadUserIDs    []string `json:"readUserIds,optional"`
	}

PeerSendNotificationMessageRes {
		MessageID string `json:"messageId,optional"`
	}
)

type (
PeerGetChatMessageReq {
		ConversationID string `json:"conversationId,optional"`
		MessageID      string `json:"messageId,optional"`
	}

PeerGetChatMessageRes {
		Found bool     `json:"found,optional"`
		Msg   *PeerMsg `json:"msg,optional"`
	}
)

type (
PeerChatMessageItem {
		MessageID        string `json:"messageId,optional"`
		ConversationID   string `json:"conversationId,optional"`
		ConversationType int32  `json:"conversationType,optional"`
		SendUserID       string `json:"sendUserId,optional"`
		MsgType          int32  `json:"msgType,optional"`
		MsgPreview       string `json:"msgPreview,optional"`
		MsgContent       string `json:"msgContent,optional"`
		Status           int32  `json:"status,optional"`
		CreatedAt        string `json:"createdAt,optional"`
		UpdatedAt        string `json:"updatedAt,optional"`
	}

PeerListChatMessagesReq {
		Page           int32  `json:"page,optional"`
		PageSize       int32  `json:"pageSize,optional"`
		ConversationID string `json:"conversationId,optional"`
		SendUserID     string `json:"sendUserId,optional"`
		MsgType        int32  `json:"msgType,optional"`
		StartTime      string `json:"startTime,optional"`
		EndTime        string `json:"endTime,optional"`
		MessageID      string `json:"messageId,optional"`
		WithContent    bool   `json:"withContent,optional"`
		Status         int32  `json:"status,optional"`
		Order          int32  `json:"order,optional"`
	}

PeerListChatMessagesRes {
		Total int64                  `json:"total,optional"`
		List  []PeerChatMessageItem `json:"list,optional"`
	}
)

type (
PeerUpdateChatMessagesReq {
		MessageIDs     []string `json:"messageIds,optional"`
		ConversationID string   `json:"conversationId,optional"`
		MsgType        int32    `json:"msgType,optional"`
		StartTime      string   `json:"startTime,optional"`
		EndTime        string   `json:"endTime,optional"`
		Status         int32    `json:"status,optional"`
	}

PeerUpdateChatMessagesRes {
		AffectedCount int64 `json:"affectedCount,optional"`
	}
)

type (
PeerConversationDetailItem {
		ConversationID  string   `json:"conversationId,optional"`
		Type            int32    `json:"type,optional"`
		LastMessage     string   `json:"lastMessage,optional"`
		LastMessageTime string   `json:"lastMessageTime,optional"`
		MessageCount    int64    `json:"messageCount,optional"`
		ParticipantIDs  []string `json:"participantIds,optional"`
	}

PeerListConversationsReq {
		UserID           string `json:"userId,optional"`
		ConversationType int32  `json:"conversationType,optional"`
		Page             int32  `json:"page,optional"`
		PageSize         int32  `json:"pageSize,optional"`
	}

PeerListConversationsRes {
		Total int64                        `json:"total,optional"`
		List  []PeerConversationDetailItem `json:"list,optional"`
	}

PeerGetConversationMemberIdsReq {
		ConversationID string `json:"conversationId,optional"`
		ExcludeUserID  string `json:"excludeUserId,optional"`
	}

PeerGetConversationMemberIdsRes {
		UserIDs []string `json:"userIds,optional"`
	}
)

type (
	// PeerChatHistoryReq 按会话取可读对话流。
	// 与用户面 ChatHistoryReq 的差别只在身份来源：S2S 面没有网关注入的
	// Beaver-User-Id，身份由请求体 UserID 携带，logic 内必须校验其为会话成员。
	PeerChatHistoryReq {
		ConversationID string `json:"conversationId"`
		UserID         string `json:"userId"` // 以谁的身份读，用于成员校验与"已删除消息"过滤
		Page           int    `json:"page,optional"`
		Limit          int    `json:"limit,optional"` // 缺省 20，上限 100
		BeforeSeq      int64  `json:"beforeSeq,optional"` // 只取 seq < BeforeSeq，往前翻页；0=最新一页
	}

	// PeerChatHistoryItem 一行可读对话：发言人是昵称而不是 userId，正文是文本预览。
	PeerChatHistoryItem {
		MessageID  string `json:"messageId"`
		SenderID   string `json:"senderId"`
		SenderName string `json:"senderName"` // 通知类消息为"通知"
		Content    string `json:"content"`    // 非文本消息给类型占位
		MsgType    uint32 `json:"msgType"`    // 对齐 Msg.Type
		Seq        int64  `json:"seq"`        // 供下一页 BeforeSeq
		CreatedAt  string `json:"createdAt"`
	}

	PeerChatHistoryRes {
		Total   int64                 `json:"total"`
		HasMore bool                  `json:"hasMore"`
		List    []PeerChatHistoryItem `json:"list"`
	}
)

@server (
	middleware: JwtS2s
	group: chat
)
service message {
	@doc "发送消息"
	@handler SendMsg
	post /beaver/api/message/chat/v1/send_msg (SendMsgReq) returns (SendMsgRes)

	@doc "获取会话id"
	@handler ConversationInfo
	post /beaver/api/message/chat/v1/get_conversation_info (ConversationInfoReq) returns (ConversationInfoRes)

	@doc "获取最近会话列表"
	@handler recentChatList
	get /beaver/api/message/chat/v1/get_recent_chat_list (RecentChatListReq) returns (RecentChatListRes)

	@doc "获取聊天记录"
	@handler chatHistory
	post /beaver/api/message/chat/v1/get_chat_history (ChatHistoryReq) returns (ChatHistoryRes)

	@doc "搜索消息"
	@handler searchMessages
	post /beaver/api/message/chat/v1/search_messages (SearchMessagesReq) returns (SearchMessagesRes)

	@doc "删除某个最近会话"
	@handler deleteRecent
	post /beaver/api/message/chat/v1/delete_recent_chat (DeleteRecentReq) returns (DeleteRecentRes)

	@doc "置顶某个会话"
	@handler pinnedChat
	post /beaver/api/message/chat/v1/pinned_chat (PinnedChatReq) returns (PinnedChatRes)

	@doc "设置会话免打扰"
	@handler muteChat
	post /beaver/api/message/chat/v1/mute_chat (MuteChatReq) returns (MuteChatRes)

	@doc "隐藏/显示会话"
	@handler hideChat
	post /beaver/api/message/chat/v1/hide_chat (HideChatReq) returns (HideChatRes)

	@doc "撤回消息"
	@handler recallMessage
	post /beaver/api/message/chat/v1/recall (RecallMessageReq) returns (RecallMessageRes)

	@doc "批量删除消息(仅自己不可见)"
	@handler deleteMessages
	post /beaver/api/message/chat/v1/delete_messages (DeleteMessagesReq) returns (DeleteMessagesRes)

	@doc "标记消息媒体状态（语音已听等）"
	@handler markMessageMedia
	post /beaver/api/message/chat/v1/mark_message_media (MarkMessageMediaReq) returns (MarkMessageMediaRes)

	@doc "转发消息"
	@handler forwardMessage
	post /beaver/api/message/chat/v1/forward (ForwardMessageReq) returns (ForwardMessageRes)

	@doc "聊天数据同步"
	@handler chatSync
	post /beaver/api/message/chat/v1/sync (ChatSyncReq) returns (ChatSyncRes)

	@doc "批量获取会话数据"
	@handler getConversationsListByIds
	post /beaver/api/message/chat/v1/get_conversations_list_by_ids (GetConversationsListByIdsReq) returns (GetConversationsListByIdsRes)

	@doc "批量获取用户会话设置数据"
	@handler getUserConversationSettingsListByIds
	post /beaver/api/message/chat/v1/get_user_conversation_settings_list_by_ids (GetUserConversationSettingsListByIdsReq) returns (GetUserConversationSettingsListByIdsRes)

	@doc "更新会话已读序列号"
	@handler updateReadSeq
	post /beaver/api/message/chat/v1/update_read_seq (UpdateReadSeqReq) returns (UpdateReadSeqRes)

	@doc "获取合并转发详情"
	@handler getForwardDetails
	get /beaver/api/message/chat/v1/get_forward_details (GetForwardDetailsReq) returns (GetForwardDetailsRes)

@doc "发送消息"
	@handler peerSendMsg
	post /beaver/api/message/chat_s2s/v1/send (PeerSendMsgReq) returns (PeerSendMsgRes)

	@doc "初始化会话"
	@handler peerInitializeConversation
	post /beaver/api/message/chat_s2s/v1/initialize_conversation (PeerInitializeConversationReq) returns (PeerInitializeConversationRes)

	@doc "发送系统通知消息"
	@handler peerSendNotificationMessage
	post /beaver/api/message/chat_s2s/v1/send_notification_message (PeerSendNotificationMessageReq) returns (PeerSendNotificationMessageRes)

	@doc "按会话+消息 ID 取单条消息"
	@handler peerGetChatMessage
	post /beaver/api/message/chat_s2s/v1/get_message (PeerGetChatMessageReq) returns (PeerGetChatMessageRes)

	@doc "分页查消息"
	@handler peerListChatMessages
	post /beaver/api/message/chat_s2s/v1/messages (PeerListChatMessagesReq) returns (PeerListChatMessagesRes)

	@doc "批量更新消息状态"
	@handler peerUpdateChatMessages
	post /beaver/api/message/chat_s2s/v1/update_messages (PeerUpdateChatMessagesReq) returns (PeerUpdateChatMessagesRes)

	@doc "分页查会话"
	@handler peerListConversations
	post /beaver/api/message/chat_s2s/v1/conversations (PeerListConversationsReq) returns (PeerListConversationsRes)

	@doc "查会话成员 ID 列表"
	@handler peerGetConversationMemberIds
	post /beaver/api/message/chat_s2s/v1/conversation_members (PeerGetConversationMemberIdsReq) returns (PeerGetConversationMemberIdsRes)

	@doc "按会话取可读对话流（发言人昵称 + 文本预览，供摘要/Agent 使用）"
	@handler peerGetChatHistory
	post /beaver/api/message/chat_s2s/v1/get_chat_history (PeerChatHistoryReq) returns (PeerChatHistoryRes)








}
