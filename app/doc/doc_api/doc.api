syntax = "v1"

// ==================== 文档空间 space ====================
type (
	CreateSpaceReq {
		UserId      string `header:"Beaver-User-Id"`
		Name        string `json:"name"`
		Kind        string `json:"kind,optional"`
		ParentId    string `json:"parentId,optional"`
		Icon        string `json:"icon,optional"`
		Description string `json:"description,optional"`
		Sort        int    `json:"sort,optional"`
	}
	CreateSpaceRes {
		SpaceId string `json:"spaceId"`
	}
)

type (
	UpdateSpaceReq {
		UserId      string `header:"Beaver-User-Id"`
		SpaceId     string `json:"spaceId"`
		Name        string `json:"name,optional"`
		Icon        string `json:"icon,optional"`
		Description string `json:"description,optional"`
		ParentId    string `json:"parentId,optional"`
		Status      int    `json:"status,optional"`
		Sort        int    `json:"sort,optional"`
	}
	UpdateSpaceRes  {}
)

type (
	DeleteSpaceReq {
		UserId  string `header:"Beaver-User-Id"`
		SpaceId string `json:"spaceId"`
	}
	DeleteSpaceRes  {}
)

type SpaceItem {
	SpaceId     string `json:"spaceId"`
	Name        string `json:"name"`
	Kind        string `json:"kind"`
	OwnerUserId string `json:"ownerUserId"`
	ParentId    string `json:"parentId"`
	Icon        string `json:"icon"`
	Description string `json:"description"`
	Status      int    `json:"status"`
	Sort        int    `json:"sort"`
	CreatedAt   string `json:"createdAt"`
}

type (
	GetSpaceReq {
		UserId  string `header:"Beaver-User-Id"`
		SpaceId string `json:"spaceId"`
	}
	GetSpaceRes {
		Space *SpaceItem `json:"space"`
	}
)

type (
	ListSpacesReq {
		UserId   string `header:"Beaver-User-Id"`
		Status   int    `json:"status,optional"`
		Page     int    `json:"page,optional"`
		PageSize int    `json:"pageSize,optional"`
	}
	ListSpacesRes {
		Total  int64       `json:"total"`
		Spaces []SpaceItem `json:"spaces"`
	}
)

// ==================== 节点树 node ====================
type (
	CreateNodeReq {
		UserId   string `header:"Beaver-User-Id"`
		SpaceId  string `json:"spaceId"`
		ParentId string `json:"parentId,optional"`
		Title    string `json:"title"`
		Type     string `json:"type,optional"`
		Icon     string `json:"icon,optional"`
		Sort     int    `json:"sort,optional"`
	}
	CreateNodeRes {
		NodeId string `json:"nodeId"`
		DocId  string `json:"docId"`
	}
)

type (
	UpdateNodeReq {
		UserId   string `header:"Beaver-User-Id"`
		NodeId   string `json:"nodeId"`
		Title    string `json:"title,optional"`
		Icon     string `json:"icon,optional"`
		ParentId string `json:"parentId,optional"`
		Sort     int    `json:"sort,optional"`
	}
	UpdateNodeRes  {}
)

type (
	DeleteNodeReq {
		UserId string `header:"Beaver-User-Id"`
		NodeId string `json:"nodeId"`
	}
	DeleteNodeRes  {}
)

type NodeItem {
	NodeId   string `json:"nodeId"`
	SpaceId  string `json:"spaceId"`
	ParentId string `json:"parentId"`
	Title    string `json:"title"`
	Icon     string `json:"icon"`
	Type     string `json:"type"`
	Sort     int    `json:"sort"`
	DocId    string `json:"docId"`
}

type (
	ListNodesReq {
		UserId  string `header:"Beaver-User-Id"`
		SpaceId string `json:"spaceId"`
	}
	ListNodesRes {
		Nodes []NodeItem `json:"nodes"`
	}
)

// ==================== 文档 document ====================
type (
	CreateDocReq {
		UserId      string `header:"Beaver-User-Id"`
		SpaceId     string `json:"spaceId"`
		NodeId      string `json:"nodeId,optional"`
		Title       string `json:"title"`
		ContentJson string `json:"contentJson,optional"`
		DocType     string `json:"docType,optional"`
		Icon        string `json:"icon,optional"`
		Cover       string `json:"cover,optional"`
		RagEnabled  bool   `json:"ragEnabled,optional"`
	}
	CreateDocRes {
		DocId string `json:"docId"`
	}
)

type DocItem {
	DocId        string `json:"docId"`
	NodeId       string `json:"nodeId"`
	SpaceId      string `json:"spaceId"`
	Title        string `json:"title"`
	ContentJson  string `json:"contentJson"`
	ContentText  string `json:"contentText"`
	Version      int    `json:"version"`
	Epoch        int    `json:"epoch"`
	DocType      string `json:"docType"`
	Icon         string `json:"icon"`
	Cover        string `json:"cover"`
	RagEnabled   bool   `json:"ragEnabled"`
	OwnerUserId  string `json:"ownerUserId"`
	LastEditedBy string `json:"lastEditedBy"`
	Status       int    `json:"status"`
	UpdatedAt    string `json:"updatedAt"`
	CreatedAt    string `json:"createdAt"`
}

type (
	GetDocReq {
		UserId string `header:"Beaver-User-Id"`
		DocId  string `json:"docId"`
	}
	GetDocRes {
		Doc *DocItem `json:"doc"`
	}
)

type (
	UpdateDocMetaReq {
		UserId        string `header:"Beaver-User-Id"`
		DocId         string `json:"docId"`
		Title         string `json:"title,optional"`
		Status        int    `json:"status,optional"`
		Icon          string `json:"icon,optional"`
		Cover         string `json:"cover,optional"`
		DocType       string `json:"docType,optional"`
		RagEnabled    bool   `json:"ragEnabled,optional"`
		RagEnabledSet bool   `json:"ragEnabledSet,optional"`
	}
	UpdateDocMetaRes  {}
)

type (
	DeleteDocReq {
		UserId string `header:"Beaver-User-Id"`
		DocId  string `json:"docId"`
	}
	DeleteDocRes  {}
)

type (
	SaveDocContentReq {
		UserId      string `header:"Beaver-User-Id"`
		DocId       string `json:"docId"`
		ContentJson string `json:"contentJson"`
		ContentText string `json:"contentText,optional"`
	}
	SaveDocContentRes {
		Version int `json:"version"`
	}
)

// 初始快照拉取（编辑器首次连接或降级为纯 HTTP 模式时的全量入口）。
type (
	GetDocSyncStateReq {
		UserId string `header:"Beaver-User-Id"`
		DocId  string `json:"docId"`
		Epoch  int    `json:"epoch,optional"`
	}
	GetDocSyncStateRes {
		Snapshot []byte   `json:"snapshot"`
		Updates  [][]byte `json:"updates"`
		Version  int      `json:"version"`
		Epoch    int      `json:"epoch"`
	}
)

// ==================== 权限 / 分享 permission ====================
type (
	SetPermissionReq {
		UserId        string `header:"Beaver-User-Id"`
		ResourceType  string `json:"resourceType"`
		ResourceId    string `json:"resourceId"`
		PrincipalType string `json:"principalType,optional"`
		PrincipalId   string `json:"principalId"`
		Role          string `json:"role"`
	}
	SetPermissionRes  {}
)

type (
	DeletePermissionReq {
		UserId        string `header:"Beaver-User-Id"`
		ResourceType  string `json:"resourceType"`
		ResourceId    string `json:"resourceId"`
		PrincipalType string `json:"principalType,optional"`
		PrincipalId   string `json:"principalId"`
	}
	DeletePermissionRes  {}
)

type PermItem {
	ResourceType  string `json:"resourceType"`
	ResourceId    string `json:"resourceId"`
	PrincipalType string `json:"principalType"`
	PrincipalId   string `json:"principalId"`
	Role          string `json:"role"`
}

type (
	ListPermissionsReq {
		UserId       string `header:"Beaver-User-Id"`
		ResourceType string `json:"resourceType"`
		ResourceId   string `json:"resourceId"`
	}
	ListPermissionsRes {
		Permissions []PermItem `json:"permissions"`
	}
)

type (
	CheckPermissionReq {
		UserId       string `header:"Beaver-User-Id"`
		ResourceType string `json:"resourceType"`
		ResourceId   string `json:"resourceId"`
	}
	CheckPermissionRes {
		Role string `json:"role"`
	}
)

// ==================== 版本历史 revision ====================
type (
	ListRevisionsReq {
		UserId   string `header:"Beaver-User-Id"`
		DocId    string `json:"docId"`
		Page     int    `json:"page,optional"`
		PageSize int    `json:"pageSize,optional"`
	}
	RevisionItem {
		RevisionId string `json:"revisionId"`
		DocId      string `json:"docId"`
		Version    int    `json:"version"`
		Title      string `json:"title"`
		Label      string `json:"label"`
		CreatedBy  string `json:"createdBy"`
		CreatedAt  string `json:"createdAt"`
	}
	ListRevisionsRes {
		Total     int64          `json:"total"`
		Revisions []RevisionItem `json:"revisions"`
	}
)

type (
	GetRevisionReq {
		UserId     string `header:"Beaver-User-Id"`
		RevisionId string `json:"revisionId"`
	}
	GetRevisionRes {
		Revision    *RevisionItem `json:"revision"`
		ContentJson string        `json:"contentJson"`
	}
)

type (
	RollbackRevisionReq {
		UserId     string `header:"Beaver-User-Id"`
		DocId      string `json:"docId"`
		RevisionId string `json:"revisionId"`
	}
	RollbackRevisionRes {
		Version int `json:"version"`
		Epoch   int `json:"epoch"`
	}
)

// ==================== 文件导入 ====================
type (
	ImportDocReq {
		UserId       string `header:"Beaver-User-Id"`
		SpaceId      string `json:"spaceId"`
		ParentNodeId string `json:"parentNodeId,optional"`
		Title        string `json:"title,optional"`
		FileName     string `json:"fileName"`
		Data         string `json:"data"` // base64 编码的文件二进制
	}
	ImportDocRes {
		DocId       string `json:"docId"`
		NodeId      string `json:"nodeId"`
		ContentText string `json:"contentText"`
		FileKind    string `json:"fileKind"`
		Parsed      bool   `json:"parsed"`
		Message     string `json:"message"`
	}
)

// ==================== 实时协同 WebSocket ====================
type (
	WsReq {
		DocID    string `form:"docId"`             // 文档ID，作为协同房间名
		UserID   string `form:"userId"`            // 用户ID
		Token    string `form:"token"`             // 用户 token（Beaver JWT），升级前校验
		Platform string `form:"platform,optional"` // 平台类型，用于登录态槽位校验
		DeviceID string `form:"deviceId,optional"` // 设备 GUID，设备指纹校验
		Epoch    int    `form:"epoch,optional"`    // 客户端缓存的协同纪元；服务端按 docId@epoch 校验，过期返回 409
		Room     string `form:"room,optional"`     // y-websocket 拼在 URL 后的房间名（须与 docId 一致）
	}
	WsRes {}
)

// ==================== 评论 / 批注 / @提及 ====================
type CommentItem {
	CommentId  string        `json:"commentId"`
	DocId      string        `json:"docId"`
	Epoch      int           `json:"epoch"`
	ParentId   string        `json:"parentId"`
	AnchorId   string        `json:"anchorId"`
	Quote      string        `json:"quote"`
	Content    string        `json:"content"`
	Mentions   string        `json:"mentions"`
	CreatedBy  string        `json:"createdBy"`
	Resolved   bool          `json:"resolved"`
	ResolvedBy string        `json:"resolvedBy"`
	ResolvedAt string        `json:"resolvedAt"`
	CreatedAt  string        `json:"createdAt"`
	Replies    []CommentItem `json:"replies"`
}
type (
	CreateCommentReq {
		UserId   string `header:"Beaver-User-Id"`
		DocId    string `json:"docId"`
		ParentId string `json:"parentId,optional"`
		AnchorId string `json:"anchorId,optional"`
		Quote    string `json:"quote,optional"`
		Content  string `json:"content"`
		Mentions string `json:"mentions,optional"`
	}
	CreateCommentRes {
		Comment *CommentItem `json:"comment"`
	}
	ListCommentsReq {
		UserId          string `header:"Beaver-User-Id"`
		DocId           string `json:"docId"`
		IncludeResolved bool   `json:"includeResolved,optional"`
	}
	ListCommentsRes {
		Total    int64         `json:"total"`
		Comments []CommentItem `json:"comments"`
	}
	ResolveCommentReq {
		UserId     string `header:"Beaver-User-Id"`
		CommentId  string `json:"commentId"`
		Resolved   bool   `json:"resolved"`
	}
	ResolveCommentRes {}
	DeleteCommentReq {
		UserId    string `header:"Beaver-User-Id"`
		CommentId string `json:"commentId"`
	}
	DeleteCommentRes {}
)

// ==================== 分享链接 ====================
type ShareLinkItem {
	LinkId        string `json:"linkId"`
	Token         string `json:"token"`
	ResourceType  string `json:"resourceType"`
	ResourceId    string `json:"resourceId"`
	Scope         string `json:"scope"`
	Role          string `json:"role"`
	HasPassword   bool   `json:"hasPassword"`
	ExpiresAt     string `json:"expiresAt"`
	AllowDownload bool   `json:"allowDownload"`
	AllowCopy     bool   `json:"allowCopy"`
	AllowComment  bool   `json:"allowComment"`
	Watermark     bool   `json:"watermark"`
	ViewCount     int64  `json:"viewCount"`
	CreatedBy     string `json:"createdBy"`
	Status        int    `json:"status"`
	Url           string `json:"url"`
}
type (
	SetShareLinkReq {
		UserId        string `header:"Beaver-User-Id"`
		ResourceType  string `json:"resourceType"`
		ResourceId    string `json:"resourceId"`
		Scope         string `json:"scope,optional"`
		Role          string `json:"role,optional"`
		Password      string `json:"password,optional"`
		ExpiresAt     string `json:"expiresAt,optional"`
		AllowDownload bool   `json:"allowDownload,optional"`
		AllowCopy     bool   `json:"allowCopy,optional"`
		AllowComment  bool   `json:"allowComment,optional"`
		Watermark     bool   `json:"watermark,optional"`
	}
	SetShareLinkRes {
		Link *ShareLinkItem `json:"link"`
	}
	GetShareLinkReq {
		UserId       string `header:"Beaver-User-Id"`
		ResourceType string `json:"resourceType"`
		ResourceId   string `json:"resourceId"`
	}
	GetShareLinkRes {
		Link *ShareLinkItem `json:"link"`
	}
	RevokeShareLinkReq {
		UserId string `header:"Beaver-User-Id"`
		LinkId string `json:"linkId"`
	}
	RevokeShareLinkRes {}
	ResolveShareLinkReq {
		UserId   string `header:"Beaver-User-Id"`
		Token    string `json:"token"`
		Password string `json:"password,optional"`
	}
	ResolveShareLinkRes {
		ResourceType  string `json:"resourceType"`
		ResourceId    string `json:"resourceId"`
		Role          string `json:"role"`
		DocId         string `json:"docId"`
		Title         string `json:"title"`
		AllowDownload bool   `json:"allowDownload"`
		AllowCopy     bool   `json:"allowCopy"`
		AllowComment  bool   `json:"allowComment"`
		Watermark     bool   `json:"watermark"`
	}
)

// ==================== 回收站 ====================
type TrashItem {
	TrashId      string `json:"trashId"`
	ResourceType string `json:"resourceType"`
	ResourceId   string `json:"resourceId"`
	Title        string `json:"title"`
	SpaceId      string `json:"spaceId"`
	ParentId     string `json:"parentId"`
	DeletedBy    string `json:"deletedBy"`
	DeletedAt    string `json:"deletedAt"`
}
type (
	ListTrashReq {
		UserId   string `header:"Beaver-User-Id"`
		Page     int    `json:"page,optional"`
		PageSize int    `json:"pageSize,optional"`
	}
	ListTrashRes {
		Total int64       `json:"total"`
		Items []TrashItem `json:"items"`
	}
	RestoreTrashReq {
		UserId  string `header:"Beaver-User-Id"`
		TrashId string `json:"trashId"`
	}
	RestoreTrashRes {
		ResourceType string `json:"resourceType"`
		ResourceId   string `json:"resourceId"`
	}
	PurgeTrashReq {
		UserId  string `header:"Beaver-User-Id"`
		TrashId string `json:"trashId"`
	}
	PurgeTrashRes {}
	EmptyTrashReq {
		UserId string `header:"Beaver-User-Id"`
	}
	EmptyTrashRes {
		Purged int `json:"purged"`
	}
)

// ==================== 检索 / 最近 / 收藏 / 列表 ====================
type DocSearchItem {
	Doc     *DocItem `json:"doc"`
	Snippet string   `json:"snippet"`
}
type (
	SearchDocsReq {
		UserId   string `header:"Beaver-User-Id"`
		Query    string `json:"query"`
		SpaceId  string `json:"spaceId,optional"`
		DocType  string `json:"docType,optional"`
		Page     int    `json:"page,optional"`
		PageSize int    `json:"pageSize,optional"`
	}
	SearchDocsRes {
		Total int64           `json:"total"`
		Items []DocSearchItem `json:"items"`
	}
	ListDocsReq {
		UserId   string `header:"Beaver-User-Id"`
		SpaceId  string `json:"spaceId"`
		DocType  string `json:"docType,optional"`
		Page     int    `json:"page,optional"`
		PageSize int    `json:"pageSize,optional"`
	}
	ListDocsRes {
		Total int64     `json:"total"`
		Docs  []DocItem `json:"docs"`
	}
	RecordVisitReq {
		UserId string `header:"Beaver-User-Id"`
		DocId  string `json:"docId"`
	}
	RecordVisitRes {}
	ListRecentReq {
		UserId   string `header:"Beaver-User-Id"`
		Page     int    `json:"page,optional"`
		PageSize int    `json:"pageSize,optional"`
	}
	ListRecentRes {
		Total int64     `json:"total"`
		Docs  []DocItem `json:"docs"`
	}
	SetFavoriteReq {
		UserId   string `header:"Beaver-User-Id"`
		DocId    string `json:"docId"`
		Favorite bool   `json:"favorite"`
	}
	SetFavoriteRes {
		Favorite bool `json:"favorite"`
	}
	ListFavoritesReq {
		UserId   string `header:"Beaver-User-Id"`
		Page     int    `json:"page,optional"`
		PageSize int    `json:"pageSize,optional"`
	}
	ListFavoritesRes {
		Total int64     `json:"total"`
		Docs  []DocItem `json:"docs"`
	}
)

// ==================== 模板中心 ====================
type TemplateItem {
	TemplateId  string `json:"templateId"`
	Name        string `json:"name"`
	Category    string `json:"category"`
	Description string `json:"description"`
	Cover       string `json:"cover"`
	ContentJson string `json:"contentJson"`
	DocType     string `json:"docType"`
	Scope       string `json:"scope"`
	OwnerUserId string `json:"ownerUserId"`
	UseCount    int    `json:"useCount"`
	Status      int    `json:"status"`
	CreatedAt   string `json:"createdAt"`
}
type (
	ListTemplatesReq {
		UserId   string `header:"Beaver-User-Id"`
		Category string `json:"category,optional"`
		Page     int    `json:"page,optional"`
		PageSize int    `json:"pageSize,optional"`
	}
	ListTemplatesRes {
		Total     int64          `json:"total"`
		Templates []TemplateItem `json:"templates"`
	}
	CreateTemplateReq {
		UserId      string `header:"Beaver-User-Id"`
		Name        string `json:"name"`
		Category    string `json:"category,optional"`
		Description string `json:"description,optional"`
		Cover       string `json:"cover,optional"`
		ContentJson string `json:"contentJson,optional"`
		DocType     string `json:"docType,optional"`
		Scope       string `json:"scope,optional"`
	}
	CreateTemplateRes {
		TemplateId string `json:"templateId"`
	}
	InstantiateTemplateReq {
		UserId       string `header:"Beaver-User-Id"`
		TemplateId   string `json:"templateId"`
		SpaceId      string `json:"spaceId"`
		ParentNodeId string `json:"parentNodeId,optional"`
		Title        string `json:"title,optional"`
	}
	InstantiateTemplateRes {
		DocId  string `json:"docId"`
		NodeId string `json:"nodeId"`
	}
	DeleteTemplateReq {
		UserId     string `header:"Beaver-User-Id"`
		TemplateId string `json:"templateId"`
	}
	DeleteTemplateRes {}
)

// ==================== 导出 / 复制 ====================
type (
	ExportDocReq {
		UserId string `header:"Beaver-User-Id"`
		DocId  string `json:"docId"`
		Format string `json:"format,optional"`
	}
	ExportDocRes {
		FileName string `json:"fileName"`
		MimeType string `json:"mimeType"`
		Data     string `json:"data"`
		Text     string `json:"text"`
	}
	DuplicateDocReq {
		UserId       string `header:"Beaver-User-Id"`
		DocId        string `json:"docId"`
		SpaceId      string `json:"spaceId,optional"`
		ParentNodeId string `json:"parentNodeId,optional"`
		Title        string `json:"title,optional"`
	}
	DuplicateDocRes {
		DocId  string `json:"docId"`
		NodeId string `json:"nodeId"`
	}
)

// ==================== 富媒体块 ====================
type DocBlockItem {
	BlockId     string `json:"blockId"`
	DocId       string `json:"docId"`
	Kind        string `json:"kind"`
	Title       string `json:"title"`
	PayloadJson string `json:"payloadJson"`
	Version     int    `json:"version"`
	UpdatedBy   string `json:"updatedBy"`
	UpdatedAt   string `json:"updatedAt"`
}
type (
	SaveDocBlockReq {
		UserId      string `header:"Beaver-User-Id"`
		DocId       string `json:"docId"`
		BlockId     string `json:"blockId,optional"`
		Kind        string `json:"kind"`
		Title       string `json:"title,optional"`
		PayloadJson string `json:"payloadJson"`
	}
	SaveDocBlockRes {
		Block *DocBlockItem `json:"block"`
	}
	ListDocBlocksReq {
		UserId string `header:"Beaver-User-Id"`
		DocId  string `json:"docId"`
	}
	ListDocBlocksRes {
		Blocks []DocBlockItem `json:"blocks"`
	}
	DeleteDocBlockReq {
		UserId  string `header:"Beaver-User-Id"`
		DocId   string `json:"docId"`
		BlockId string `json:"blockId"`
	}
	DeleteDocBlockRes {}
)

// ==================== 版本增强 ====================
type (
	LabelRevisionReq {
		UserId     string `header:"Beaver-User-Id"`
		RevisionId string `json:"revisionId"`
		Label      string `json:"label"`
	}
	LabelRevisionRes {}
	DiffRevisionsReq {
		UserId           string `header:"Beaver-User-Id"`
		DocId            string `json:"docId"`
		BaseRevisionId   string `json:"baseRevisionId"`
		TargetRevisionId string `json:"targetRevisionId"`
	}
	DiffRevisionsRes {
		BaseContentJson   string   `json:"baseContentJson"`
		TargetContentJson string   `json:"targetContentJson"`
		BaseText          string   `json:"baseText"`
		TargetText        string   `json:"targetText"`
		AddedLines        []string `json:"addedLines"`
		RemovedLines      []string `json:"removedLines"`
	}
)

// ==================== 通知中心 ====================
type NotificationItem {
	NotificationId string `json:"notificationId"`
	UserId         string `json:"userId"`
	DocId          string `json:"docId"`
	Kind           string `json:"kind"`
	ActorUserId    string `json:"actorUserId"`
	Title          string `json:"title"`
	Excerpt        string `json:"excerpt"`
	IsRead         bool   `json:"isRead"`
	CreatedAt      string `json:"createdAt"`
}
type (
	ListNotificationsReq {
		UserId     string `header:"Beaver-User-Id"`
		UnreadOnly bool   `json:"unreadOnly,optional"`
		Page       int    `json:"page,optional"`
		PageSize   int    `json:"pageSize,optional"`
	}
	ListNotificationsRes {
		Total  int64              `json:"total"`
		Unread int64              `json:"unread"`
		Items  []NotificationItem `json:"items"`
	}
	MarkNotificationReadReq {
		UserId         string `header:"Beaver-User-Id"`
		NotificationId string `json:"notificationId,optional"`
		All            bool   `json:"all,optional"`
	}
	MarkNotificationReadRes {
		Unread int64 `json:"unread"`
	}
)

// ==================== 操作审计 ====================
type AuditLogItem {
	LogId        string `json:"logId"`
	ActorUserId  string `json:"actorUserId"`
	Action       string `json:"action"`
	ResourceType string `json:"resourceType"`
	ResourceId   string `json:"resourceId"`
	Detail       string `json:"detail"`
	CreatedAt    string `json:"createdAt"`
}
type (
	ListAuditLogsReq {
		UserId       string `header:"Beaver-User-Id"`
		ActorUserId  string `json:"actorUserId,optional"`
		Action       string `json:"action,optional"`
		ResourceType string `json:"resourceType,optional"`
		ResourceId   string `json:"resourceId,optional"`
		Page         int    `json:"page,optional"`
		PageSize     int    `json:"pageSize,optional"`
	}
	ListAuditLogsRes {
		Total int64          `json:"total"`
		Logs  []AuditLogItem `json:"logs"`
	}
)

// ==================== 知识库同步 / 协作者 ====================
type (
	SetKnowledgeSyncReq {
		UserId     string `header:"Beaver-User-Id"`
		DocId      string `json:"docId"`
		RagEnabled bool   `json:"ragEnabled"`
	}
	SetKnowledgeSyncRes {
		RagEnabled bool `json:"ragEnabled"`
	}
	ReindexDocReq {
		UserId string `header:"Beaver-User-Id"`
		DocId  string `json:"docId"`
	}
	ReindexDocRes {
		Version int    `json:"version"`
		Status  string `json:"status"`
		Digest  string `json:"digest"`
	}
)
type CollaboratorItem {
	UserId        string `json:"userId"`
	Role          string `json:"role"`
	PrincipalType string `json:"principalType"`
	Source        string `json:"source"`
}
type (
	ListCollaboratorsReq {
		UserId string `header:"Beaver-User-Id"`
		DocId  string `json:"docId"`
	}
	ListCollaboratorsRes {
		Collaborators []CollaboratorItem `json:"collaborators"`
	}
)

service doc {
	@doc "创建文档空间"
	@handler CreateSpace
	post /api/doc/v1/space/create (CreateSpaceReq) returns (CreateSpaceRes)

	@doc "更新文档空间"
	@handler UpdateSpace
	post /api/doc/v1/space/update (UpdateSpaceReq) returns (UpdateSpaceRes)

	@doc "删除文档空间"
	@handler DeleteSpace
	post /api/doc/v1/space/delete (DeleteSpaceReq) returns (DeleteSpaceRes)

	@doc "获取文档空间详情"
	@handler GetSpace
	post /api/doc/v1/space/get (GetSpaceReq) returns (GetSpaceRes)

	@doc "列出可见空间"
	@handler ListSpaces
	post /api/doc/v1/space/list (ListSpacesReq) returns (ListSpacesRes)

	@doc "创建节点"
	@handler CreateNode
	post /api/doc/v1/node/create (CreateNodeReq) returns (CreateNodeRes)

	@doc "更新节点"
	@handler UpdateNode
	post /api/doc/v1/node/update (UpdateNodeReq) returns (UpdateNodeRes)

	@doc "删除节点"
	@handler DeleteNode
	post /api/doc/v1/node/delete (DeleteNodeReq) returns (DeleteNodeRes)

	@doc "列出节点树"
	@handler ListNodes
	post /api/doc/v1/node/list (ListNodesReq) returns (ListNodesRes)

	@doc "创建文档"
	@handler CreateDoc
	post /api/doc/v1/doc/create (CreateDocReq) returns (CreateDocRes)

	@doc "获取文档详情"
	@handler GetDoc
	post /api/doc/v1/doc/get (GetDocReq) returns (GetDocRes)

	@doc "更新文档元信息"
	@handler UpdateDocMeta
	post /api/doc/v1/doc/updateMeta (UpdateDocMetaReq) returns (UpdateDocMetaRes)

	@doc "删除文档"
	@handler DeleteDoc
	post /api/doc/v1/doc/delete (DeleteDocReq) returns (DeleteDocRes)

	@doc "保存文档正文"
	@handler SaveDocContent
	post /api/doc/v1/doc/saveContent (SaveDocContentReq) returns (SaveDocContentRes)

	@doc "拉取文档初始同步状态"
	@handler GetDocSyncState
	post /api/doc/v1/doc/syncState (GetDocSyncStateReq) returns (GetDocSyncStateRes)

	@doc "设置权限/分享"
	@handler SetPermission
	post /api/doc/v1/perm/set (SetPermissionReq) returns (SetPermissionRes)

	@doc "删除权限"
	@handler DeletePermission
	post /api/doc/v1/perm/delete (DeletePermissionReq) returns (DeletePermissionRes)

	@doc "列出权限"
	@handler ListPermissions
	post /api/doc/v1/perm/list (ListPermissionsReq) returns (ListPermissionsRes)

	@doc "检查有效权限"
	@handler CheckPermission
	post /api/doc/v1/perm/check (CheckPermissionReq) returns (CheckPermissionRes)

	@doc "列出版本历史"
	@handler ListRevisions
	post /api/doc/v1/revision/list (ListRevisionsReq) returns (ListRevisionsRes)

	@doc "获取版本详情"
	@handler GetRevision
	post /api/doc/v1/revision/get (GetRevisionReq) returns (GetRevisionRes)

	@doc "回滚到版本"
	@handler RollbackRevision
	post /api/doc/v1/revision/rollback (RollbackRevisionReq) returns (RollbackRevisionRes)

	@doc "导入 docx/pdf 文件为文档"
	@handler ImportDoc
	post /api/doc/v1/doc/import (ImportDocReq) returns (ImportDocRes)

	@doc "文档实时协同 WebSocket 网关（y-websocket sync + awareness）"
	@handler DocSyncWebsocket
	get /api/doc/v1/ws (WsReq) returns (WsRes)

	@doc "创建评论或回复"
	@handler CreateComment
	post /api/doc/v1/comment/create (CreateCommentReq) returns (CreateCommentRes)

	@doc "列出文档评论"
	@handler ListComments
	post /api/doc/v1/comment/list (ListCommentsReq) returns (ListCommentsRes)

	@doc "解决 / 重新打开评论"
	@handler ResolveComment
	post /api/doc/v1/comment/resolve (ResolveCommentReq) returns (ResolveCommentRes)

	@doc "删除评论"
	@handler DeleteComment
	post /api/doc/v1/comment/delete (DeleteCommentReq) returns (DeleteCommentRes)

	@doc "创建或更新分享链接"
	@handler SetShareLink
	post /api/doc/v1/share/setLink (SetShareLinkReq) returns (SetShareLinkRes)

	@doc "查询分享链接"
	@handler GetShareLink
	post /api/doc/v1/share/getLink (GetShareLinkReq) returns (GetShareLinkRes)

	@doc "撤销分享链接"
	@handler RevokeShareLink
	post /api/doc/v1/share/revokeLink (RevokeShareLinkReq) returns (RevokeShareLinkRes)

	@doc "解析分享链接（访问入口）"
	@handler ResolveShareLink
	post /api/doc/v1/share/resolveLink (ResolveShareLinkReq) returns (ResolveShareLinkRes)

	@doc "列出回收站"
	@handler ListTrash
	post /api/doc/v1/trash/list (ListTrashReq) returns (ListTrashRes)

	@doc "从回收站恢复"
	@handler RestoreTrash
	post /api/doc/v1/trash/restore (RestoreTrashReq) returns (RestoreTrashRes)

	@doc "彻底删除单条"
	@handler PurgeTrash
	post /api/doc/v1/trash/purge (PurgeTrashReq) returns (PurgeTrashRes)

	@doc "清空回收站"
	@handler EmptyTrash
	post /api/doc/v1/trash/empty (EmptyTrashReq) returns (EmptyTrashRes)

	@doc "全文搜索文档"
	@handler SearchDocs
	post /api/doc/v1/doc/search (SearchDocsReq) returns (SearchDocsRes)

	@doc "按空间列出文档"
	@handler ListDocs
	post /api/doc/v1/doc/list (ListDocsReq) returns (ListDocsRes)

	@doc "记录文档访问"
	@handler RecordVisit
	post /api/doc/v1/doc/visit (RecordVisitReq) returns (RecordVisitRes)

	@doc "最近访问"
	@handler ListRecent
	post /api/doc/v1/doc/listRecent (ListRecentReq) returns (ListRecentRes)

	@doc "收藏 / 取消收藏"
	@handler SetFavorite
	post /api/doc/v1/doc/favorite (SetFavoriteReq) returns (SetFavoriteRes)

	@doc "收藏列表"
	@handler ListFavorites
	post /api/doc/v1/doc/listFavorites (ListFavoritesReq) returns (ListFavoritesRes)

	@doc "模板列表"
	@handler ListTemplates
	post /api/doc/v1/template/list (ListTemplatesReq) returns (ListTemplatesRes)

	@doc "创建模板"
	@handler CreateTemplate
	post /api/doc/v1/template/create (CreateTemplateReq) returns (CreateTemplateRes)

	@doc "从模板创建文档"
	@handler InstantiateTemplate
	post /api/doc/v1/template/instantiate (InstantiateTemplateReq) returns (InstantiateTemplateRes)

	@doc "删除模板"
	@handler DeleteTemplate
	post /api/doc/v1/template/delete (DeleteTemplateReq) returns (DeleteTemplateRes)

	@doc "导出文档"
	@handler ExportDoc
	post /api/doc/v1/doc/export (ExportDocReq) returns (ExportDocRes)

	@doc "复制文档"
	@handler DuplicateDoc
	post /api/doc/v1/doc/duplicate (DuplicateDocReq) returns (DuplicateDocRes)

	@doc "保存多维表格 / 画板块"
	@handler SaveDocBlock
	post /api/doc/v1/block/save (SaveDocBlockReq) returns (SaveDocBlockRes)

	@doc "列出富媒体块"
	@handler ListDocBlocks
	post /api/doc/v1/block/list (ListDocBlocksReq) returns (ListDocBlocksRes)

	@doc "删除富媒体块"
	@handler DeleteDocBlock
	post /api/doc/v1/block/delete (DeleteDocBlockReq) returns (DeleteDocBlockRes)

	@doc "命名版本"
	@handler LabelRevision
	post /api/doc/v1/revision/label (LabelRevisionReq) returns (LabelRevisionRes)

	@doc "对比两个版本"
	@handler DiffRevisions
	post /api/doc/v1/revision/diff (DiffRevisionsReq) returns (DiffRevisionsRes)

	@doc "通知列表"
	@handler ListNotifications
	post /api/doc/v1/notification/list (ListNotificationsReq) returns (ListNotificationsRes)

	@doc "标记通知已读"
	@handler MarkNotificationRead
	post /api/doc/v1/notification/read (MarkNotificationReadReq) returns (MarkNotificationReadRes)

	@doc "操作审计日志"
	@handler ListAuditLogs
	post /api/doc/v1/audit/list (ListAuditLogsReq) returns (ListAuditLogsRes)

	@doc "开关知识库索引"
	@handler SetKnowledgeSync
	post /api/doc/v1/doc/knowledgeSync (SetKnowledgeSyncReq) returns (SetKnowledgeSyncRes)

	@doc "重新入队知识库索引"
	@handler ReindexDoc
	post /api/doc/v1/doc/reindex (ReindexDocReq) returns (ReindexDocRes)

	@doc "协作者列表"
	@handler ListCollaborators
	post /api/doc/v1/collab/list (ListCollaboratorsReq) returns (ListCollaboratorsRes)
}

// goctl api go -api doc.api -dir . --home ../../../template
