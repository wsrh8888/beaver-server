syntax = "v1"

// 文档实时协同 WebSocket 入口
type WsReq {
	DocID    string `form:"docId"` // 文档ID，作为协同房间名
	UserID   string `form:"userId"` // 用户ID
	Token    string `form:"token"` // 用户 token（Beaver JWT），升级前校验
	Platform string `form:"platform,optional"` // 平台类型，用于登录态槽位校验
	DeviceID string `form:"deviceId,optional"` // 设备 GUID，设备指纹校验
}

type WsRes {}

service doc_sync {
	@doc "文档实时协同 WebSocket 网关（y-websocket sync + awareness）"
	@handler docSyncWebsocket
	get /api/doc_sync/v1/ws (WsReq) returns (WsRes)
}

// goctl api go -api doc_sync.api -dir . --home ../../../template
