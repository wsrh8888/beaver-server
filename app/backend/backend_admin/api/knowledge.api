type (
	// KnowledgeCollectionInfo 知识库集合（对应 platform_rpc.KnowledgeCollectionItem）
	KnowledgeCollectionInfo {
		Id          int64  `json:"id"`
		CollectionID string `json:"collectionId"`
		ParentID    string `json:"parentId"`    // 父集合ID，空为根；仅两层
		Name        string `json:"name"`
		Kind        string `json:"kind"`        // docs|faq|...
		AclMode     string `json:"aclMode"`     // user_scoped|internal
		IndexConfig string `json:"indexConfig"` // JSON：分段/检索/embedding 配置
		Description string `json:"description"`
		OwnerUserID string `json:"ownerUserId"`
		Status      int    `json:"status"` // 1启用 2停用
		Sort        int    `json:"sort"`
	}

	// KnowledgeDocumentInfo 知识文档（对应 platform_rpc.KnowledgeDocumentItem，不含正文）
	KnowledgeDocumentInfo {
		Id              int64  `json:"id"`
		DocumentID      string `json:"documentId"`
		CollectionID    string `json:"collectionId"`
		Title           string `json:"title"`
		MediaType       string `json:"mediaType"`
		DocType         string `json:"docType"` // guide|policy|faq|product
		ByteSize        int64  `json:"byteSize"`
		SourceType      string `json:"sourceType"`     // doc平台在线文档|file上传文件
		SourceDocId     string `json:"sourceDocId"`    // 平台在线文档ID（doc 业务的 doc_id）
		SourceRevision  string `json:"sourceRevision"` // 来源版本（doc version）
		SyncMode        string `json:"syncMode"`       // import单次导入|direct自动同步
		SyncInterval    int    `json:"syncInterval"`   // 自动同步间隔秒
		LastSyncedAt    string `json:"lastSyncedAt"`
		MetadataText    string `json:"metadataText"`
		RagEnabled      bool   `json:"ragEnabled"`
		IndexStatus     string `json:"indexStatus"` // pending|indexing|ready|failed
		IndexRetryCount int    `json:"indexRetryCount"`
		IndexError      string `json:"indexError"`
		IndexedAt       string `json:"indexedAt"`
		Status          int    `json:"status"`
	}

	// —— 集合 CRUD ——
	GetKnowledgeCollectionListReq {
		Status   int `form:"status,optional"` // 0全部 1启用 2停用
		Page     int `form:"page,default=1"`
		PageSize int `form:"pageSize,default=20"`
	}
	GetKnowledgeCollectionListRes {
		Total int64                     `json:"total"`
		List  []KnowledgeCollectionInfo `json:"list"`
	}
	GetKnowledgeCollectionReq {
		CollectionID string `form:"collectionId"`
	}
	GetKnowledgeCollectionRes {
		Collection KnowledgeCollectionInfo `json:"collection"`
	}
	CreateKnowledgeCollectionReq {
		ParentID    string `json:"parentId,optional"`
		Name        string `json:"name"`
		Kind        string `json:"kind,optional,default=docs"`
		AclMode     string `json:"aclMode,optional,default=internal"`
		IndexConfig string `json:"indexConfig,optional"` // JSON
		Description string `json:"description,optional"`
		Status      int    `json:"status,optional,default=1"`
		Sort        int    `json:"sort,optional"`
	}
	CreateKnowledgeCollectionRes {
		CollectionID string `json:"collectionId"`
	}
	UpdateKnowledgeCollectionReq {
		CollectionID string `json:"collectionId"`
		Name         string `json:"name,optional"`
		Kind         string `json:"kind,optional"`
		AclMode      string `json:"aclMode,optional"`
		IndexConfig  string `json:"indexConfig,optional"`
		Description  string `json:"description,optional"`
		Status       int    `json:"status,optional"`
		Sort         int    `json:"sort,optional"`
	}
	UpdateKnowledgeCollectionRes {}
	DeleteKnowledgeCollectionReq {
		CollectionID string `json:"collectionId"` // 级联软删其下文档并清索引
	}
	DeleteKnowledgeCollectionRes {}

	// —— 文档 CRUD ——
	GetKnowledgeDocumentListReq {
		CollectionID string `form:"collectionId,optional"`
		IndexStatus  string `form:"indexStatus,optional"`
		Status       int    `form:"status,optional"`
		Page         int    `form:"page,default=1"`
		PageSize     int    `form:"pageSize,default=20"`
	}
	GetKnowledgeDocumentListRes {
		Total int64                    `json:"total"`
		List  []KnowledgeDocumentInfo  `json:"list"`
	}
	GetKnowledgeDocumentReq {
		DocumentID string `form:"documentId"`
	}
	GetKnowledgeDocumentRes {
		Document KnowledgeDocumentInfo `json:"document"`
	}
	CreateKnowledgeDocumentReq {
		CollectionID  string `json:"collectionId"`
		Title         string `json:"title"`
		MediaType     string `json:"mediaType,optional"`
		DocType       string `json:"docType,optional,default=guide"`
		SourceType    string `json:"sourceType,optional"`              // doc|file，空则按 sourceDocId 推断
		SourceDocId   string `json:"sourceDocId,optional"`             // 平台在线文档ID（sourceType=doc 时必填）
		SyncMode      string `json:"syncMode,optional,default=import"` // import|direct
		SyncInterval  int    `json:"syncInterval,optional"`            // 自动同步间隔秒
		ContentText   string `json:"contentText,optional"`             // 上传文件解析正文（sourceType=file 时必填；doc 来源忽略）
		MetadataText  string `json:"metadataText,optional"`
		RagEnabled    bool   `json:"ragEnabled,optional,default=true"`
		UserID        string `header:"Beaver-User-Id"`
	}
	CreateKnowledgeDocumentRes {
		DocumentID string `json:"documentId"`
	}
	UpdateKnowledgeDocumentReq {
		DocumentID   string `json:"documentId"`
		Title        string `json:"title,optional"`
		DocType      string `json:"docType,optional"`
		SourceDocId  string `json:"sourceDocId,optional"`  // 平台在线文档ID（变更则重新读取正文）
		SyncMode     string `json:"syncMode,optional"`
		SyncInterval int    `json:"syncInterval,optional"`
		ContentText  string `json:"contentText,optional"` // 上传文件正文（doc 来源忽略）
		MetadataText string `json:"metadataText,optional"`
		RagEnabled   bool   `json:"ragEnabled,optional"`
		Status       int    `json:"status,optional"`
	}
	UpdateKnowledgeDocumentRes {}
	DeleteKnowledgeDocumentReq {
		DocumentID string `json:"documentId"` // 软删并同步清 OpenSearch 索引
	}
	DeleteKnowledgeDocumentRes {}
	ReindexKnowledgeDocumentReq {
		DocumentID string `json:"documentId"` // 重新入队索引
	}
	ReindexKnowledgeDocumentRes {}
)

@server (
	group: knowledge
)
service backend {
	@handler GetKnowledgeCollectionList
	get /admin/backend/knowledge/v1/collection_list (GetKnowledgeCollectionListReq) returns (GetKnowledgeCollectionListRes)

	@handler GetKnowledgeCollection
	get /admin/backend/knowledge/v1/collection_detail (GetKnowledgeCollectionReq) returns (GetKnowledgeCollectionRes)

	@handler CreateKnowledgeCollection
	post /admin/backend/knowledge/v1/collection_create (CreateKnowledgeCollectionReq) returns (CreateKnowledgeCollectionRes)

	@handler UpdateKnowledgeCollection
	put /admin/backend/knowledge/v1/collection_update (UpdateKnowledgeCollectionReq) returns (UpdateKnowledgeCollectionRes)

	@handler DeleteKnowledgeCollection
	delete /admin/backend/knowledge/v1/collection_delete (DeleteKnowledgeCollectionReq) returns (DeleteKnowledgeCollectionRes)

	@handler GetKnowledgeDocumentList
	get /admin/backend/knowledge/v1/document_list (GetKnowledgeDocumentListReq) returns (GetKnowledgeDocumentListRes)

	@handler GetKnowledgeDocument
	get /admin/backend/knowledge/v1/document_detail (GetKnowledgeDocumentReq) returns (GetKnowledgeDocumentRes)

	@handler CreateKnowledgeDocument
	post /admin/backend/knowledge/v1/document_create (CreateKnowledgeDocumentReq) returns (CreateKnowledgeDocumentRes)

	@handler UpdateKnowledgeDocument
	put /admin/backend/knowledge/v1/document_update (UpdateKnowledgeDocumentReq) returns (UpdateKnowledgeDocumentRes)

	@handler DeleteKnowledgeDocument
	delete /admin/backend/knowledge/v1/document_delete (DeleteKnowledgeDocumentReq) returns (DeleteKnowledgeDocumentRes)

	@handler ReindexKnowledgeDocument
	post /admin/backend/knowledge/v1/document_reindex (ReindexKnowledgeDocumentReq) returns (ReindexKnowledgeDocumentRes)
}
