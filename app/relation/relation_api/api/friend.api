syntax = "v1"

// 发送好友验证请求

// 获取好友列表

// 处理好友验证请求(同意/拒绝)

// 获取好友验证请求列表

// 获取好友详细信息

// 修改好友备注

// 通过用户ID或邮箱搜索用户

// 查询好友验证记录

// 批量获取好友数据（通过ID）

// 批量获取好友验证数据（通过ID）

// 删除好友

// 拉黑用户

// 取消拉黑

// 获取黑名单列表

type (
AddFriendReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		FriendID string `json:"friendId"` // 要添加的好友用户ID
		Verify   string `json:"verify,optional"` // 验证消息，可选
		Source   string `json:"source"` // 添加好友来源：email(邮箱搜索)/qrcode(扫码)/userId(用户ID搜索)
	}

AddFriendRes {
		Version int64 `json:"version"` // 好友验证版本号；数字伙伴直接加好友时是好友表版本号
		Direct  bool  `json:"direct,optional"` // true：对方是数字伙伴，已经直接成为好友
	}
)

type (
FriendValidStatusReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		VerifyID string `json:"verifyId"` // 验证记录ID
		Status   int8   `json:"status"` // 处理状态：1(同意)/2(拒绝)
	}

FriendValidStatusRes {
		Version int64 `json:"version"` // 处理后的好友版本号
	}
)

type (
FriendListReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Page   int    `form:"page,optional"` // 页码，可选，默认1
		Limit  int    `form:"limit,optional"` // 每页数量，可选，默认20
	}

FriendListRes {
		List []FriendInfoRes `json:"list"` // 好友列表
	}
)

type (
ValidListReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Page   int    `json:"page,optional"` // 页码，可选，默认1
		Limit  int    `json:"limit,optional"` // 每页数量，可选，默认20
	}

ValidListRes {
		List  []FriendValidInfo `json:"list"` // 验证记录列表
		Count int64             `json:"count"` // 总记录数
	}

FriendValidInfo {
		UserID    string `json:"userId"` // 用户ID
		NickName  string `json:"nickName"` // 用户昵称
		Avatar    string `json:"avatar"` // 用户头像文件名
		Message   string `json:"message"` // 验证消息
		Source    string `json:"source"` // 添加好友来源：email/qrcode
		ID        string `json:"id"` // 验证记录ID（作为唯一标识）
		Flag      string `json:"flag"` // 用户角色：send(发送者)/receive(接收者)
		Status    int8   `json:"status"` // 验证状态：0(未处理)/1(已通过)/2(已拒绝)
		CreatedAt string `json:"createdAt"` // 验证时间
	}
)

type (
FriendInfoReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		FriendID string `form:"friendId"` // 好友用户ID
	}
)

type (
NoticeUpdateReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		FriendID string `json:"friendId"` // 好友用户ID
		Notice   string `json:"notice"` // 新的备注内容
	}

NoticeUpdateRes {
		Version int64 `json:"version"` // 更新后的好友版本号
	}
)

type (
SearchReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Keyword string `form:"keyword"` // 搜索关键词（用户ID或邮箱）
		Type    string `form:"type,optional"` // 搜索类型：userId(用户ID)/email(邮箱)，默认email
	}

SearchRes {
		UserID         string `json:"userId"` // 用户ID
		NickName       string `json:"nickName"` // 用户昵称
		Avatar         string `json:"avatar"` // 用户头像文件名
		Abstract       string `json:"abstract"` // 用户签名
		Notice         string `json:"notice"` // 好友备注
		IsFriend       bool   `json:"isFriend"` // 是否为好友关系
		ConversationID string `json:"conversationId"` // 会话ID
		Email          string `json:"email"` // 用户邮箱
	}
)

type (
SearchValidInfoReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		FriendID string `json:"friendId"` // 好友用户ID
	}

SearchValidInfoRes {
		ValidID string `json:"validId"` // 验证记录ID
	}
)

type (
GetFriendsListByUuidsReq {
		friendIDs []string `json:"friendIds"` // 好友记录ID列表
	}

GetFriendsListByUuidsRes {
		Friends []FriendByUuid `json:"friends"` // 好友列表
	}

FriendByUuid {
		FriendID       string `json:"friendId"` // 好友记录ID
		SendUserID     string `json:"sendUserId"` // 发送者用户ID
		RevUserID      string `json:"revUserId"` // 接收者用户ID
		SendUserNotice string `json:"sendUserNotice"` // 发送者备注
		RevUserNotice  string `json:"revUserNotice"` // 接收者备注
		Source         string `json:"source"` // 添加好友来源
		IsDeleted      bool   `json:"isDeleted"` // 是否已删除
		Version        int64  `json:"version"` // 版本号
		CreatedAt      int64  `json:"createdAt"` // 创建时间戳
		UpdatedAt      int64  `json:"updatedAt"` // 更新时间戳
	}
)

type (
GetFriendVerifiesListByIdsReq {
		VerifyIDs []string `json:"verifyIds"` // 验证记录ID列表
	}

GetFriendVerifiesListByIdsRes {
		FriendVerifies []FriendVerifyById `json:"friendVerifies"` // 好友验证列表
	}

FriendVerifyById {
		VerifyID   string `json:"verifyId"` // 验证记录ID
		SendUserID string `json:"sendUserId"` // 发送者用户ID
		RevUserID  string `json:"revUserId"` // 接收者用户ID
		SendStatus int32  `json:"sendStatus"` // 发送方状态：0(未处理)/1(已通过)/2(已拒绝)/3(忽略)/4(删除)
		RevStatus  int32  `json:"revStatus"` // 接收方状态：0(未处理)/1(已通过)/2(已拒绝)/3(忽略)/4(删除)
		Message    string `json:"message"` // 附加消息
		Source     string `json:"source"` // 添加好友来源
		Version    int64  `json:"version"` // 版本号
		CreatedAt  int64  `json:"createdAt"` // 创建时间戳
		UpdatedAt  int64  `json:"updatedAt"` // 更新时间戳
	}
)

type (
DeleteFriendReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		FriendID string `json:"friendId"` // 要删除的好友用户ID
	}

DeleteFriendRes  {}
)

type (
BlockUserReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		BlockedUserID string `json:"blockedUserId"` // 被拉黑的用户ID
	}

BlockUserRes  {}
)

type (
UnblockUserReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		BlockedUserID string `json:"blockedUserId"` // 要取消拉黑的用户ID
	}

UnblockUserRes  {}
)

type (
BlockListReq {
		UserID string `header:"Beaver-User-Id"` // 当前用户ID（网关注入的可信身份头）
		Page   int    `form:"page,optional"` // 页码，可选，默认1
		Limit  int    `form:"limit,optional"` // 每页数量，可选，默认20
	}

BlockUserInfo {
		UserID   string `json:"userId"` // 被拉黑用户ID
		NickName string `json:"nickName"` // 用户昵称
		Avatar   string `json:"avatar"` // 用户头像文件名
		BlockID  string `json:"blockId"` // 黑名单记录ID
	}

BlockListRes {
		List  []BlockUserInfo `json:"list"` // 黑名单列表
		Count int64           `json:"count"` // 总数
	}
)















type (
FriendInfoRes {
		UserID         string `json:"userId"` // 用户ID
		NickName       string `json:"nickName"` // 用户昵称
		Avatar         string `json:"avatar"` // 用户头像文件名
		Abstract       string `json:"abstract"` // 用户签名
		Notice         string `json:"notice"` // 好友备注
		IsFriend       bool   `json:"isFriend"` // 是否为好友关系
		ConversationID string `json:"conversationId"` // 会话ID
		Email          string `json:"email"` // 用户邮箱
		Source         string `json:"source"` // 好友关系来源：email/qrcode
	}
)

type (
GetFriendIdsReq {
		UserID string `json:"UserID,optional"` // 用户ID
	}

GetFriendIdsRes {
		FriendIDs []string `json:"friendIds,optional"` // 好友用户ID列表
	}
)

type (
FriendItem {
		FriendID       string `json:"friendId,optional"` // 好友关系ID
		SendUserID     string `json:"sendUserId,optional"` // 发起方用户ID
		RevUserID      string `json:"revUserId,optional"` // 接收方用户ID
		SendUserNotice string `json:"sendUserNotice,optional"` // 发起方备注
		RevUserNotice  string `json:"revUserNotice,optional"` // 接收方备注
		Source         string `json:"source,optional"` // 来源
		IsDeleted      bool   `json:"isDeleted,optional"` // 是否已删除
		CreatedAt      string `json:"createdAt,optional"` // 创建时间
		UpdatedAt      string `json:"updatedAt,optional"` // 更新时间
	}

ListFriendsReq {
		Page       int32  `json:"page,optional"` // 页码
		PageSize   int32  `json:"pageSize,optional"` // 每页条数
		UserID     string `json:"userId,optional"` // 参与方用户ID筛选
		PeerUserID string `json:"peerUserId,optional"` // 对方用户ID筛选
		IsDeleted  *bool  `json:"isDeleted,optional"` // 删除状态筛选
		StartTime  string `json:"startTime,optional"` // 开始时间
		EndTime    string `json:"endTime,optional"` // 结束时间
		RelationID string `json:"relationId,optional"` // 好友关系记录ID精确查
	}

ListFriendsRes {
		Total int64        `json:"total,optional"` // 总数
		List  []FriendItem `json:"list,optional"` // 好友列表
	}
)

type (
UpdateFriendsReq {
		RelationIDs []string `json:"relationIds,optional"` // 好友关系记录ID
		Action      int32    `json:"action,optional"` // 1=物理删除 2=恢复软删
	}

UpdateFriendsRes {
		AffectedCount int64 `json:"affectedCount,optional"` // 影响条数
	}
)

type (
FriendVerifyItem {
		VerifyID   string `json:"verifyId,optional"` // 验证记录ID
		SendUserID string `json:"sendUserId,optional"` // 发起方用户ID
		RevUserID  string `json:"revUserId,optional"` // 接收方用户ID
		SendStatus int32  `json:"sendStatus,optional"` // 发起方状态
		RevStatus  int32  `json:"revStatus,optional"` // 接收方状态
		Message    string `json:"message,optional"` // 附加消息
		Source     string `json:"source,optional"` // 来源
		CreatedAt  string `json:"createdAt,optional"` // 创建时间
		UpdatedAt  string `json:"updatedAt,optional"` // 更新时间
	}

ListFriendVerifiesReq {
		Page       int32  `json:"page,optional"` // 页码
		PageSize   int32  `json:"pageSize,optional"` // 每页条数
		SendUserID string `json:"sendUserId,optional"` // 发起方筛选
		RevUserID  string `json:"revUserId,optional"` // 接收方筛选
		SendStatus int32  `json:"sendStatus,optional"` // 发起方状态，0 表示全部
		RevStatus  int32  `json:"revStatus,optional"` // 接收方状态，0 表示全部
		StartTime  string `json:"startTime,optional"` // 开始时间
		EndTime    string `json:"endTime,optional"` // 结束时间
		VerifyID   string `json:"verifyId,optional"` // 验证记录ID精确查
	}

ListFriendVerifiesRes {
		Total int64              `json:"total,optional"` // 总数
		List  []FriendVerifyItem `json:"list,optional"` // 验证列表
	}
)

type (
UpdateFriendVerifiesReq {
		VerifyIDs []string `json:"verifyIds,optional"` // 验证记录ID
		Action    int32    `json:"action,optional"` // 1=删除
	}

UpdateFriendVerifiesRes {
		AffectedCount int64 `json:"affectedCount,optional"` // 影响条数
	}
)

type (
FriendBlockItem {
		BlockID       string `json:"blockId,optional"` // 黑名单记录ID
		UserID        string `json:"userId,optional"` // 执行拉黑的用户ID
		BlockedUserID string `json:"blockedUserId,optional"` // 被拉黑的用户ID
		CreatedAt     string `json:"createdAt,optional"` // 创建时间
	}

ListFriendBlocksReq {
		Page          int32  `json:"page,optional"` // 页码
		PageSize      int32  `json:"pageSize,optional"` // 每页条数
		UserID        string `json:"userId,optional"` // 拉黑方用户ID筛选
		BlockedUserID string `json:"blockedUserId,optional"` // 被拉黑用户ID筛选
		BlockID       string `json:"blockId,optional"` // 记录ID精确查
	}

ListFriendBlocksRes {
		Total int64             `json:"total,optional"` // 总数
		List  []FriendBlockItem `json:"list,optional"` // 黑名单列表
	}
)

type (
UpdateFriendBlocksReq {
		BlockIDs []string `json:"blockIds,optional"` // 黑名单记录ID
		Action   int32    `json:"action,optional"` // 1=解除拉黑
	}

UpdateFriendBlocksRes {
		AffectedCount int64 `json:"affectedCount,optional"` // 影响条数
	}
)

@server (
	group: friend
	middleware: JwtS2s
)
service relation {
	@doc "发送好友验证请求"
	@handler addFriend
	post /beaver/api/relation/friend/v1/add_friend (AddFriendReq) returns (AddFriendRes)

	@doc "处理好友验证请求(同意/拒绝)"
	@handler userValidStatus
	post /beaver/api/relation/friend/v1/valid (FriendValidStatusReq) returns (FriendValidStatusRes)

	@doc "获取好友列表"
	@handler friendList
	get /beaver/api/relation/friend/v1/friend_list (FriendListReq) returns (FriendListRes)

	@doc "获取好友验证请求列表"
	@handler validList
	post /beaver/api/relation/friend/v1/valid_list (ValidListReq) returns (ValidListRes)

	@doc "获取好友详细信息"
	@handler friendInfo
	get /beaver/api/relation/friend/v1/friend_info (FriendInfoReq) returns (FriendInfoRes)

	@doc "修改好友备注"
	@handler noticeUpdate
	post /beaver/api/relation/friend/v1/update_notice (NoticeUpdateReq) returns (NoticeUpdateRes)

	@doc "通过用户ID或邮箱搜索用户"
	@handler search
	get /beaver/api/relation/friend/v1/search (SearchReq) returns (SearchRes)

	@doc "查询好友验证记录"
	@handler searchValidInfo
	post /beaver/api/relation/friend/v1/search_valid_info (SearchValidInfoReq) returns (SearchValidInfoRes)

	@doc "批量获取好友数据（通过ID）"
	@handler getFriendsListByUuids
	post /beaver/api/relation/friend/v1/get_friends_list_by_ids (GetFriendsListByUuidsReq) returns (GetFriendsListByUuidsRes)

	@doc "批量获取好友验证数据（通过ID）"
	@handler getFriendVerifiesListByIds
	post /beaver/api/relation/friend/v1/get_friend_verifies_list_by_ids (GetFriendVerifiesListByIdsReq) returns (GetFriendVerifiesListByIdsRes)

	@doc "删除好友"
	@handler deleteFriend
	delete /beaver/api/relation/friend/v1/friend (DeleteFriendReq) returns (DeleteFriendRes)

	@doc "拉黑用户"
	@handler blockUser
	post /beaver/api/relation/friend/v1/block (BlockUserReq) returns (BlockUserRes)

	@doc "取消拉黑"
	@handler unblockUser
	delete /beaver/api/relation/friend/v1/block (UnblockUserReq) returns (UnblockUserRes)

	@doc "获取黑名单列表"
	@handler blockList
	get /beaver/api/relation/friend/v1/block_list (BlockListReq) returns (BlockListRes)

@doc "队间：取好友ID列表"
	@handler friendIds
	post /beaver/api/relation/friend_s2s/v1/ids (GetFriendIdsReq) returns (GetFriendIdsRes)

	@doc "队间：分页查询好友关系"
	@handler listFriends
	post /beaver/api/relation/friend_s2s/v1/list (ListFriendsReq) returns (ListFriendsRes)

	@doc "队间：批量删除/恢复好友关系"
	@handler updateFriends
	post /beaver/api/relation/friend_s2s/v1/update (UpdateFriendsReq) returns (UpdateFriendsRes)

	@doc "队间：分页查询好友验证记录"
	@handler listFriendVerifies
	post /beaver/api/relation/friend_s2s/v1/verifies (ListFriendVerifiesReq) returns (ListFriendVerifiesRes)

	@doc "队间：批量删除好友验证记录"
	@handler updateFriendVerifies
	post /beaver/api/relation/friend_s2s/v1/update_valid (UpdateFriendVerifiesReq) returns (UpdateFriendVerifiesRes)

	@doc "队间：分页查询黑名单"
	@handler listFriendBlocks
	post /beaver/api/relation/friend_s2s/v1/blocks (ListFriendBlocksReq) returns (ListFriendBlocksRes)

	@doc "队间：批量解除拉黑"
	@handler updateFriendBlocks
	post /beaver/api/relation/friend_s2s/v1/update_block (UpdateFriendBlocksReq) returns (UpdateFriendBlocksRes)







}
