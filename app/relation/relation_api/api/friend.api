syntax = "v1"

// 发送好友验证请求
type (
	AddFriendReq {
		FriendID string `json:"friendId"` // 要添加的好友用户ID
		Verify   string `json:"verify,optional"` // 验证消息，可选
		Source   string `json:"source"` // 添加好友来源：email(邮箱搜索)/qrcode(扫码)/userId(用户ID搜索)
	}
	AddFriendRes {
		Version int64 `json:"version"` // 好友验证版本号；数字伙伴直接加好友时是好友表版本号
		Direct  bool  `json:"direct,optional"` // true：对方是数字伙伴，已经直接成为好友
	}
)

// 获取好友列表
type (
	FriendListReq {
		Page   int    `form:"page,optional"` // 页码，可选，默认1
		Limit  int    `form:"limit,optional"` // 每页数量，可选，默认20
	}
	FriendListRes {
		List []FriendInfoRes `json:"list"` // 好友列表
	}
)

// 处理好友验证请求(同意/拒绝)
type (
	FriendValidStatusReq {
		VerifyID string `json:"verifyId"` // 验证记录ID
		Status   int8   `json:"status"` // 处理状态：1(同意)/2(拒绝)
	}
	FriendValidStatusRes {
		Version int64 `json:"version"` // 处理后的好友版本号
	}
)

// 获取好友验证请求列表
type (
	ValidListReq {
		Page   int    `json:"page,optional"` // 页码，可选，默认1
		Limit  int    `json:"limit,optional"` // 每页数量，可选，默认20
	}
	ValidListRes {
		List  []FriendValidInfo `json:"list"` // 验证记录列表
		Count int64             `json:"count"` // 总记录数
	}
	FriendValidInfo {
		UserID    string `json:"userId"` // 用户ID
		NickName  string `json:"nickName"` // 用户昵称
		Avatar    string `json:"avatar"` // 用户头像文件名
		Message   string `json:"message"` // 验证消息
		Source    string `json:"source"` // 添加好友来源：email/qrcode
		Id        string `json:"id"` // 验证记录ID（作为唯一标识）
		Flag      string `json:"flag"` // 用户角色：send(发送者)/receive(接收者)
		Status    int8   `json:"status"` // 验证状态：0(未处理)/1(已通过)/2(已拒绝)
		CreatedAt string `json:"createdAt"` // 验证时间
	}
)

// 获取好友详细信息
type (
	FriendInfoReq {
		FriendID string `form:"friendId"` // 好友用户ID
	}
	FriendInfoRes {
		UserID         string `json:"userId"` // 用户ID
		NickName       string `json:"nickName"` // 用户昵称
		Avatar         string `json:"avatar"` // 用户头像文件名
		Abstract       string `json:"abstract"` // 用户签名
		Notice         string `json:"notice"` // 好友备注
		IsFriend       bool   `json:"isFriend"` // 是否为好友关系
		ConversationID string `json:"conversationId"` // 会话ID
		Email          string `json:"email"` // 用户邮箱
		Source         string `json:"source"` // 好友关系来源：email/qrcode
	}
)

// 修改好友备注
type (
	NoticeUpdateReq {
		FriendID string `json:"friendId"` // 好友用户ID
		Notice   string `json:"notice"` // 新的备注内容
	}
	NoticeUpdateRes {
		Version int64 `json:"version"` // 更新后的好友版本号
	}
)

// 通过用户ID或邮箱搜索用户
type (
	SearchReq {
		Keyword string `form:"keyword"` // 搜索关键词（用户ID或邮箱）
		Type    string `form:"type,optional"` // 搜索类型：userId(用户ID)/email(邮箱)，默认email
	}
	SearchRes {
		UserID         string `json:"userId"` // 用户ID
		NickName       string `json:"nickName"` // 用户昵称
		Avatar         string `json:"avatar"` // 用户头像文件名
		Abstract       string `json:"abstract"` // 用户签名
		Notice         string `json:"notice"` // 好友备注
		IsFriend       bool   `json:"isFriend"` // 是否为好友关系
		ConversationID string `json:"conversationId"` // 会话ID
		Email          string `json:"email"` // 用户邮箱
	}
)

// 查询好友验证记录
type (
	SearchValidInfoReq {
		FriendID string `json:"friendId"` // 好友用户ID
	}
	SearchValidInfoRes {
		ValidID string `json:"validId"` // 验证记录ID
	}
)

// 批量获取好友数据（通过ID）
type (
	GetFriendsListByUuidsReq {
		friendIds []string `json:"friendIds"` // 好友记录ID列表
	}
	GetFriendsListByUuidsRes {
		Friends []FriendByUuid `json:"friends"` // 好友列表
	}
	FriendByUuid {
		FriendID       string `json:"friendId"` // 好友记录ID
		SendUserID     string `json:"sendUserId"` // 发送者用户ID
		RevUserID      string `json:"revUserId"` // 接收者用户ID
		SendUserNotice string `json:"sendUserNotice"` // 发送者备注
		RevUserNotice  string `json:"revUserNotice"` // 接收者备注
		Source         string `json:"source"` // 添加好友来源
		IsDeleted      bool   `json:"isDeleted"` // 是否已删除
		Version        int64  `json:"version"` // 版本号
		CreatedAt      int64  `json:"createdAt"` // 创建时间戳
		UpdatedAt      int64  `json:"updatedAt"` // 更新时间戳
	}
)

// 批量获取好友验证数据（通过ID）
type (
	GetFriendVerifiesListByIdsReq {
		VerifyIds []string `json:"verifyIds"` // 验证记录ID列表
	}
	GetFriendVerifiesListByIdsRes {
		FriendVerifies []FriendVerifyById `json:"friendVerifies"` // 好友验证列表
	}
	FriendVerifyById {
		VerifyID   string `json:"verifyId"` // 验证记录ID
		SendUserID string `json:"sendUserId"` // 发送者用户ID
		RevUserID  string `json:"revUserId"` // 接收者用户ID
		SendStatus int32  `json:"sendStatus"` // 发送方状态：0(未处理)/1(已通过)/2(已拒绝)/3(忽略)/4(删除)
		RevStatus  int32  `json:"revStatus"` // 接收方状态：0(未处理)/1(已通过)/2(已拒绝)/3(忽略)/4(删除)
		Message    string `json:"message"` // 附加消息
		Source     string `json:"source"` // 添加好友来源
		Version    int64  `json:"version"` // 版本号
		CreatedAt  int64  `json:"createdAt"` // 创建时间戳
		UpdatedAt  int64  `json:"updatedAt"` // 更新时间戳
	}
)

// 删除好友
type (
	DeleteFriendReq {
		FriendID string `json:"friendId"` // 要删除的好友用户ID
	}
	DeleteFriendRes  {}
)

// 拉黑用户
type (
	BlockUserReq {
		BlockedUserID string `json:"blockedUserId"` // 被拉黑的用户ID
	}
	BlockUserRes  {}
)

// 取消拉黑
type (
	UnblockUserReq {
		BlockedUserID string `json:"blockedUserId"` // 要取消拉黑的用户ID
	}
	UnblockUserRes  {}
)

// 获取黑名单列表
type (
	BlockListReq {
		Page   int    `form:"page,optional"` // 页码，可选，默认1
		Limit  int    `form:"limit,optional"` // 每页数量，可选，默认20
	}
	BlockUserInfo {
		UserID   string `json:"userId"` // 被拉黑用户ID
		NickName string `json:"nickName"` // 用户昵称
		Avatar   string `json:"avatar"` // 用户头像文件名
		BlockID  string `json:"blockId"` // 黑名单记录ID
	}
	BlockListRes {
		List  []BlockUserInfo `json:"list"` // 黑名单列表
		Count int64           `json:"count"` // 总数
	}
)

@server (
	group: friend
	jwt: Auth
)
service relation {
	@doc "发送好友验证请求"
	@handler addFriend
	post /api/friend/v1/add_friend (AddFriendReq) returns (AddFriendRes)

	@doc "处理好友验证请求(同意/拒绝)"
	@handler userValidStatus
	post /api/friend/v1/valid (FriendValidStatusReq) returns (FriendValidStatusRes)

	@doc "获取好友列表"
	@handler friendList
	get /api/friend/v1/friend_list (FriendListReq) returns (FriendListRes)

	@doc "获取好友验证请求列表"
	@handler validList
	post /api/friend/v1/valid_list (ValidListReq) returns (ValidListRes)

	@doc "获取好友详细信息"
	@handler friendInfo
	get /api/friend/v1/friend_info (FriendInfoReq) returns (FriendInfoRes)

	@doc "修改好友备注"
	@handler noticeUpdate
	post /api/friend/v1/update_notice (NoticeUpdateReq) returns (NoticeUpdateRes)

	@doc "通过用户ID或邮箱搜索用户"
	@handler search
	get /api/friend/v1/search (SearchReq) returns (SearchRes)

	@doc "查询好友验证记录"
	@handler searchValidInfo
	post /api/friend/v1/searchValidInfo (SearchValidInfoReq) returns (SearchValidInfoRes)

	@doc "批量获取好友数据（通过ID）"
	@handler getFriendsListByUuids
	post /api/friend/v1/getFriendsListByIds (GetFriendsListByUuidsReq) returns (GetFriendsListByUuidsRes)

	@doc "批量获取好友验证数据（通过ID）"
	@handler getFriendVerifiesListByIds
	post /api/friend/v1/getFriendVerifiesListByIds (GetFriendVerifiesListByIdsReq) returns (GetFriendVerifiesListByIdsRes)

	@doc "删除好友"
	@handler deleteFriend
	delete /api/friend/v1/friend (DeleteFriendReq) returns (DeleteFriendRes)

	@doc "拉黑用户"
	@handler blockUser
	post /api/friend/v1/block (BlockUserReq) returns (BlockUserRes)

	@doc "取消拉黑"
	@handler unblockUser
	delete /api/friend/v1/block (UnblockUserReq) returns (UnblockUserRes)

	@doc "获取黑名单列表"
	@handler blockList
	get /api/friend/v1/block_list (BlockListReq) returns (BlockListRes)
}

// ==================== 队间（S2S）能力面 ====================
// 与上面 C 端视图共用同一套 /api 契约，身份由 authgate 中间件区分：
// 用户 JWT 只能看到自己的数据，机器票代表用户行事。路径刻意与 C 端错开，避免视图混用。

type (
	FriendItem {
		FriendId       string `json:"friend_id,optional"` // 好友关系ID
		SendUserId     string `json:"send_user_id,optional"` // 发起方用户ID
		RevUserId      string `json:"rev_user_id,optional"` // 接收方用户ID
		SendUserNotice string `json:"send_user_notice,optional"` // 发起方备注
		RevUserNotice  string `json:"rev_user_notice,optional"` // 接收方备注
		Source         string `json:"source,optional"` // 来源
		IsDeleted      bool   `json:"is_deleted,optional"` // 是否已删除
		CreatedAt      string `json:"created_at,optional"` // 创建时间
		UpdatedAt      string `json:"updated_at,optional"` // 更新时间
	}
	FriendVerifyItem {
		VerifyId   string `json:"verify_id,optional"` // 验证记录ID
		SendUserId string `json:"send_user_id,optional"` // 发起方用户ID
		RevUserId  string `json:"rev_user_id,optional"` // 接收方用户ID
		SendStatus int32  `json:"send_status,optional"` // 发起方状态
		RevStatus  int32  `json:"rev_status,optional"` // 接收方状态
		Message    string `json:"message,optional"` // 附加消息
		Source     string `json:"source,optional"` // 来源
		CreatedAt  string `json:"created_at,optional"` // 创建时间
		UpdatedAt  string `json:"updated_at,optional"` // 更新时间
	}
	FriendBlockItem {
		BlockId       string `json:"block_id,optional"` // 黑名单记录ID
		UserId        string `json:"user_id,optional"` // 执行拉黑的用户ID
		BlockedUserId string `json:"blocked_user_id,optional"` // 被拉黑的用户ID
		CreatedAt     string `json:"created_at,optional"` // 创建时间
	}

	GetFriendIdsReq {
		UserID string `json:"UserID,optional"` // 用户ID
	}
	GetFriendIdsRes {
		FriendIds []string `json:"friend_ids,optional"` // 好友用户ID列表
	}

	ListFriendsReq {
		Page       int32  `json:"page,optional"` // 页码
		PageSize   int32  `json:"page_size,optional"` // 每页条数
		UserId     string `json:"user_id,optional"` // 参与方用户ID筛选
		PeerUserId string `json:"peer_user_id,optional"` // 对方用户ID筛选
		IsDeleted  *bool  `json:"is_deleted,optional"` // 删除状态筛选
		StartTime  string `json:"start_time,optional"` // 开始时间
		EndTime    string `json:"end_time,optional"` // 结束时间
		RelationId string `json:"relation_id,optional"` // 好友关系记录ID精确查
	}
	ListFriendsRes {
		Total int64        `json:"total,optional"` // 总数
		List  []FriendItem `json:"list,optional"` // 好友列表
	}

	UpdateFriendsReq {
		RelationIds []string `json:"relation_ids,optional"` // 好友关系记录ID
		Action      int32    `json:"action,optional"` // 1=物理删除 2=恢复软删
	}
	UpdateFriendsRes {
		AffectedCount int64 `json:"affected_count,optional"` // 影响条数
	}

	ListFriendVerifiesReq {
		Page       int32  `json:"page,optional"` // 页码
		PageSize   int32  `json:"page_size,optional"` // 每页条数
		SendUserId string `json:"send_user_id,optional"` // 发起方筛选
		RevUserId  string `json:"rev_user_id,optional"` // 接收方筛选
		SendStatus int32  `json:"send_status,optional"` // 发起方状态，0 表示全部
		RevStatus  int32  `json:"rev_status,optional"` // 接收方状态，0 表示全部
		StartTime  string `json:"start_time,optional"` // 开始时间
		EndTime    string `json:"end_time,optional"` // 结束时间
		VerifyId   string `json:"verify_id,optional"` // 验证记录ID精确查
	}
	ListFriendVerifiesRes {
		Total int64              `json:"total,optional"` // 总数
		List  []FriendVerifyItem `json:"list,optional"` // 验证列表
	}

	UpdateFriendVerifiesReq {
		VerifyIds []string `json:"verify_ids,optional"` // 验证记录ID
		Action    int32    `json:"action,optional"` // 1=删除
	}
	UpdateFriendVerifiesRes {
		AffectedCount int64 `json:"affected_count,optional"` // 影响条数
	}

	ListFriendBlocksReq {
		Page          int32  `json:"page,optional"` // 页码
		PageSize      int32  `json:"page_size,optional"` // 每页条数
		UserId        string `json:"user_id,optional"` // 拉黑方用户ID筛选
		BlockedUserId string `json:"blocked_user_id,optional"` // 被拉黑用户ID筛选
		BlockId       string `json:"block_id,optional"` // 记录ID精确查
	}
	ListFriendBlocksRes {
		Total int64             `json:"total,optional"` // 总数
		List  []FriendBlockItem `json:"list,optional"` // 黑名单列表
	}

	UpdateFriendBlocksReq {
		BlockIds []string `json:"block_ids,optional"` // 黑名单记录ID
		Action   int32    `json:"action,optional"` // 1=解除拉黑
	}
	UpdateFriendBlocksRes {
		AffectedCount int64 `json:"affected_count,optional"` // 影响条数
	}
)

@server (
	group: friend_machine
	middleware: AuthGate
)
service relation {
	@doc "队间：取好友ID列表"
	@handler friendIds
	post /api/friend/v1/ids (GetFriendIdsReq) returns (GetFriendIdsRes)

	@doc "队间：分页查询好友关系"
	@handler listFriends
	post /api/friend/v1/list (ListFriendsReq) returns (ListFriendsRes)

	@doc "队间：批量删除/恢复好友关系"
	@handler updateFriends
	post /api/friend/v1/update (UpdateFriendsReq) returns (UpdateFriendsRes)

	@doc "队间：分页查询好友验证记录"
	@handler listFriendVerifies
	post /api/friend/v1/verifies (ListFriendVerifiesReq) returns (ListFriendVerifiesRes)

	@doc "队间：批量删除好友验证记录"
	@handler updateFriendVerifies
	post /api/friend/v1/update_valid (UpdateFriendVerifiesReq) returns (UpdateFriendVerifiesRes)

	@doc "队间：分页查询黑名单"
	@handler listFriendBlocks
	post /api/friend/v1/blocks (ListFriendBlocksReq) returns (ListFriendBlocksRes)

	@doc "队间：批量解除拉黑"
	@handler updateFriendBlocks
	post /api/friend/v1/update_block (UpdateFriendBlocksReq) returns (UpdateFriendBlocksRes)
}

// goctl api go -api relation_api.api -dir . --home ../../../template
